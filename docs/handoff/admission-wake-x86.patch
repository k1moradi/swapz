+/* Admission pins the target before unlock publishes the descriptor.
+ * No BIO/entry access is permitted here: the owner may already have freed it.
+ * Drain joins this reference before draining/destroying either workqueue.
+ */
+static void swapz_admission_wake(struct swapz_dm *ctx, bool immediate)
+{
+	if (immediate) {
+		swapz_note_accepted_lower_idle_wake(ctx);
+		mod_delayed_work(ctx->workqueue, &ctx->worker, 0);
+	} else {
+		queue_delayed_work(ctx->workqueue, &ctx->worker, 0);
+	}
+	/* Final target access; drain may release the target immediately. */
+	atomic_dec_return_release(&ctx->admission_wakes_active);
+}
+
+static void swapz_join_admission_wakes(struct swapz_dm *ctx)
+{
+	while (atomic_read_acquire(&ctx->admission_wakes_active))
+		schedule_timeout_uninterruptible(1);
+}
