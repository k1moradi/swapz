diff --git a/src/kernel/dm-target.c b/src/kernel/dm-target.c
index 810ccb37..b82c8d42 100644
--- a/src/kernel/dm-target.c
+++ b/src/kernel/dm-target.c
@@ -468,6 +468,11 @@ struct swapz_dm {
 	/* Callback only queues the serialized worker; it never owns BIOs. */
 	struct hrtimer retention_timer;
 	spinlock_t queue_lock;
+	/* Temporary admission contention diagnostic; protected by queue_lock. */
+	u64 admission_lock_attempts;
+	u64 admission_lock_contended;
+	u64 admission_lock_wait_wall_ns;
+	u64 admission_lock_wait_max_ns;
 	struct list_head incoming;
 	bool accepting;
 	bool failed;
@@ -6774,7 +6779,18 @@ static int swapz_map(struct dm_target *ti, struct bio *bio)
 			}
 		segs_done: ;
 		}
-		spin_lock_irqsave(&ctx->queue_lock, flags);
+		if (!spin_trylock_irqsave(&ctx->queue_lock, flags)) {
+			u64 start_ns = ktime_get_ns();
+			u64 elapsed;
+
+			spin_lock_irqsave(&ctx->queue_lock, flags);
+			elapsed = swapz_elapsed_ns(start_ns, ktime_get_ns());
+			ctx->admission_lock_contended++;
+			ctx->admission_lock_wait_wall_ns += elapsed;
+			if (elapsed > ctx->admission_lock_wait_max_ns)
+				ctx->admission_lock_wait_max_ns = elapsed;
+		}
+		ctx->admission_lock_attempts++;
 		/*
 		 * Admission and shutdown share queue_lock: presuspend cannot finish
 		 * draining while a previously admitted BIO is added after the drain.
@@ -8266,6 +8282,12 @@ static void swapz_status(struct dm_target *ti, status_type_t type,
 			prep.delta64.transform_wall_ns + submitter.delta64.transform_wall_ns,
 		       READ_ONCE(ctx->ordered_delta64.wall_ns) +
 			prep.delta64.wall_ns + submitter.delta64.wall_ns);
+		DMEMIT(" admission_lock_attempts=%llu admission_lock_contended=%llu "
+		       "admission_lock_wait_wall_ns=%llu admission_lock_wait_max_ns=%llu",
+		       READ_ONCE(ctx->admission_lock_attempts),
+		       READ_ONCE(ctx->admission_lock_contended),
+		       READ_ONCE(ctx->admission_lock_wait_wall_ns),
+		       READ_ONCE(ctx->admission_lock_wait_max_ns));
 		DMEMIT(" completion_offloaded_batches=%llu completion_active=%d",
 		       READ_ONCE(ctx->completion_offloaded_batches),
 		       atomic_read(&ctx->completion_active));
