+++ b/tests/runtime/native/lz4-state-probe.c
@@ -0,0 +1,103 @@
+#define _GNU_SOURCE
+#include <assert.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#define unlikely(x) (x)
+#ifdef SWAPZ_PROBE_STUB
+typedef struct { unsigned char memory[16416]; } LZ4_stream_t;
+static int stage, encoded, forget_result;
+static const char *expected_input;
+static int LZ4_compress_fast_continue(LZ4_stream_t *stream, const char *input,
+                                    char *output, int size, int capacity, int acceleration)
+{
+    assert(stage == 0 && input == expected_input && output);
+    assert(size == 4096 && capacity == 3568 && acceleration == 1);
+    stage = 1;
+    stream->memory[0] = 0xcc;
+    return encoded;
+}
+static int LZ4_loadDict(LZ4_stream_t *stream, const char *input, int size)
+{
+    assert(stage == 1 && input == expected_input && size == 0);
+    stage = 2;
+    if (!forget_result)
+        stream->memory[0] = 0;
+    return forget_result;
+}
+#else
+#include <lz4.h>
+#include <sys/mman.h>
+#endif
+#include "production-helper.h"
+#ifdef SWAPZ_PROBE_STUB
+int main(void)
+{
+    static char input[4096], output[4096];
+    LZ4_stream_t stream;
+    expected_input = input;
+    for (int mode = 0; mode != 3; ++mode) {
+        memset(&stream, 0x5a, sizeof(stream));
+        stage = 0;
+        encoded = mode == 1 ? 0 : 17;
+        forget_result = mode == 2 ? 4 : 0;
+        int result = swapz_lz4_compress_independent(input, output, 4096, 3568, 1, &stream);
+        assert(stage == 2 && result == (mode == 2 ? 0 : encoded));
+        assert(stream.memory[0] == 0);
+        if (mode == 2)
+            for (size_t j = 0; j != sizeof(stream); ++j)
+                assert(((unsigned char *)&stream)[j] == 0);
+    }
+    return 0;
+}
+#else
+static uint32_t step(uint32_t x)
+{
+    x ^= x << 13;
+    x ^= x >> 17;
+    return x ^ (x << 5);
+}
+int main(void)
+{
+    enum { PAGE = 4096, LOOPS = 1024 };
+    unsigned char *bank[2];
+    char expected[PAGE], decoded[PAGE], output[LZ4_COMPRESSBOUND(PAGE) + 64];
+    LZ4_stream_t *stream = calloc(1, sizeof(*stream));
+    assert(stream);
+    for (int i = 0; i != 2; ++i) {
+        bank[i] = mmap(NULL, 3 * PAGE, PROT_NONE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+        assert(bank[i] != MAP_FAILED);
+    }
+    int failures = 0, successes = 0;
+    for (unsigned i = 0; i != LOOPS; ++i) {
+        unsigned char *input = bank[i & 1] + PAGE;
+        assert(mprotect(input, PAGE, PROT_READ | PROT_WRITE) == 0);
+        uint32_t seed = 0x51a0a9u + i / 2;
+        for (unsigned j = 0; j != PAGE; ++j) {
+            seed = step(seed);
+            input[j] = i % 7 < 3 ? (unsigned char)(j % (1 + i % 3)) : (unsigned char)seed;
+        }
+        memcpy(expected, input, PAGE);
+        memset(output, 0x5a, sizeof(output));
+        int capacity = i % 4 == 0 ? 1 : i % 4 == 1 ? 2048 : i % 4 == 2 ? 3568 : LZ4_COMPRESSBOUND(PAGE);
+        int length = swapz_lz4_compress_independent((const char *)input, output,
+                                                   PAGE, capacity, 1, stream);
+        assert(length >= 0 && length <= capacity);
+        assert(mprotect(input, PAGE, PROT_NONE) == 0);
+        for (size_t j = capacity; j != sizeof(output); ++j)
+            assert((unsigned char)output[j] == 0x5a);
+        if (length) {
+            ++successes;
+            assert(LZ4_decompress_safe(output, decoded, length, PAGE) == PAGE);
+            assert(memcmp(decoded, expected, PAGE) == 0);
+        } else {
+            ++failures;
+        }
+    }
+    assert(failures && successes);
+    for (int i = 0; i != 2; ++i)
+        assert(munmap(bank[i], 3 * PAGE) == 0);
+    free(stream);
+    return 0;
+}
+#endif
