 	 */
+	if (admission_sample)
+		admission_wake = ktime_get_ns();
 	if (submitter_lane >= 0) {
 		/* swapz_submitter_prepare_entry() owns the wake. */
 	} else if (bio_op(bio) != REQ_OP_WRITE ||
@@ -6855,6 +6873,16 @@ static int swapz_map(struct dm_target *ti, struct bio *bio)
 		mod_delayed_work(ctx->workqueue, &ctx->worker, 0);
