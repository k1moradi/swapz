 		       atomic_read(&ctx->completion_active));
diff --git a/tests/runtime/native/source-contract-test.py b/tests/runtime/native/source-contract-test.py
index dca2fecf..229af961 100644
--- a/tests/runtime/native/source-contract-test.py
+++ b/tests/runtime/native/source-contract-test.py
@@ -53,6 +53,17 @@ def source_body(symbol: str, source: str) -> str:
 
 
 class SwapzProductionSourceQualification(unittest.TestCase):
+    def test_temporary_admission_sample_is_inside_acceptance_lock(self):
+        if "admission_probe_attempts" not in DM:
+            self.skipTest("temporary hold probe not applied")
+        mapper = body("swapz_map")
+        sample = mapper.index("++ctx->admission_probe_attempts")
+        self.assertGreater(sample, mapper.index("spin_lock_irqsave(&ctx->queue_lock"))
+        self.assertGreater(sample, mapper.index("if (!ctx->accepting)"))
+        self.assertLess(sample, mapper.index("list_add_tail(&entry->list"))
+        self.assertLess(mapper.index("admission_probe_notify_ns[group]"),
+                        mapper.rindex("spin_unlock_irqrestore(&ctx->queue_lock"))
+
     def test_pressure_hand_requires_completed_representation(self):
         ready = body("swapz_next_local_write_ready")
         policy = (ROOT / "src/kernel/window-policy.h").read_text()
