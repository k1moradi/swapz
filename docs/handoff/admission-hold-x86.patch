+		       READ_ONCE(ctx->admission_probe_notify_ns[0]),
+		       READ_ONCE(ctx->admission_probe_samples[1]),
+		       READ_ONCE(ctx->admission_probe_pre_ns[1]),
+		       READ_ONCE(ctx->admission_probe_notify_ns[1]));
 		DMEMIT(" completion_offloaded_batches=%llu completion_active=%d",
