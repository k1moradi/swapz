@@ -6783,6 +6791,14 @@ static int swapz_map(struct dm_target *ti, struct bio *bio)
 			spin_unlock_irqrestore(&ctx->queue_lock, flags);
 			return ctx->failed ? DM_MAPIO_KILL : DM_MAPIO_REQUEUE;
 		}
+		if (!(++ctx->admission_probe_attempts & 63ULL)) {
+			u64 first = ktime_get_ns();
