+	if (admission_sample) {
+		u64 end = ktime_get_ns();
+		unsigned int group = submitter_lane >= 0;
+
+		ctx->admission_probe_samples[group]++;
+		ctx->admission_probe_pre_ns[group] +=
+			swapz_elapsed_ns(admission_start, admission_wake);
+		ctx->admission_probe_notify_ns[group] +=
+			swapz_elapsed_ns(admission_wake, end);
+	}
