/* SPDX-License-Identifier: GPL-2.0-only */
/* Test-only producer values. Never a live swap/DM authorization. The caller
 * exclusively owns one context, its monotonically increasing sequence and
 * the payload buffer; no concurrent access or allocation in these helpers.
 */
enum r084_codec {
	R084_LZ4 = 1,
	R084_LZO1X = 2,
};

enum r084_state {
	R084_EMPTY,
	R084_PREPUBLICATION,
	R084_XARRAY_PUBLISHED,
};

struct r084_record {
	u64 session;
	u64 area_epoch;
	u64 slot;
	u64 sequence;
	u32 type;
	u32 length;
	u32 crc;
	u8 codec;
	u8 version;
	u8 digest[32];
	enum r084_state state;
};

struct r084_context {
	struct r084_record record;
	u64 last_sequence;
	u64 session;
	u64 area_epoch;
	u64 slot;
	u64 slot_limit;
	u32 type;
	u32 type_limit;
	u32 ceiling;
	u32 capacity;
	u8 *payload;
};

static void r084_clear(struct r084_context *context)
{
	if (context)
		memset(&context->record, 0, sizeof(context->record));
}

static u8 r084_profile(const char *name, const char *driver)
{
	if (!name || !driver)
		return 0;
	if (!strcmp(name, "lz4") && !strcmp(driver, "lz4-scomp"))
		return R084_LZ4;
	if (!strcmp(name, "lzo") && !strcmp(driver, "lzo-scomp"))
		return R084_LZO1X;
	return 0;
}

/* Only the gated real compressor hook supplies original/compressed bytes
 * after successful zs_obj_write. Host callers exercise value semantics only.
 * The caller holds the original locked folio and acomp mutex; no SG pin,
 * XArray lock, wait, new allocation, or transfer of source ownership here.
 */
static void r084_capture(struct r084_context *context, bool stored,
			 int compression_error, const char *name,
			 const char *driver, const u8 *original,
			 const u8 *compressed, u32 length)
{
	u8 codec;

	if (!context)
		return;
	r084_clear(context);
	codec = r084_profile(name, driver);
	if (!stored || compression_error || !codec || !original || !compressed ||
	    !context->payload || !context->session || !context->area_epoch ||
	    context->type >= context->type_limit ||
	    context->slot >= context->slot_limit ||
	    (context->ceiling != 3568 && context->ceiling != 4095) ||
	    !length || length >= 4096 || length > context->ceiling ||
	    length > context->capacity || context->last_sequence == ~(u64)0)
		return;

	/* The private destination cannot alias the locked source or acomp buffer. */
	memcpy(context->payload, compressed, length);
	context->record.session = context->session;
	context->record.area_epoch = context->area_epoch;
	context->record.slot = context->slot;
	context->record.type = context->type;
	context->record.sequence = ++context->last_sequence;
	context->record.length = length;
	context->record.codec = codec;
	context->record.version = 1;
	r084_sha(original, 4096, context->record.digest);
	context->record.crc = r084_crc(compressed, length);
	context->record.state = R084_PREPUBLICATION;
}

/* Only actual successful xa_store in zswap_store_page may promote the state.
 * The fixture-created XArray never promotes a test record to this state.
 */
static void r084_finish(struct r084_context *context, bool published)
{
	if (!context)
		return;
	if (!published) {
		r084_clear(context);
		return;
	}
	if (context->record.state == R084_PREPUBLICATION)
		context->record.state = R084_XARRAY_PUBLISHED;
}

/* Value equality against the current caller-owned generation, not a pointer
 * or numeric equality across MM and DM identity domains. No auth claim.
 */
static bool r084_matches(const struct r084_context *context,
			 const struct r084_record *candidate)
{
	const struct r084_record *live;

	if (!context || !candidate || !context->payload)
		return false;
	live = &context->record;
	return (live->state == R084_PREPUBLICATION ||
		live->state == R084_XARRAY_PUBLISHED) &&
	       live->sequence && live->sequence == context->last_sequence &&
	       live->session == context->session &&
	       live->area_epoch == context->area_epoch &&
	       live->type == context->type && live->slot == context->slot &&
	       live->length && live->length <= context->capacity &&
	       live->length <= context->ceiling && live->length < 4096 &&
	       candidate->state == live->state &&
	       candidate->sequence == live->sequence &&
	       candidate->session == live->session &&
	       candidate->area_epoch == live->area_epoch &&
	       candidate->slot == live->slot && candidate->type == live->type &&
	       candidate->length == live->length &&
	       candidate->codec == live->codec &&
	       candidate->version == live->version &&
	       candidate->crc == live->crc &&
	       !memcmp(candidate->digest, live->digest, sizeof(live->digest)) &&
	       r084_crc(context->payload, live->length) == live->crc;
}
