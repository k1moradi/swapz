/* ROUND073_ORIGINAL_READER_PIN_GC_BEGIN
 * TEST-ONLY original pinned mm/zswap.c source: test-created XArray STORED
 * entry and original zs pool, NOT authenticated swapcache or selected DM.
 * Original LZO1X/raw LZ4 bytes are held by independent RAM snapshot; the
 * product authority keeps old extent alive until actual native lower READ
 * endio completes. Decoder lease is independent of retired source storage.
 */
#if defined(SWAPZ_ROUND073_ORIGINAL_READER_PIN_GC_KUNIT) && IS_ENABLED(CONFIG_KUNIT)
/* Pinned original Linux include/linux/delay.h owns usleep_range().
 * Keep the bounded, sleepable close-drain wait under strict -Werror. */
#include <linux/delay.h>
#include <linux/timer.h>
#include "swapz_round073/zswap-import-decoder-owner.c"

#define SWAPZ_R073_LOGICAL 37U

struct swapz_round073_close {
	struct swapz_zswap_import_decoder_owner *owner;
	struct completion entered;
	struct completion returned;
	int result;
};

static int swapz_round073_close_worker(void *argument)
{
	struct swapz_round073_close *closer = argument;

	complete(&closer->entered);
	closer->result =
		swapz_zswap_import_decoder_owner_close_and_drain(closer->owner);
	complete(&closer->returned);
	return 0;
}

/* Fail-only watchdog for an actual stalled KUnit phase; 20s is below the
 * unchanged 120s overall KUnit timeout, and this timer never extends it. */
struct swapz_round073_stall {
	struct timer_list timer;
	struct swapz_zswap_import_decoder_owner *owner;
	const char *step;
};
static void swapz_round073_stall_report(struct timer_list *timer)
{
	struct swapz_round073_stall *stall = from_timer(stall, timer, timer);

	pr_err("ROUND080_READER_STALL_FIRST_ERROR step=%s active=%u closing=%u\n",
	       READ_ONCE(stall->step),
	       READ_ONCE(stall->owner->active_readers),
	       READ_ONCE(stall->owner->closing));
}
#define SWAPZ_R073_STEP(phase) do { \
	step = (phase); \
	WRITE_ONCE(stall.step, step); \
} while (0)

/* The inherited original native STORED source is LZ4. Convert only this
 * separately isolated test-created original zsmalloc object to original
 * Linux LZO1X, without changing any upstream production source. */
static int swapz_round073_make_lzo_source(
	struct swapz_round069_native_state *source, void *workspace)
{
	size_t length = PAGE_SIZE;
	unsigned long handle;
	int result;

	result = lzo1x_1_compress(source->original_page, PAGE_SIZE,
				 source->compressed, &length, workspace);
	if (result != LZO_E_OK || !length || length > 3568U)
		return -EMSGSIZE;
	zs_free(source->allocator, source->handle);
	source->handle = 0;
	source->first->handle = 0;
	handle = zs_malloc(source->allocator, length, GFP_KERNEL, NUMA_NO_NODE);
	if (!handle || IS_ERR_VALUE(handle))
		return -ENOMEM;
	source->handle = handle;
	zs_obj_write(source->allocator, handle, source->compressed, length);
	source->compressed_length = length;
	source->first->handle = handle;
	source->first->length = length;
	strscpy(source->pool->tfm_name, "lzo",
		sizeof(source->pool->tfm_name));
	return 0;
}

static int swapz_round073_copy_source(
	struct swapz_round069_native_state *source,
	struct swapz_round069_owned_stored *owned, swapz_u8 codec)
{
	struct zswap_entry *entry = source->first;
	struct zswap_pool *pool;
	struct scatterlist scatter[2];
	unsigned int length;

	if (codec == SWAPZ_AUTHORITY_IMPORT_LZ4)
		return swapz_round069_capture_stored(entry, entry->swpentry,
			&source->tree, source->folio,
			SWAPZ_ROUND069_TEST_EPOCH, owned);
	if (codec != SWAPZ_AUTHORITY_IMPORT_LZO1X)
		return -EOPNOTSUPP;
	if (!folio_test_locked(source->folio) || !entry ||
	    !owned || !owned->bytes || owned->live)
		return -EPERM;
	length = READ_ONCE(entry->length);
	pool = zswap_entry_pool(entry);
	if (!length || length > 3568U || length > owned->capacity)
		return -EMSGSIZE;
	if (xa_load(&source->tree, swp_offset(entry->swpentry)) != entry ||
	    !entry->swapz_round028_store_bound ||
	    entry->swapz_round028_allocation_epoch != SWAPZ_ROUND069_TEST_EPOCH ||
	    !entry->swapz_round028_stored_entry_identity ||
	    !pool || !pool->zs_pool || !entry->handle ||
	    pool->idx != entry->pool_idx || strcmp(pool->tfm_name, "lzo"))
		return -ESTALE;
	zs_obj_read_sg_begin(pool->zs_pool, entry->handle, scatter, length);
	memcpy_from_sglist(owned->bytes, scatter, 0, length);
	zs_obj_read_sg_end(pool->zs_pool, entry->handle);
	if (xa_load(&source->tree, swp_offset(entry->swpentry)) != entry ||
	    zswap_entry_pool(entry) != pool || READ_ONCE(entry->length) != length) {
		memzero_explicit(owned->bytes, length);
		return -ESTALE;
	}
	owned->length = length;
	owned->source_swap_entry = entry->swpentry.val;
	owned->source_epoch = SWAPZ_ROUND069_TEST_EPOCH;
	owned->pool_idx = entry->pool_idx;
	strscpy(owned->original_codec, "lzo", sizeof(owned->original_codec));
	owned->live = true;
	return 0;
}

static void swapz_round073_record(
	const struct swapz_import_disk_view *view,
	struct swapz_zswap_import_record *record,
	struct swapz_zswap_import_read_authority *authority)
{
	const struct swapz_authority_import_spec *spec = &view->spec;

	memset(record, 0, sizeof(*record));
	memset(authority, 0, sizeof(*authority));
	record->logical_page = spec->logical_page;
	record->generation = view->ordinary_generation;
	record->stored_entry_identity = spec->source_entry_identity;
	record->store_generation = spec->source_store_generation;
	record->gc_epoch = spec->gc_epoch;
	record->compressed_length = spec->compressed_length;
	record->decoded_length = SWAPZ_BLOCK_BYTES;
	record->compressed_crc32c = spec->compressed_crc32c;
	memcpy(record->original_sha256, spec->original_sha256,
	       sizeof(record->original_sha256));
	record->representation = SWAPZ_ZSWAP_IMPORT_REPRESENTATION;
	record->codec = spec->codec;
	record->version = spec->codec_version;
	record->stored_eviction = 1U;
	record->immutable_owned_copy = 1U;
	authority->logical_page = record->logical_page;
	authority->generation = record->generation;
	authority->stored_entry_identity = record->stored_entry_identity;
	authority->store_generation = record->store_generation;
	authority->gc_epoch = record->gc_epoch;
	authority->actual_lower_read_bytes = record->compressed_length;
	/* These fields are TEST model inputs, not proven physical durability
	 * nor an actual selected upper BIO acknowledgement. */
	authority->mapping_published_after_durable_write = 1U;
	authority->foreground_write_committed_once = 1U;
	authority->upper_write_ack_count = 1U;
	authority->current_owned_ram_session = 1U;
}

static int swapz_round073_decode(struct swapz_round069_joined *joined,
	struct swapz_zswap_import_decoder_lease *lease,
	const struct swapz_import_disk_view *view, bool negatives)
{
	struct swapz_zswap_import_record record;
	struct swapz_zswap_import_read_authority authority;
	swapz_u8 *input = joined->read_compressed;
	int result;

	swapz_round073_record(view, &record, &authority);
	if (negatives) {
		/* Every rejection must leave entire upper 4096 unchanged. */
		memset(joined->output, 0x5a, SWAPZ_BLOCK_BYTES);
		++authority.store_generation;
		result = swapz_zswap_import_decoder_owner_decode(lease, &record,
			&authority, input, record.compressed_length,
			joined->decoded, SWAPZ_BLOCK_BYTES, joined->output,
			SWAPZ_BLOCK_BYTES, joined->original);
		--authority.store_generation;
		if (result != -ESTALE ||
		    memchr_inv(joined->output, 0x5a, SWAPZ_BLOCK_BYTES))
			return -EUCLEAN;
		++authority.gc_epoch;
		result = swapz_zswap_import_decoder_owner_decode(lease, &record,
			&authority, input, record.compressed_length,
			joined->decoded, SWAPZ_BLOCK_BYTES, joined->output,
			SWAPZ_BLOCK_BYTES, joined->original);
		--authority.gc_epoch;
		if (result != -ESTALE ||
		    memchr_inv(joined->output, 0x5a, SWAPZ_BLOCK_BYTES))
			return -EUCLEAN;
		record.codec = record.codec == SWAPZ_AUTHORITY_IMPORT_LZ4 ?
			SWAPZ_AUTHORITY_IMPORT_LZO1X : SWAPZ_AUTHORITY_IMPORT_LZ4;
		result = swapz_zswap_import_decoder_owner_decode(lease, &record,
			&authority, input, record.compressed_length,
			joined->decoded, SWAPZ_BLOCK_BYTES, joined->output,
			SWAPZ_BLOCK_BYTES, joined->original);
		record.codec = lease->codec;
		if (result != -EOPNOTSUPP ||
		    memchr_inv(joined->output, 0x5a, SWAPZ_BLOCK_BYTES))
			return -EUCLEAN;
		record.compressed_crc32c ^= 1U;
		result = swapz_zswap_import_decoder_owner_decode(lease, &record,
			&authority, input, record.compressed_length,
			joined->decoded, SWAPZ_BLOCK_BYTES, joined->output,
			SWAPZ_BLOCK_BYTES, joined->original);
		record.compressed_crc32c ^= 1U;
		if (result != -EBADMSG ||
		    memchr_inv(joined->output, 0x5a, SWAPZ_BLOCK_BYTES))
			return -EUCLEAN;
		record.original_sha256[0] ^= 1U;
		result = swapz_zswap_import_decoder_owner_decode(lease, &record,
			&authority, input, record.compressed_length,
			joined->decoded, SWAPZ_BLOCK_BYTES, joined->output,
			SWAPZ_BLOCK_BYTES, joined->original);
		record.original_sha256[0] ^= 1U;
		if (result != -EBADMSG ||
		    memchr_inv(joined->output, 0x5a, SWAPZ_BLOCK_BYTES))
			return -EUCLEAN;
	}
	result = swapz_zswap_import_decoder_owner_decode(lease, &record,
		&authority, input, record.compressed_length,
		joined->decoded, SWAPZ_BLOCK_BYTES, joined->output,
		SWAPZ_BLOCK_BYTES, joined->original);
	if (!result && memcmp(joined->output, joined->original,
			      SWAPZ_BLOCK_BYTES))
		return -EBADMSG;
	return result;
}

/* Inherited real authority GC helper is deliberately LZ4-specific.
 * This test-only generic original LZO1X relocation copies the exact
 * immutable bytes, retaining the separately tagged original codec. */
static int swapz_round073_gc_exact_copy(struct swapz_round069_joined *joined,
	const struct swapz_import_disk_view *old_view,
	struct swapz_tx *transaction, swapz_u64 *new_ticket)
{
	struct swapz_authority_import_spec spec = old_view->spec;
	struct swapz_import_lower_bio_request request;
	struct swapz_round069_io *write_io = NULL;
	swapz_u8 *bytes;
	size_t offset;
	int error;

	if (!spec.compressed_length ||
	    spec.compressed_length > SWAPZ_MAX_COMPRESSED ||
	    old_view->start_block >= SWAPZ_JOIN_PHYSICAL ||
	    spec.gc_epoch == ~(swapz_u64)0)
		return -EINVAL;
	offset = ((size_t)old_view->start_block +
		  SWAPZ_LINUX_SWAP_HEADER_BLOCKS) * SWAPZ_BLOCK_BYTES;
	if (offset > SWAPZ_JOIN_LOWER_BYTES ||
	    spec.compressed_length > SWAPZ_JOIN_LOWER_BYTES - offset)
		return -ERANGE;
	bytes = kmemdup(joined->lower + offset,
			 spec.compressed_length, GFP_KERNEL);
	if (!bytes)
		return -ENOMEM;
	if (swapz_crc32c_bytes(bytes, spec.compressed_length) !=
	    spec.compressed_crc32c) {
		error = -EBADMSG;
		goto out;
	}
	++spec.gc_epoch;
	mutex_lock(&joined->authority_lock);
	error = swapz_import_disk_stage(&joined->pool, &spec, 4U,
		old_view->ticket, transaction, new_ticket);
	if (!error)
		error = swapz_import_disk_submit(&joined->pool, *new_ticket);
	if (!error)
		error = swapz_import_lower_begin_write(&joined->writer,
			transaction, *new_ticket, 1, &request);
	mutex_unlock(&joined->authority_lock);
	if (error)
		goto out;
	write_io = swapz_round069_make_io(joined, &joined->writer,
		&request, SWAPZ_JOIN_IO_WRITE, bytes, spec.compressed_length);
	if (!write_io) {
		error = -ENOMEM;
		goto out;
	}
	memzero_explicit(bytes, spec.compressed_length);
	error = swapz_round069_run_io(write_io);
out:
	swapz_round069_release_io(write_io);
	kfree(bytes);
	return error;
}

static int swapz_round073_one_read(struct kunit *test, swapz_u8 codec,
	bool native_gc, bool negatives, bool retire_decoder)
{
	struct swapz_round069_native_state *source = test->priv;
	struct swapz_round069_owned_stored owned = swapz_round069_make_owner(source);
	struct swapz_round069_joined *joined = NULL;
	struct swapz_zswap_import_decoder_owner *owner = NULL;
	struct swapz_zswap_import_decoder_lease lease = {};
	struct swapz_zswap_import_decoder_lease late = {};
	struct swapz_import_lower_bio_request write_request, old_read_request;
	struct swapz_import_lower_bio_request new_read_request;
	struct swapz_import_disk_view old_view, new_view;
	struct swapz_authority_import_spec spec = {};
	struct swapz_round069_io *write_io = NULL, *old_io = NULL, *new_io = NULL;
	struct swapz_round073_close *closer = NULL;
	struct task_struct *closer_task = NULL;
	struct swapz_tx *transaction = NULL;
	swapz_u64 ticket = 0, moved_ticket = 0;
	swapz_u32 old_start = 0;
	const char *step = "allocate";
	struct swapz_round073_stall stall = {};
	bool owner_initialized = false, source_released = false;
	bool timer_initialized = false, quarantine_closer = false;
	int error = -ENOMEM, cleanup_error;
	unsigned int iteration;

	joined = swapz_round069_join_alloc();
	transaction = kvzalloc(sizeof(*transaction), GFP_KERNEL);
	owner = kzalloc(sizeof(*owner), GFP_KERNEL);
	closer = kzalloc(sizeof(*closer), GFP_KERNEL);
	if (!joined || !transaction || !owner || !closer)
		goto out;
	stall.owner = owner;
	stall.step = step;
	timer_setup(&stall.timer, swapz_round073_stall_report, 0);
	timer_initialized = true;
	if (negatives || retire_decoder)
		mod_timer(&stall.timer, jiffies + msecs_to_jiffies(20000U));
	memcpy(joined->original, source->original_page, SWAPZ_BLOCK_BYTES);
	if (codec == SWAPZ_AUTHORITY_IMPORT_LZO1X) {
		SWAPZ_R073_STEP("original-LZO1X-source");
		error = swapz_round073_make_lzo_source(source, joined->codec_work);
		if (error)
			goto out;
	}
	SWAPZ_R073_STEP("original-XArray-zsmalloc-immutable-copy");
	error = swapz_round073_copy_source(source, &owned, codec);
	if (error)
		goto out;
	if (!owned.live || owned.length != source->compressed_length ||
	    memcmp(owned.bytes, source->compressed, owned.length)) {
		error = -EBADMSG;
		goto out;
	}
	spec.logical_page = SWAPZ_R073_LOGICAL;
	spec.source_swap_slot = owned.source_swap_entry;
	spec.source_entry_identity =
		source->first->swapz_round028_stored_entry_identity;
	spec.source_store_generation = owned.source_epoch;
	spec.gc_epoch = owned.source_epoch;
	spec.compressed_length = owned.length;
	spec.compressed_crc32c = swapz_crc32c_bytes(owned.bytes, owned.length);
	spec.codec = codec;
	spec.codec_version = 1U;
	spec.requested_fua = 1U;
	sha256(joined->original, SWAPZ_BLOCK_BYTES, spec.original_sha256);
	SWAPZ_R073_STEP("independent-original-codec-reader-lease");
	error = swapz_zswap_import_decoder_owner_init(owner, codec, 1U);
	if (error)
		goto out;
	owner_initialized = true;
	error = swapz_zswap_import_decoder_owner_get(owner, &lease);
	if (error)
		goto out;
	SWAPZ_R073_STEP("native-product-authority-prerequisite-stage");
	mutex_lock(&joined->authority_lock);
	error = swapz_import_disk_stage(&joined->pool, &spec,
		2U, 0U, transaction, &ticket);
	if (!error)
		error = swapz_import_disk_submit(&joined->pool, ticket);
	if (!error)
		error = swapz_import_lower_begin_write(&joined->writer,
			transaction, ticket, 1, &write_request);
	mutex_unlock(&joined->authority_lock);
	if (error)
		goto out;
	write_io = swapz_round069_make_io(joined, &joined->writer,
		&write_request, SWAPZ_JOIN_IO_WRITE, owned.bytes, owned.length);
	if (!write_io) {
		error = -ENOMEM;
		goto out;
	}
	/* The writer is merely a prerequisite. This test starts at READ pin:
	 * erase original XArray and free its original zsmalloc source now. */
	SWAPZ_R073_STEP("source-release-after-owned-copy");
	if (xa_erase(&source->tree, SWAPZ_ROUND069_TEST_OFFSET) != source->first) {
		error = -ESTALE;
		goto out;
	}
	zs_free(source->allocator, source->handle);
	source->handle = 0;
	source->first->handle = 0;
	source_released = true;
	swapz_round069_release_owned(&owned);
	error = swapz_round069_run_io(write_io);
	if (error)
		goto out;
	SWAPZ_R073_STEP("old-generation-real-authority-read-pin");
	mutex_lock(&joined->authority_lock);
	error = swapz_import_lower_begin_read(&joined->reader,
		ticket, &old_read_request);
	if (!error)
		old_view = joined->reader.pinned_view;
	mutex_unlock(&joined->authority_lock);
	if (error)
		goto out;
	old_io = swapz_round069_make_io(joined, &joined->reader,
		&old_read_request, SWAPZ_JOIN_IO_READ, NULL, 0U);
	if (!old_io) {
		error = -ENOMEM;
		goto out;
	}
	old_start = transaction->start_block;
	if (native_gc) {
		SWAPZ_R073_STEP("byte-exact-physical-GC-while-old-read-pinned");
		if (codec == SWAPZ_AUTHORITY_IMPORT_LZ4)
			error = swapz_round069_native_gc_copy_fua(joined,
				&old_view, 4U, &moved_ticket, transaction);
		else
			error = swapz_round073_gc_exact_copy(joined,
				&old_view, transaction, &moved_ticket);
		if (error)
			goto out;
		if (!joined->live_records[old_start]) {
			error = -EUCLEAN;
			goto out;
		}
	}
	SWAPZ_R073_STEP("old-original-BIO-endio-and-read-lease");
	error = swapz_round069_run_io(old_io);
	if (error)
		goto out;
	if (native_gc && joined->live_records[old_start]) {
		error = -EUCLEAN;
		goto out;
	}
	SWAPZ_R073_STEP("old-reader-full-original-4096-decode");
	error = swapz_round073_decode(joined, &lease, &old_view, negatives);
	if (error)
		goto out;
	if (retire_decoder) {
		init_completion(&closer->entered);
		init_completion(&closer->returned);
		closer->owner = owner;
		closer->result = -EINPROGRESS;
		closer_task = kthread_run(swapz_round073_close_worker,
					  closer, "swapz-r073-reader");
		if (IS_ERR(closer_task)) {
			closer_task = NULL;
			error = -ENOMEM;
			goto out;
		}
		if (!wait_for_completion_timeout(&closer->entered,
				msecs_to_jiffies(1500U))) {
			error = -ETIMEDOUT;
			goto out;
		}
		for (iteration = 0; iteration < 1500U &&
		     !READ_ONCE(owner->closing); ++iteration)
			usleep_range(1000, 2000);
		if (!READ_ONCE(owner->closing) ||
		    completion_done(&closer->returned) ||
		    swapz_zswap_import_decoder_owner_get(owner, &late) !=
			    -ESHUTDOWN) {
			error = -EUCLEAN;
			goto out;
		}
		/* Existing pinned reader remains valid during close/drain. */
		SWAPZ_R073_STEP("read-during-pending-independent-decoder-drain");
		error = swapz_round073_decode(joined, &lease, &old_view, false);
		if (error)
			goto out;
	}
	if (native_gc) {
		SWAPZ_R073_STEP("new-generation-real-native-lower-read");
		mutex_lock(&joined->authority_lock);
		error = swapz_import_lower_begin_read(&joined->reader,
			moved_ticket, &new_read_request);
		if (!error)
			new_view = joined->reader.pinned_view;
		mutex_unlock(&joined->authority_lock);
		if (error)
			goto out;
		if (new_view.spec.codec != old_view.spec.codec ||
		    new_view.spec.compressed_crc32c != old_view.spec.compressed_crc32c ||
		    memcmp(new_view.spec.original_sha256,
			   old_view.spec.original_sha256,
			   sizeof(old_view.spec.original_sha256)) ||
		    new_view.spec.gc_epoch != old_view.spec.gc_epoch + 1U) {
			error = -EUCLEAN;
			goto out;
		}
		new_io = swapz_round069_make_io(joined, &joined->reader,
			&new_read_request, SWAPZ_JOIN_IO_READ, NULL, 0U);
		if (!new_io) {
			error = -ENOMEM;
			goto out;
		}
		error = swapz_round069_run_io(new_io);
		if (error)
			goto out;
		SWAPZ_R073_STEP("new-generation-4096-original-decoder-read");
		error = swapz_round073_decode(joined, &lease, &new_view, false);
		if (error)
			goto out;
	}
	SWAPZ_R073_STEP("last-original-decoder-reader-put");
	error = swapz_zswap_import_decoder_owner_put(&lease);
	if (error)
		goto out;
	if (retire_decoder) {
		if (!wait_for_completion_timeout(&closer->returned,
				msecs_to_jiffies(1500U)) || closer->result ||
		    swapz_zswap_import_decoder_owner_get(owner, &late) !=
			    -ESHUTDOWN) {
			error = -EUCLEAN;
			goto out;
		}
	} else {
		error = swapz_zswap_import_decoder_owner_close_and_drain(owner);
		if (error)
			goto out;
	}
	SWAPZ_R073_STEP("retired-original-owner-refuses-future-read");
	if (swapz_zswap_import_decoder_owner_get(owner, &late) != -ESHUTDOWN ||
	    swapz_zswap_import_decoder_owner_put(&lease) != -EALREADY)
		error = -EUCLEAN;
	else
		error = 0;
out:
	/* Release both locally held reader pins before any closer join. */
	if (late.owner) {
		cleanup_error = swapz_zswap_import_decoder_owner_put(&late);
		if (!error)
			error = cleanup_error;
	}
	if (lease.owner) {
		cleanup_error = swapz_zswap_import_decoder_owner_put(&lease);
		if (!error)
			error = cleanup_error;
	}
	if (closer_task) {
		/* After releasing BOTH leases, a closer must finish promptly.
		 * In failure, quarantine its heap-owned state rather than hang
		 * the test indefinitely or free an actively borrowed stack. */
		if (!wait_for_completion_timeout(&closer->returned,
						 msecs_to_jiffies(1500U))) {
			pr_err("ROUND080_READER_CLOSE_FIRST_ERROR step=%s active=%u closing=%u\n",
			       step, READ_ONCE(owner->active_readers),
			       READ_ONCE(owner->closing));
			quarantine_closer = true;
			if (!error)
				error = -ETIMEDOUT;
		} else {
			kthread_stop(closer_task);
		}
	} else if (owner_initialized && !owner->closing) {
		/* A synchronous close cannot wait for its own live lease. */
		if (READ_ONCE(owner->active_readers)) {
			if (!error)
				error = -EUCLEAN;
		} else {
			cleanup_error =
				swapz_zswap_import_decoder_owner_close_and_drain(
					owner);
			if (!error)
				error = cleanup_error;
		}
	}
	if (error)
		pr_err("ROUND073_READER_NATIVE_FIRST_ERROR step=%s err=%d codec=%u active=%u\n",
		       step, error, codec,
		       owner ? READ_ONCE(owner->active_readers) : 0U);
	if (timer_initialized)
		del_timer_sync(&stall.timer);
	if (!source_released && owned.live)
		swapz_round069_release_owned(&owned);
	swapz_round069_release_io(new_io);
	swapz_round069_release_io(old_io);
	swapz_round069_release_io(write_io);
	kvfree(transaction);
	swapz_round069_join_free(joined);
	if (!quarantine_closer) {
		kfree(closer);
		kfree(owner);
	}
	return error;
}

static void swapz_round073_original_lz4_old_reader_gc(struct kunit *test)
{
	KUNIT_EXPECT_EQ(test, swapz_round073_one_read(test,
		SWAPZ_AUTHORITY_IMPORT_LZ4, true, false, false), 0);
}
static void swapz_round073_original_lzo1x_old_reader_gc(struct kunit *test)
{
	KUNIT_EXPECT_EQ(test, swapz_round073_one_read(test,
		SWAPZ_AUTHORITY_IMPORT_LZO1X, true, false, false), 0);
}
static void swapz_round073_original_stale_crc_sha_codec(struct kunit *test)
{
	KUNIT_EXPECT_EQ(test, swapz_round073_one_read(test,
		SWAPZ_AUTHORITY_IMPORT_LZ4, false, true, false), 0);
}
static void swapz_round073_original_decoder_retire_with_pin(struct kunit *test)
{
	KUNIT_EXPECT_EQ(test, swapz_round073_one_read(test,
		SWAPZ_AUTHORITY_IMPORT_LZ4, true, false, true), 0);
}

static struct kunit_case swapz_round073_original_reader_cases[] = {
	KUNIT_CASE(swapz_round073_original_lz4_old_reader_gc),
	KUNIT_CASE(swapz_round073_original_lzo1x_old_reader_gc),
	KUNIT_CASE(swapz_round073_original_stale_crc_sha_codec),
	KUNIT_CASE(swapz_round073_original_decoder_retire_with_pin),
	{}
};
static struct kunit_suite swapz_round073_original_reader_suite = {
	.name = "swapz_round073_original_reader_pin_gc",
	.init = swapz_round069_native_init,
	.exit = swapz_round069_native_exit,
	.test_cases = swapz_round073_original_reader_cases,
};
kunit_test_suite(swapz_round073_original_reader_suite);
#endif /* SWAPZ_ROUND073_ORIGINAL_READER_PIN_GC_KUNIT */
/* ROUND073_ORIGINAL_READER_PIN_GC_END */
