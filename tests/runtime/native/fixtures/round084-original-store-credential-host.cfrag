/* Host execution of the exact staged helper, not kernel compressor proof. */
#include <stdbool.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <openssl/sha.h>

typedef uint8_t u8;
typedef uint32_t u32;
typedef uint64_t u64;

static void r084_sha(const u8 *bytes, size_t length, u8 *digest)
{
	if (!SHA256(bytes, length, digest))
		abort();
}

static u32 r084_crc(const u8 *bytes, size_t length)
{
	u32 crc = UINT32_MAX;

	for (size_t index = 0; index < length; ++index) {
		crc ^= bytes[index];
		for (unsigned int bit = 0; bit < 8; ++bit)
			crc = (crc >> 1) ^ ((crc & 1) ? UINT32_C(0x82f63b78) : 0);
	}
	return crc ^ UINT32_MAX;
}

/* R084_INSERT_ACTUAL_HELPER */

#define CHECK(condition) do { \
	if (!(condition)) { \
		fprintf(stderr, "R084_CHECK:%d: %s\n", __LINE__, #condition); \
		return 77; \
	} \
} while (0)

int main(void)
{
	static const u8 digest[32] = {
		0xf3, 0x02, 0x95, 0x7d, 0xa5, 0x22, 0x09, 0x38,
		0xa7, 0xe3, 0xe5, 0x1a, 0x87, 0x18, 0xc7, 0x9b,
		0x9e, 0x00, 0xdc, 0x13, 0xab, 0x21, 0x19, 0xe8,
		0xcf, 0xc9, 0x78, 0xf0, 0x41, 0x72, 0x03, 0x82,
	};
	u8 original[4096], compressed[4096], payload[4096];
	struct r084_context context = {
		.session = 11, .area_epoch = 22, .slot = 0, .slot_limit = 8,
		.type = 1, .type_limit = 2, .ceiling = 4095,
		.capacity = 4095, .payload = payload,
	};
	struct r084_record previous, changed;

	memset(original, 0x5a, sizeof(original));
	memset(compressed, 0x38, sizeof(compressed));
	memcpy(compressed, "123456789", 9);
	memset(payload, 0xa5, sizeof(payload));

#define CAPTURE(ok, err, name, driver, size) \
	r084_capture(&context, ok, err, name, driver, original, compressed, size)
#define VALID() CAPTURE(true, 0, "lz4", "lz4-scomp", 9)
#define EMPTY() CHECK(context.record.state == R084_EMPTY && \
		      context.record.sequence == 0 && context.record.length == 0)

	VALID();
	CHECK(context.record.state == R084_PREPUBLICATION);
	CHECK(context.record.sequence == 1 && context.last_sequence == 1);
	CHECK(context.record.session == 11 && context.record.area_epoch == 22);
	CHECK(context.record.slot == 0 && context.record.type == 1);
	CHECK(context.record.length == 9 && context.record.codec == R084_LZ4);
	CHECK(context.record.version == 1);
	CHECK(memcmp(context.record.digest, digest, 32) == 0);
	CHECK(context.record.crc == UINT32_C(0xe3069283));
	CHECK(memcmp(payload, compressed, 9) == 0 && payload[9] == 0xa5);
	CHECK(r084_matches(&context, &context.record));
	previous = context.record;
	VALID();
	CHECK(context.record.sequence == 2);
	CHECK(!r084_matches(&context, &previous));

	changed = context.record;
	changed.session++;
	CHECK(!r084_matches(&context, &changed));
	changed = context.record;
	changed.area_epoch++;
	CHECK(!r084_matches(&context, &changed));
	changed = context.record;
	changed.slot++;
	CHECK(!r084_matches(&context, &changed));
	changed = context.record;
	changed.type++;
	CHECK(!r084_matches(&context, &changed));
	changed = context.record;
	changed.codec = R084_LZO1X;
	CHECK(!r084_matches(&context, &changed));
	changed = context.record;
	changed.version++;
	CHECK(!r084_matches(&context, &changed));
	changed = context.record;
	changed.digest[0] ^= 1;
	CHECK(!r084_matches(&context, &changed));
	changed = context.record;
	changed.crc ^= 1;
	CHECK(!r084_matches(&context, &changed));
	changed = context.record;
	changed.length--;
	CHECK(!r084_matches(&context, &changed));
	payload[0] ^= 1;
	CHECK(!r084_matches(&context, &context.record));
	payload[0] ^= 1;
	CHECK(r084_matches(&context, &context.record));
	r084_finish(&context, true);
	CHECK(context.record.state == R084_XARRAY_PUBLISHED);
	CHECK(!r084_matches(&context, &previous));
	r084_finish(&context, false);
	EMPTY();

	CAPTURE(true, 0, "lzo", "lzo-scomp", 9);
	CHECK(context.record.codec == R084_LZO1X &&
	      context.record.state == R084_PREPUBLICATION);
	CAPTURE(true, 0, "lzo-rle", "lzo-rle-scomp", 9);
	EMPTY();
	CAPTURE(true, 0, "lzo", "lzo-rle-scomp", 9);
	EMPTY();
	CAPTURE(true, 0, "lz4", "lz4hc-scomp", 9);
	EMPTY();
	CAPTURE(true, 0, "lz4hc", "lz4-scomp", 9);
	EMPTY();
	CAPTURE(true, 0, NULL, "lz4-scomp", 9);
	EMPTY();
	CAPTURE(true, 0, "lz4", NULL, 9);
	EMPTY();

	VALID();
	CAPTURE(false, 0, "lz4", "lz4-scomp", 9);
	EMPTY();
	CAPTURE(true, -1, "lz4", "lz4-scomp", 9);
	EMPTY();
	CAPTURE(true, 0, "lz4", "lz4-scomp", 0);
	EMPTY();
	CAPTURE(true, 0, "lz4", "lz4-scomp", 4096);
	EMPTY();
	context.ceiling = 3568;
	CAPTURE(true, 0, "lz4", "lz4-scomp", 3568);
	CHECK(context.record.length == 3568);
	CAPTURE(true, 0, "lz4", "lz4-scomp", 3569);
	EMPTY();
	context.ceiling = 4094;
	VALID();
	EMPTY();
	context.ceiling = 4095;
	CAPTURE(true, 0, "lz4", "lz4-scomp", 4095);
	CHECK(context.record.length == 4095);
	context.capacity = 1;
	VALID();
	EMPTY();
	context.capacity = 4095;
	context.session = 0;
	VALID();
	EMPTY();
	context.session = 11;
	context.area_epoch = 0;
	VALID();
	EMPTY();
	context.area_epoch = 22;
	context.slot = 8;
	VALID();
	EMPTY();
	context.slot = 0;
	context.type = 2;
	VALID();
	EMPTY();
	context.type = 1;
	context.last_sequence = UINT64_MAX - 1;
	VALID();
	CHECK(context.record.sequence == UINT64_MAX);
	VALID();
	EMPTY();
	CHECK(context.last_sequence == UINT64_MAX);
	r084_finish(&context, true);
	EMPTY();

	puts("R084_HOST_BASELINE_PASS");
	return 0;
}
