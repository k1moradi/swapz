#include <kunit/test.h>
#include <kunit/resource.h>
#include <linux/lz4.h>
#include <linux/lzo.h>

/* A single private context and four 4KiB arrays per test; no live zswap entry
 * size change, no global credential registry, no real swap area or DM.
 */
struct r084_fixture {
	struct zswap_pool pool;
	struct folio *folio;
	struct zswap_entry entry;
	struct r084_context capture;
	bool stored;
	u8 original[4096];
	u8 payload[4096];
	u8 readback[4096];
	u8 decoded[4096];
};

static void r084_release_object(struct r084_fixture *fixture)
{
	if (fixture->stored) {
		zs_free(fixture->pool.zs_pool, fixture->entry.handle);
		fixture->stored = false;
	}
	r084_clear(&fixture->capture);
}

static void r084_cleanup(void *data)
{
	struct r084_fixture *fixture = data;
	int cpu;

	r084_release_object(fixture);
	if (fixture->folio) {
		folio_unlock(fixture->folio);
		folio_put(fixture->folio);
	}
	if (fixture->pool.acomp_ctx) {
		for_each_possible_cpu(cpu)
			acomp_ctx_free(per_cpu_ptr(fixture->pool.acomp_ctx, cpu));
		free_percpu(fixture->pool.acomp_ctx);
	}
	if (fixture->pool.zs_pool)
		zs_destroy_pool(fixture->pool.zs_pool);
}

static struct r084_fixture *r084_setup(struct kunit *test,
				      const char *algorithm, u64 session)
{
	struct r084_fixture *fixture;
	int cpu;

	fixture = kunit_kzalloc(test, sizeof(*fixture), GFP_KERNEL);
	if (!fixture)
		return NULL;
	if (kunit_add_action_or_reset(test, r084_cleanup, fixture))
		return NULL;
	fixture->pool.zs_pool = zs_create_pool("r084-private-credential");
	if (!fixture->pool.zs_pool)
		return NULL;
	strscpy(fixture->pool.tfm_name, algorithm, sizeof(fixture->pool.tfm_name));
	fixture->pool.acomp_ctx = alloc_percpu_gfp(struct crypto_acomp_ctx,
						 GFP_KERNEL | __GFP_ZERO);
	if (!fixture->pool.acomp_ctx)
		return NULL;
	for_each_possible_cpu(cpu) {
		if (zswap_cpu_comp_prepare(cpu, &fixture->pool.node))
			return NULL;
	}
	fixture->folio = folio_alloc(GFP_KERNEL, 0);
	if (!fixture->folio)
		return NULL;
	folio_lock(fixture->folio);
	fixture->capture.session = session;
	fixture->capture.area_epoch = 1; /* explicitly a fixture value */
	fixture->capture.slot = 0;
	fixture->capture.slot_limit = 8;
	fixture->capture.type = 1;
	fixture->capture.type_limit = 2;
	fixture->capture.ceiling = 4095;
	fixture->capture.capacity = 4095;
	fixture->capture.payload = fixture->payload;
	memset(fixture->original, 0x5a, sizeof(fixture->original));
	return fixture;
}

static bool r084_run_compression(struct r084_fixture *fixture)
{
	void *mapped;
	struct scatterlist scatter[2];

	r084_release_object(fixture);
	mapped = kmap_local_folio(fixture->folio, 0);
	memcpy(mapped, fixture->original, sizeof(fixture->original));
	kunmap_local(mapped);
	/* This is the original pinned zswap_compress body, real crypto acomp
	 * and real zsmalloc allocation/write. No synthetic compressor.
	 */
	fixture->stored = zswap_compress(fixture->folio, 0, &fixture->entry,
					&fixture->pool, &fixture->capture);
	if (!fixture->stored)
		return false;
	if (!fixture->entry.length || fixture->entry.length > 4096)
		return false;
	zs_obj_read_sg_begin(fixture->pool.zs_pool, fixture->entry.handle,
			     scatter, fixture->entry.length);
	memcpy_from_sglist(fixture->readback, scatter, 0, fixture->entry.length);
	zs_obj_read_sg_end(fixture->pool.zs_pool, fixture->entry.handle);
	return true;
}

static void r084_check_decoded(struct kunit *test,
			       struct r084_fixture *fixture, bool lz4)
{
	if (lz4) {
		int length = LZ4_decompress_safe((const char *)fixture->readback,
						(char *)fixture->decoded,
						fixture->entry.length, 4096);
		KUNIT_ASSERT_EQ(test, length, 4096);
	} else {
		size_t length = 4096;
		int result = lzo1x_decompress_safe(fixture->readback,
						 fixture->entry.length,
						 fixture->decoded, &length);
		KUNIT_ASSERT_EQ(test, result, LZO_E_OK);
		KUNIT_ASSERT_EQ(test, length, (size_t)4096);
	}
	KUNIT_EXPECT_MEMEQ(test, fixture->decoded, fixture->original, 4096);
}

static void r084_check_positive(struct kunit *test, const char *algorithm,
			       u8 codec, u64 session)
{
	static const u8 expected_digest[32] = {
		0xf3, 0x02, 0x95, 0x7d, 0xa5, 0x22, 0x09, 0x38,
		0xa7, 0xe3, 0xe5, 0x1a, 0x87, 0x18, 0xc7, 0x9b,
		0x9e, 0x00, 0xdc, 0x13, 0xab, 0x21, 0x19, 0xe8,
		0xcf, 0xc9, 0x78, 0xf0, 0x41, 0x72, 0x03, 0x82,
	};
	struct r084_fixture *fixture = r084_setup(test, algorithm, session);
	struct r084_record *record;

	KUNIT_ASSERT_NOT_NULL(test, fixture);
	KUNIT_ASSERT_TRUE(test, r084_run_compression(fixture));
	record = &fixture->capture.record;
	KUNIT_ASSERT_EQ(test, record->state, R084_PREPUBLICATION);
	KUNIT_EXPECT_EQ(test, record->codec, codec);
	KUNIT_EXPECT_EQ(test, record->version, (u8)1);
	KUNIT_EXPECT_EQ(test, record->length, fixture->entry.length);
	KUNIT_EXPECT_EQ(test, record->sequence, (u64)1);
	KUNIT_EXPECT_EQ(test, record->session, session);
	KUNIT_EXPECT_EQ(test, record->area_epoch, (u64)1);
	KUNIT_EXPECT_EQ(test, record->slot, (u64)0);
	KUNIT_EXPECT_EQ(test, record->type, (u32)1);
	KUNIT_EXPECT_MEMEQ(test, record->digest, expected_digest, 32);
	KUNIT_EXPECT_EQ(test, record->crc,
			r084_crc(fixture->readback, fixture->entry.length));
	KUNIT_EXPECT_MEMEQ(test, fixture->payload, fixture->readback,
			  fixture->entry.length);
	KUNIT_EXPECT_TRUE(test, r084_matches(&fixture->capture, record));
	r084_check_decoded(test, fixture, codec == R084_LZ4);
}

static void r084_original_lz4(struct kunit *test)
{
	r084_check_positive(test, "lz4", R084_LZ4, 1);
}

static void r084_original_lzo1x(struct kunit *test)
{
	r084_check_positive(test, "lzo", R084_LZO1X, 2);
}

static void r084_original_raw_optional(struct kunit *test)
{
	struct r084_fixture *fixture = r084_setup(test, "lz4", 3);
	u32 random = 0x91e10da5;
	unsigned int index;

	KUNIT_ASSERT_NOT_NULL(test, fixture);
	/* No optional buffer capacity, but the ordinary stored object survives. */
	fixture->capture.capacity = 0;
	KUNIT_ASSERT_TRUE(test, r084_run_compression(fixture));
	KUNIT_EXPECT_LT(test, fixture->entry.length, 4096U);
	KUNIT_EXPECT_EQ(test, fixture->capture.record.state, R084_EMPTY);
	r084_check_decoded(test, fixture, true);
	fixture->capture.capacity = 4095;
	for (index = 0; index < 4096; ++index) {
		random ^= random << 13;
		random ^= random >> 17;
		random ^= random << 5;
		fixture->original[index] = (u8)random;
	}
	/* Incompressible input executes the original full-page fallback. */
	KUNIT_ASSERT_TRUE(test, r084_run_compression(fixture));
	KUNIT_EXPECT_EQ(test, fixture->entry.length, 4096U);
	KUNIT_EXPECT_EQ(test, fixture->capture.record.state, R084_EMPTY);
	KUNIT_EXPECT_EQ(test, fixture->capture.last_sequence, (u64)0);
	KUNIT_EXPECT_MEMEQ(test, fixture->readback, fixture->original, 4096);
}

static void r084_original_unsupported(struct kunit *test)
{
	struct r084_fixture *fixture = r084_setup(test, "lzo-rle", 4);

	KUNIT_ASSERT_NOT_NULL(test, fixture);
	KUNIT_ASSERT_TRUE(test, r084_run_compression(fixture));
	KUNIT_EXPECT_LT(test, fixture->entry.length, 4096U);
	KUNIT_EXPECT_EQ(test, fixture->capture.record.state, R084_EMPTY);
	KUNIT_EXPECT_EQ(test, fixture->capture.last_sequence, (u64)0);
	r084_check_decoded(test, fixture, false);
}

static void r084_original_generation(struct kunit *test)
{
	struct r084_fixture *fixture = r084_setup(test, "lz4", 5);
	struct r084_record previous;
	DEFINE_XARRAY(tree);
	void *old;

	KUNIT_ASSERT_NOT_NULL(test, fixture);
	KUNIT_ASSERT_TRUE(test, r084_run_compression(fixture));
	KUNIT_ASSERT_EQ(test, fixture->capture.record.state, R084_PREPUBLICATION);
	previous = fixture->capture.record;
	/* Explicitly fixture-created XArray, not zswap_store_page or live swap.
	 * Erase and destroy before any assertion can abort and free the object.
	 */
	old = xa_store(&tree, 0, &fixture->entry, GFP_KERNEL);
	KUNIT_EXPECT_PTR_EQ(test, old, NULL);
	KUNIT_EXPECT_PTR_EQ(test, xa_load(&tree, 0), &fixture->entry);
	xa_erase(&tree, 0);
	xa_destroy(&tree);
	KUNIT_EXPECT_EQ(test, fixture->capture.record.state, R084_PREPUBLICATION);
	KUNIT_ASSERT_TRUE(test, r084_run_compression(fixture));
	KUNIT_EXPECT_EQ(test, fixture->capture.record.sequence, (u64)2);
	KUNIT_EXPECT_FALSE(test, r084_matches(&fixture->capture, &previous));
	KUNIT_EXPECT_TRUE(test, r084_matches(&fixture->capture,
					     &fixture->capture.record));
	/* Test-only failure notification, not a real failed xa_store. */
	r084_finish(&fixture->capture, false);
	KUNIT_EXPECT_EQ(test, fixture->capture.record.state, R084_EMPTY);
	r084_check_decoded(test, fixture, true);
	fixture->capture.last_sequence = ~(u64)0;
	KUNIT_ASSERT_TRUE(test, r084_run_compression(fixture));
	KUNIT_EXPECT_EQ(test, fixture->capture.record.state, R084_EMPTY);
	KUNIT_EXPECT_EQ(test, fixture->capture.last_sequence, ~(u64)0);
	r084_check_decoded(test, fixture, true);
}

static struct kunit_case r084_cases[] = {
	KUNIT_CASE(r084_original_lz4),
	KUNIT_CASE(r084_original_lzo1x),
	KUNIT_CASE(r084_original_raw_optional),
	KUNIT_CASE(r084_original_unsupported),
	KUNIT_CASE(r084_original_generation),
	{}
};

static struct kunit_suite r084_suite = {
	.name = "swapz_round084_original_store_credential",
	.test_cases = r084_cases,
};

kunit_test_suite(r084_suite);
