@@ -984,0 +989,11 @@
+#ifdef SWAPZ_ROUND098_SCOPED_PRODUCER_TEST
+/* One-shot permanent storage; only the RCU publication is revoked.
+ * Control owns file and broker cap until all carrier debt is drained.
+ */
+static DEFINE_MUTEX(swapz_mm_scope_lock);
+static struct swapz_mm_trial_scope swapz_mm_scope_storage;
+static const struct swapz_mm_trial_scope __rcu *swapz_mm_scope;
+static struct swapz_ticket_cap swapz_mm_scope_cap;
+static struct file *swapz_mm_scope_file;
+static bool swapz_mm_scope_used;
+#else
@@ -985,0 +1001,1 @@
+#endif
@@ -1008,0 +1025,120 @@
+#ifdef SWAPZ_ROUND098_SCOPED_PRODUCER_TEST
+static bool swapz_mm_scope_valid(const struct swapz_mm_trial_scope *scope)
+{
+	return scope && scope->identity && scope->bdev && scope->broker &&
+	       scope->session && scope->table_epoch && scope->target_epoch &&
+	       scope->area_epoch && scope->swap_type < MAX_SWAPFILES &&
+	       scope->first_sector && !(scope->first_sector & 7) &&
+	       scope->sector_count >= 8 && scope->sector_count <= 16 * 8 &&
+	       !(scope->sector_count & 7) &&
+	       scope->sector_count <= (sector_t)-1 - scope->first_sector &&
+	       (scope->first_sector + scope->sector_count - 8) / 8 <= U32_MAX;
+}
+
+int swapz_mm_trial_scope_publish(const struct swapz_mm_trial_scope *scope,
+	struct file *mapper_file)
+{
+	int error = -EINVAL;
+
+	/* The trusted caller owns a live opened block file through this call.
+	 * Holding a file ref retains the actual bdev/open, not just its address.
+	 * No open, claim or device operation is performed by this interface.
+	 * Controller must hold the current owner identity, freeze its request,
+	 * and serialize target readiness/route revoke under target queue lock
+	 * before calling scope revoke; join area, map and terminal ingress.
+	 */
+	if (!swapz_mm_scope_valid(scope) || !mapper_file ||
+	    !S_ISBLK(file_inode(mapper_file)->i_mode) ||
+	    file_bdev(mapper_file) != scope->bdev || bdev_is_partition(scope->bdev) ||
+	    scope->first_sector + scope->sector_count > bdev_nr_sectors(scope->bdev) ||
+	    atomic64_read(&swapz_mm_area_epochs[scope->swap_type]) != scope->area_epoch)
+		return error;
+	mutex_lock(&swapz_mm_scope_lock);
+	if (swapz_mm_scope_used || swapz_mm_scope_file) {
+		error = -EBUSY;
+		goto unlock;
+	}
+	error = swapz_ticket_broker_try_get(scope->broker, scope->session,
+		scope->table_epoch, &swapz_mm_scope_cap);
+	if (error)
+		goto unlock;
+	get_file(mapper_file);
+	swapz_mm_scope_file = mapper_file;
+	swapz_mm_scope_storage = *scope;
+	swapz_mm_scope_used = true;
+	rcu_assign_pointer(swapz_mm_scope, &swapz_mm_scope_storage);
+unlock:
+	mutex_unlock(&swapz_mm_scope_lock);
+	return error;
+}
+
+int swapz_mm_trial_scope_revoke(u64 identity)
+{
+	int error = -ESTALE;
+
+	mutex_lock(&swapz_mm_scope_lock);
+	if (!swapz_mm_scope_file || identity != swapz_mm_scope_storage.identity)
+		goto unlock;
+	/* No producer acquires this control mutex. Unpublish before grace;
+	 * a pre-reference entrant after grace sees NULL and cannot retain.
+	 * An already retained carrier keeps busy set through final release.
+	 */
+	if (rcu_access_pointer(swapz_mm_scope)) {
+		rcu_assign_pointer(swapz_mm_scope, NULL);
+		synchronize_rcu();
+	}
+	error = -EBUSY;
+	if (atomic_read_acquire(&swapz_mm_busy))
+		goto unlock; /* controller joins external debt, then retries */
+	error = swapz_ticket_broker_put(&swapz_mm_scope_cap);
+	if (error)
+		goto unlock; /* quarantine file and storage; never reuse */
+	fput(swapz_mm_scope_file);
+	swapz_mm_scope_file = NULL;
+unlock:
+	mutex_unlock(&swapz_mm_scope_lock);
+	return error;
+}
+
+bool swapz_mm_trial_scope_matches_route(struct block_device *bdev,
+	sector_t sector, u64 area, u32 type, u8 codec, u32 length,
+	const struct swapz_mm_route *route)
+{
+	const struct swapz_mm_trial_scope *scope;
+	bool matched;
+
+	if (!rcu_access_pointer(swapz_mm_scope) || type >= MAX_SWAPFILES ||
+	    atomic64_read(&swapz_mm_area_epochs[type]) != area)
+		return false;
+	rcu_read_lock();
+	scope = rcu_dereference(swapz_mm_scope);
+	matched = swapz_mm_scope_matches(scope, bdev, sector, area, type,
+		codec, length, route);
+	rcu_read_unlock();
+	return matched;
+}
+EXPORT_SYMBOL_GPL(swapz_mm_trial_scope_matches_route);
+
+/* No caller-provided area/type for read/ordinary/discard BIOs. Use the
+ * retained scope's own current area epoch, and exact whole-page geometry.
+ * This is an evidence prefilter; DM still owns exact target admission.
+ */
+bool swapz_mm_trial_scope_matches_origin(struct block_device *bdev, sector_t sector)
+{
+	const struct swapz_mm_trial_scope *scope;
+	bool matched = false;
+
+	if (!rcu_access_pointer(swapz_mm_scope))
+		return false;
+	rcu_read_lock();
+	scope = rcu_dereference(swapz_mm_scope);
+	if (scope && bdev == scope->bdev && !(sector & 7) &&
+	    sector >= scope->first_sector &&
+	    sector - scope->first_sector <= scope->sector_count - 8 &&
+	    atomic64_read(&swapz_mm_area_epochs[scope->swap_type]) == scope->area_epoch)
+		matched = true;
+	rcu_read_unlock();
+	return matched;
+}
+#endif
