@@ -68,0 +69,17 @@
+/* R098 source-only control. Caller must be separately authorized trusted
+ * built-in controller with a live opened exact mapper file and active swap
+ * scope. No export, no automatic caller, no user switch. One publication
+ * per boot, scope identity never reused. Revoke retries only in process
+ * context after external ingress is stopped and accepted I/O joined.
+ */
+#ifdef SWAPZ_ROUND098_SCOPED_PRODUCER_TEST
+int swapz_mm_trial_scope_publish(const struct swapz_mm_trial_scope *scope,
+	struct file *mapper_file);
+int swapz_mm_trial_scope_revoke(u64 identity);
+/* Built-in core evidence prefilter, not a substitute for target admission. */
+bool swapz_mm_trial_scope_matches_origin(struct block_device *bdev, sector_t sector);
+bool swapz_mm_trial_scope_matches_route(struct block_device *bdev,
+	sector_t sector, u64 area, u32 type, u8 codec, u32 length,
+	const struct swapz_mm_route *route);
+#endif
