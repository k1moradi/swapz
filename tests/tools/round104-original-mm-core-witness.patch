+#ifdef SWAPZ_ROUND104_INTEGRATION_TEST
+/* Published scope storage and mapper file remain live until observation
+ * unpublication and its grace period; no ref acquisition or sleeping. */
+bool swapz_mm_trial_scope_matches_exact(const struct swapz_mm_trial_scope *requested,
+	const struct file *mapper_file)
+{
+	const struct swapz_mm_trial_scope *scope;
+	bool matched = false;
+
+	if (!requested || !mapper_file)
+		return false;
+	rcu_read_lock();
+	scope = rcu_dereference(swapz_mm_capture_scope);
+	if (scope && mapper_file == READ_ONCE(swapz_mm_scope_file) &&
+	    scope->identity == requested->identity &&
+	    scope->bdev == requested->bdev && scope->broker == requested->broker &&
+	    scope->session == requested->session && scope->table_epoch == requested->table_epoch &&
+	    scope->target_epoch == requested->target_epoch &&
+	    scope->area_epoch == requested->area_epoch && scope->swap_type == requested->swap_type &&
+	    scope->first_sector == requested->first_sector && scope->sector_count == requested->sector_count &&
+	    swapz_mm_trial_area_epoch(scope->swap_type) == scope->area_epoch)
+		matched = true;
+	rcu_read_unlock();
+	return matched;
+}
+#endif
+
