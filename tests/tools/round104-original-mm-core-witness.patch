+#if defined(CONFIG_SWAPZ_ORIGINAL_MM_CARRIER_TEST) && defined(SWAPZ_ROUND104_INTEGRATION_TEST)
+/* The folio is still locked at the real store site. Capture only a direct
+ * whole-page slot of the exact currently published, bounded area.
+ * No new allocation, digest, decoded buffer or I/O. The byte owner copies
+ * synchronously; the local mapping never escapes this call. */
+static u64 swapz_mm_stage_input(struct folio *folio, long index, swp_entry_t slot)
+{
+	const struct swapz_mm_trial_scope *scope;
+	struct swap_info_struct *si;
+	sector_t sector;
+	void *source;
+	u64 token = 0;
+
+	if (!rcu_access_pointer(swapz_mm_capture_scope) || !swapz_trial_byte_active() ||
+	    PAGE_SIZE != 4096 || index || folio_order(folio))
+		return 0;
+	rcu_read_lock();
+	scope = rcu_dereference(swapz_mm_capture_scope);
+	if (!scope || swp_type(slot) != scope->swap_type ||
+	    swapz_mm_trial_area_epoch(scope->swap_type) != scope->area_epoch)
+		goto unlock;
+	si = __swap_entry_to_info(slot);
+	if (!si || si->ops != &swap_bdev_ops || si->bdev != scope->bdev)
+		goto unlock;
+	sector = swap_folio_sector(folio);
+	if (!sector || (sector & 7) || sector < scope->first_sector ||
+	    sector - scope->first_sector > scope->sector_count - 8 ||
+	    swp_offset(slot) != sector / 8)
+		goto unlock;
+	source = kmap_local_folio(folio, 0);
+	token = swapz_trial_byte_stage_input(scope->identity, scope->swap_type,
+		scope->area_epoch, swp_offset(slot), source, 4096);
+	kunmap_local(source);
+	if (!token)
+		swapz_trial_byte_invalidate();
+unlock:
+	rcu_read_unlock();
+	return token;
+}
+#endif
+
