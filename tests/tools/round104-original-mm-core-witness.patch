@@ -201,0 +285,27 @@
+#ifdef SWAPZ_ROUND104_INTEGRATION_TEST
+/* Called before DM drops its io, only for a qualified final unsplit
+ * completion. The wrapper still owns the actual BIO callback debt.
+ * Never record an ACK here; the block layer may still defer completion. */
+void swapz_mm_trial_dm_complete(const struct bio *bio, u64 operation, u64 original)
+{
+	struct swapz_trial_debt_slot *slot;
+	unsigned long flags;
+	bool valid = false;
+
+	spin_lock_irqsave(&swapz_mm_terminal_gate, flags);
+	slot = swapz_trial_debt_find(&swapz_mm_terminal_debt, bio, SWAPZ_TRIAL_DM);
+	if (slot && slot->observed && !slot->operation && !slot->original &&
+	    operation && original && bio->bi_end_io == swapz_mm_trial_dm_endio &&
+	    !bio_flagged(bio, BIO_CHAIN)) {
+		slot->operation = operation;
+		slot->original = original;
+		valid = true;
+	} else {
+		swapz_mm_terminal_debt.fault = true;
+	}
+	spin_unlock_irqrestore(&swapz_mm_terminal_gate, flags);
+	if (!valid)
+		swapz_trial_byte_invalidate();
+}
+#endif
+
