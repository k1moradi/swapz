@@ -19,0 +20,16 @@
+#ifdef SWAPZ_ROUND104_INTEGRATION_TEST
+#include "native-observation-integration.h"
+u64 swapz_trial_observation_append_sequence(const struct swapz_observation_record *record);
+
+/* The recorder reserves/publishes exactly once; the byte bridge consumes
+ * that ordinal, never a shared count. Byte failure is evidence loss only. */
+static inline bool swapz_mm_observation_emit(const struct swapz_observation_record *record)
+{
+	u64 sequence = swapz_trial_observation_append_sequence(record);
+
+	if (!sequence || !swapz_trial_byte_event(record, sequence, NULL, 0))
+		swapz_trial_byte_invalidate();
+	return sequence != 0;
+}
+#else
+#define swapz_mm_observation_emit(record) swapz_trial_observation_append(record)
@@ -20,0 +37,1 @@
+#endif
