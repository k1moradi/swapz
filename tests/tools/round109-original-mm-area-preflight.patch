diff --git a/mm/swapfile.c b/mm/swapfile.c
index d20a7f0003405bd1450cc52af63a773c91ee86b6..8b9826f09f7b3127d4cb739a072102763d8e1ecd 100644
--- a/mm/swapfile.c
+++ b/mm/swapfile.c
@@ -3087,0 +3088,59 @@
+#ifdef SWAPZ_ROUND109_AREA_PREFLIGHT_TEST
+/* Scalar snapshot only. The caller owns the opened mapper file throughout
+ * this query. swap_lock protects list membership, SWP_WRITEOK, swap-file
+ * lifetime and the area epoch transition. No native reference is acquired.
+ * Capacity/read-only state can change independently; final admission must
+ * revalidate the live range and epoch. A snapshot is never admission.
+ */
+int swapz_mm_trial_area_preflight(struct file *mapper_file, sector_t first,
+	sector_t count, struct swapz_mm_trial_area_identity *identity)
+{
+	struct swap_info_struct *si;
+	struct block_device *bdev;
+	sector_t capacity;
+	int error = -ESTALE;
+
+	if (!identity)
+		return -EINVAL;
+	*identity = (struct swapz_mm_trial_area_identity){};
+	if (!mapper_file || PAGE_SIZE != 4096 ||
+	    !S_ISBLK(file_inode(mapper_file)->i_mode) ||
+	    mapper_file->f_op != &def_blk_fops ||
+	    (mapper_file->f_mode & FMODE_PATH) ||
+	    !first || (first & 7) || !count || (count & 7) ||
+	    count > 16 * 8 || count > (sector_t)-1 - first)
+		return -EINVAL;
+	bdev = file_bdev(mapper_file);
+	if (!bdev || bdev_is_partition(bdev))
+		return -EINVAL;
+
+	spin_lock(&swap_lock);
+	/* Snapshot actual whole-device capacity once, not caller geometry. */
+	capacity = READ_ONCE(bdev->bd_nr_sectors);
+	if (bdev_read_only(bdev) || first >= capacity ||
+	    count > capacity - first)
+		goto unlock;
+	plist_for_each_entry(si, &swap_active_head, list) {
+		u64 current_epoch;
+
+		if (!(si->flags & SWP_WRITEOK) || si->ops != &swap_bdev_ops ||
+		    si->bdev != bdev || !si->swap_file ||
+		    !S_ISBLK(file_inode(si->swap_file)->i_mode) ||
+		    si->swap_file->f_op != &def_blk_fops ||
+		    si->swap_file->f_mapping != mapper_file->f_mapping ||
+		    first / 8 >= si->max || count / 8 > si->max - first / 8)
+			continue;
+		current_epoch = swapz_mm_trial_area_epoch(si->type);
+		if (!current_epoch)
+			break;
+		identity->swap_type = si->type;
+		identity->area_epoch = current_epoch;
+		error = 0;
+		break;
+	}
+unlock:
+	spin_unlock(&swap_lock);
+	return error;
+}
+#endif
+
diff --git a/include/linux/swapz_mm_carrier.h b/include/linux/swapz_mm_carrier.h
index bd88db905e5009e0e6161cad1d09b6d33bde2560..8d369c402780e06ffd317919acdd6bbd4802646e 100644
--- a/include/linux/swapz_mm_carrier.h
+++ b/include/linux/swapz_mm_carrier.h
@@ -101,0 +102,15 @@
+#ifdef SWAPZ_ROUND109_AREA_PREFLIGHT_TEST
+/* Private built-in read-only snapshot; no reference transfer or grant.
+ * Caller independently pins the opened exact mapper file and owns output.
+ * On failure (with non-NULL output), both scalar fields are zero.
+ * Type zero is valid on success; epoch is always nonzero. Revalidate at
+ * final admission, as the snapshot can become stale immediately.
+ */
+struct swapz_mm_trial_area_identity {
+	u32 swap_type;
+	u64 area_epoch;
+};
+int swapz_mm_trial_area_preflight(struct file *mapper_file, sector_t first,
+	sector_t count, struct swapz_mm_trial_area_identity *identity);
+#endif
+
