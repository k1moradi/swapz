diff --git a/include/linux/swapz_trial_debt.h b/include/linux/swapz_trial_debt.h
new file mode 100644
index 0000000000000000000000000000000000000000..207cd1b7a87f493992938cfa00ed4f95c7196811
--- /dev/null
+++ b/include/linux/swapz_trial_debt.h
@@ -0,0 +1,113 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _LINUX_SWAPZ_TRIAL_DEBT_H
+#define _LINUX_SWAPZ_TRIAL_DEBT_H
+#ifndef SWAPZ_TERMINAL_HOST_TEST
+#include <linux/types.h>
+#endif
+
+struct bio;
+enum swapz_trial_debt_kind {
+	SWAPZ_TRIAL_MM = 1, SWAPZ_TRIAL_DM, SWAPZ_TRIAL_ENTRY
+};
+
+/* At most 64 observed operations, each with MM, DM and submission debt.
+ * Overflow poisons qualification, never the original I/O.
+ * All calls are serialized by the caller's IRQ-safe gate. */
+#define SWAPZ_TRIAL_DEBT_SLOTS 192
+struct swapz_trial_debt_slot {
+	u64 ticket;
+	const void *owner;
+	void (*endio)(struct bio *);
+	enum swapz_trial_debt_kind kind;
+	bool observed;
+};
+
+struct swapz_trial_debt {
+	struct swapz_trial_debt_slot slots[SWAPZ_TRIAL_DEBT_SLOTS];
+	u64 sequence;
+	unsigned int count;
+	bool fault;
+};
+
+static inline struct swapz_trial_debt_slot *
+swapz_trial_debt_find(struct swapz_trial_debt *debt, const void *owner,
+	enum swapz_trial_debt_kind kind)
+{
+	unsigned int index;
+
+	if (!owner)
+		return NULL;
+	for (index = 0; index < SWAPZ_TRIAL_DEBT_SLOTS; ++index) {
+		struct swapz_trial_debt_slot *slot = &debt->slots[index];
+
+		if (slot->ticket && slot->kind == kind && slot->owner == owner)
+			return slot;
+	}
+	return NULL;
+}
+
+static inline u64 swapz_trial_debt_retain(struct swapz_trial_debt *debt,
+	const void *owner, enum swapz_trial_debt_kind kind,
+	void (*endio)(struct bio *))
+{
+	unsigned int index;
+
+	if (debt->sequence == ~(u64)0 ||
+	    (kind != SWAPZ_TRIAL_ENTRY && !owner) ||
+	    swapz_trial_debt_find(debt, owner, kind))
+		goto fault;
+	for (index = 0; index < SWAPZ_TRIAL_DEBT_SLOTS; ++index) {
+		struct swapz_trial_debt_slot *slot = &debt->slots[index];
+
+		if (slot->ticket)
+			continue;
+		*slot = (struct swapz_trial_debt_slot){
+			.ticket = ++debt->sequence, .owner = owner,
+			.kind = kind, .endio = endio
+		};
+		++debt->count;
+		return slot->ticket;
+	}
+fault:
+	debt->fault = true;
+	return 0;
+}
+
+/* Detach the object before invoking its terminal callback/free. Its address
+ * may be reused immediately; the old ticket remains owed until callback exit. */
+static inline u64 swapz_trial_debt_take(struct swapz_trial_debt *debt,
+	const void *owner, enum swapz_trial_debt_kind kind,
+	void (**endio)(struct bio *))
+{
+	struct swapz_trial_debt_slot *slot = swapz_trial_debt_find(debt, owner, kind);
+
+	if (!slot)
+		return 0;
+	if (endio)
+		*endio = slot->endio;
+	slot->owner = NULL;
+	return slot->ticket;
+}
+
+static inline bool swapz_trial_debt_put(struct swapz_trial_debt *debt,
+	u64 ticket, enum swapz_trial_debt_kind kind)
+{
+	unsigned int index;
+
+	if (!ticket)
+		return false;
+	for (index = 0; index < SWAPZ_TRIAL_DEBT_SLOTS; ++index) {
+		struct swapz_trial_debt_slot *slot = &debt->slots[index];
+
+		if (slot->ticket != ticket)
+			continue;
+		if (slot->owner || slot->kind != kind || !debt->count)
+			break;
+		*slot = (struct swapz_trial_debt_slot){};
+		--debt->count;
+		return true;
+	}
+	debt->fault = true;
+	return false;
+}
+#endif
diff --git a/mm/swapz-trial-terminal.inc b/mm/swapz-trial-terminal.inc
new file mode 100644
index 0000000000000000000000000000000000000000..3f980d04958676c22d44a6ca2778c4bd40a464fb
--- /dev/null
+++ b/mm/swapz-trial-terminal.inc
@@ -0,0 +1,252 @@
+/* Included only by the guarded original zswap implementation.
+ * Lock order: swap_lock/si->lock or scope mutex -> terminal gate.
+ * No gate -> area, broker, target, recorder or callback acquisition. */
+#include <linux/swapz_trial_debt.h>
+static DEFINE_SPINLOCK(swapz_mm_terminal_gate);
+static struct swapz_trial_debt swapz_mm_terminal_debt;
+static struct file *swapz_mm_area_file;
+static bool swapz_mm_area_invalidated, swapz_mm_area_drained;
+static bool swapz_mm_terminal_closed, swapz_mm_terminal_joined;
+
+u64 swapz_mm_trial_area_epoch(u32 type)
+{
+	return type < MAX_SWAPFILES ? atomic64_read(&swapz_mm_area_epochs[type]) : 0;
+}
+
+/* Called under the actual swap_lock at allocator publication or reinsertion.
+ * Failed swapoff gets a fresh epoch; old retained scope cannot be reopened. */
+void swapz_mm_trial_area_online(u32 type)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&swapz_mm_terminal_gate, flags);
+	if (rcu_access_pointer(swapz_mm_scope) && swapz_mm_area_invalidated &&
+	    swapz_mm_scope_storage.swap_type == type)
+		swapz_mm_terminal_debt.fault = true;
+	atomic64_set(&swapz_mm_area_epochs[type], swapz_mm_next(&swapz_mm_area_sequence));
+	spin_unlock_irqrestore(&swapz_mm_terminal_gate, flags);
+}
+
+void swapz_mm_trial_area_offline(u32 type)
+{
+	unsigned long flags;
+	u64 epoch;
+
+	spin_lock_irqsave(&swapz_mm_terminal_gate, flags);
+	epoch = atomic64_read(&swapz_mm_area_epochs[type]);
+	atomic64_set(&swapz_mm_area_epochs[type], 0);
+	if (rcu_access_pointer(swapz_mm_scope) &&
+	    swapz_mm_scope_storage.swap_type == type &&
+	    swapz_mm_scope_storage.area_epoch == epoch) {
+		swapz_mm_area_invalidated = true;
+		rcu_assign_pointer(swapz_mm_capture_scope, NULL);
+	}
+	spin_unlock_irqrestore(&swapz_mm_terminal_gate, flags);
+}
+
+/* Only the successful native swapoff path calls this, after users, RCU,
+ * work, extent and zswap teardown. Failed activation never supplies proof. */
+void swapz_mm_trial_area_retired(u32 type)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&swapz_mm_terminal_gate, flags);
+	if (swapz_mm_area_invalidated && swapz_mm_scope_storage.swap_type == type &&
+	    !atomic64_read(&swapz_mm_area_epochs[type]) && !swapz_mm_terminal_debt.fault)
+		swapz_mm_area_drained = true;
+	spin_unlock_irqrestore(&swapz_mm_terminal_gate, flags);
+}
+
+static void swapz_mm_terminal_put(u64 ticket, enum swapz_trial_debt_kind kind)
+{
+	unsigned long flags;
+
+	if (!ticket)
+		return;
+	spin_lock_irqsave(&swapz_mm_terminal_gate, flags);
+	swapz_trial_debt_put(&swapz_mm_terminal_debt, ticket, kind);
+	spin_unlock_irqrestore(&swapz_mm_terminal_gate, flags);
+}
+
+/* SIO debt starts before submission (including buffered merging and
+ * synchronous submit_bio_wait) and ends only after actual folio completion. */
+void swapz_mm_trial_mm_enter(struct block_device *bdev, u32 type, const void *sio)
+{
+	const struct swapz_mm_trial_scope *scope;
+	unsigned long flags;
+
+	if (!rcu_access_pointer(swapz_mm_scope))
+		return;
+	rcu_read_lock();
+	spin_lock_irqsave(&swapz_mm_terminal_gate, flags);
+	scope = rcu_dereference(swapz_mm_scope);
+	if (scope && bdev == scope->bdev && type == scope->swap_type) {
+		if (swapz_mm_terminal_closed)
+			swapz_mm_terminal_debt.fault = true;
+		else
+			swapz_trial_debt_retain(&swapz_mm_terminal_debt, sio, SWAPZ_TRIAL_MM, NULL);
+	}
+	spin_unlock_irqrestore(&swapz_mm_terminal_gate, flags);
+	rcu_read_unlock();
+}
+
+u64 swapz_mm_trial_mm_take(const void *sio)
+{
+	unsigned long flags;
+	u64 ticket;
+
+	if (!rcu_access_pointer(swapz_mm_scope))
+		return 0;
+	spin_lock_irqsave(&swapz_mm_terminal_gate, flags);
+	ticket = swapz_trial_debt_take(&swapz_mm_terminal_debt, sio, SWAPZ_TRIAL_MM, NULL);
+	spin_unlock_irqrestore(&swapz_mm_terminal_gate, flags);
+	return ticket;
+}
+
+void swapz_mm_trial_mm_put(u64 ticket)
+{
+	swapz_mm_terminal_put(ticket, SWAPZ_TRIAL_MM);
+}
+
+/* Preserve the original completion function/private data. The wrapper
+ * remains on the actual original through DM deferral/requeue and chained
+ * split completion. It never reads a BIO after the original callback. */
+static void swapz_mm_trial_dm_endio(struct bio *bio)
+{
+	void (*endio)(struct bio *) = NULL;
+	unsigned long flags;
+	u64 ticket;
+
+	spin_lock_irqsave(&swapz_mm_terminal_gate, flags);
+	ticket = swapz_trial_debt_take(&swapz_mm_terminal_debt, bio, SWAPZ_TRIAL_DM, &endio);
+	if (!ticket)
+		swapz_mm_terminal_debt.fault = true;
+	bio->bi_end_io = endio;
+	spin_unlock_irqrestore(&swapz_mm_terminal_gate, flags);
+	if (endio)
+		endio(bio);
+	swapz_mm_terminal_put(ticket, SWAPZ_TRIAL_DM);
+}
+
+/* Start before DM obtains its live-table SRCU reference. An independent
+ * entry ticket survives synchronous completion until submission exits.
+ * Reissued originals retain their original ticket/callback, not a new ACK. */
+u64 swapz_mm_trial_dm_enter(struct bio *bio)
+{
+	const struct swapz_mm_trial_scope *scope;
+	struct swapz_trial_debt_slot *slot;
+	unsigned long flags;
+	u64 entrant = 0;
+
+	if (!rcu_access_pointer(swapz_mm_scope))
+		return 0;
+	rcu_read_lock();
+	spin_lock_irqsave(&swapz_mm_terminal_gate, flags);
+	scope = rcu_dereference(swapz_mm_scope);
+	if (!scope || bio->bi_bdev != scope->bdev)
+		goto unlock;
+	slot = swapz_trial_debt_find(&swapz_mm_terminal_debt, bio, SWAPZ_TRIAL_DM);
+	if (slot) {
+		if (bio->bi_end_io != swapz_mm_trial_dm_endio)
+			swapz_mm_terminal_debt.fault = true;
+	} else if (swapz_mm_terminal_closed || bio->bi_end_io == swapz_mm_trial_dm_endio ||
+		   bio_flagged(bio, BIO_CLONED) || bio_flagged(bio, BIO_REMAPPED)) {
+		/* A split child or unrelated stacked BIO may use the block
+		 * layer's special chain callback. Never replace that callback.
+		 * Its retained parent (if any) still has terminal debt. */
+		swapz_mm_terminal_debt.fault = true;
+		goto unlock;
+	} else if (swapz_trial_debt_retain(&swapz_mm_terminal_debt, bio, SWAPZ_TRIAL_DM,
+					  bio->bi_end_io)) {
+		bio->bi_end_io = swapz_mm_trial_dm_endio;
+	}
+	entrant = swapz_trial_debt_retain(&swapz_mm_terminal_debt, NULL, SWAPZ_TRIAL_ENTRY, NULL);
+unlock:
+	spin_unlock_irqrestore(&swapz_mm_terminal_gate, flags);
+	rcu_read_unlock();
+	return entrant;
+}
+
+void swapz_mm_trial_dm_leave(u64 entrant)
+{
+	swapz_mm_terminal_put(entrant, SWAPZ_TRIAL_ENTRY);
+}
+
+/* Called only after the original core geometry and exact route checks.
+ * One observation per retained original; requeue cannot mint a second. */
+bool swapz_mm_trial_dm_origin(const struct bio *bio, sector_t sector)
+{
+	struct swapz_trial_debt_slot *slot;
+	const struct swapz_mm_trial_scope *scope;
+	unsigned long flags;
+	bool matched = false;
+
+	if (!rcu_access_pointer(swapz_mm_scope))
+		return false;
+	rcu_read_lock();
+	spin_lock_irqsave(&swapz_mm_terminal_gate, flags);
+	scope = rcu_dereference(swapz_mm_scope);
+	slot = swapz_trial_debt_find(&swapz_mm_terminal_debt, bio, SWAPZ_TRIAL_DM);
+	if (scope && slot && !slot->observed && bio->bi_end_io == swapz_mm_trial_dm_endio &&
+	    bio->bi_bdev == scope->bdev &&
+	    !(sector & 7) && sector >= scope->first_sector &&
+	    sector - scope->first_sector <= scope->sector_count - 8) {
+		slot->observed = true;
+		matched = true;
+	}
+	spin_unlock_irqrestore(&swapz_mm_terminal_gate, flags);
+	rcu_read_unlock();
+	return matched;
+}
+
+static bool swapz_mm_terminal_ready(void)
+{
+	return swapz_mm_area_drained && swapz_mm_terminal_closed &&
+	       !swapz_mm_terminal_debt.fault && !swapz_mm_terminal_debt.count &&
+	       !atomic_read_acquire(&swapz_mm_busy);
+}
+
+/* Retryable process-context fence, never a wait on a live I/O callback.
+ * Exact area retirement is mandatory; no caller-supplied zero/epoch proof.
+ * Target map/provider/worker and broker retirement remain separate joins. */
+int swapz_mm_trial_scope_join_external(u64 identity, u64 session,
+	u64 table_epoch, u64 target_epoch)
+{
+	unsigned long flags;
+	int error = -ESTALE;
+
+	mutex_lock(&swapz_mm_scope_lock);
+	if (!swapz_mm_scope_file || identity != swapz_mm_scope_storage.identity ||
+	    session != swapz_mm_scope_storage.session ||
+	    table_epoch != swapz_mm_scope_storage.table_epoch ||
+	    target_epoch != swapz_mm_scope_storage.target_epoch)
+		goto unlock;
+	error = -EBUSY;
+	if (swapz_mm_scope_transition || !swapz_mm_scope_capture_stopped)
+		goto unlock;
+	spin_lock_irqsave(&swapz_mm_terminal_gate, flags);
+	if (swapz_mm_terminal_debt.fault)
+		error = -EUCLEAN;
+	else if (swapz_mm_area_drained) {
+		swapz_mm_terminal_closed = true;
+		error = 0;
+	}
+	spin_unlock_irqrestore(&swapz_mm_terminal_gate, flags);
+	if (error)
+		goto unlock;
+	swapz_mm_scope_transition = true;
+	mutex_unlock(&swapz_mm_scope_lock);
+	synchronize_rcu();
+	mutex_lock(&swapz_mm_scope_lock);
+	spin_lock_irqsave(&swapz_mm_terminal_gate, flags);
+	error = swapz_mm_terminal_debt.fault ? -EUCLEAN : -EBUSY;
+	if (swapz_mm_terminal_ready()) {
+		swapz_mm_terminal_joined = true;
+		error = 0;
+	}
+	spin_unlock_irqrestore(&swapz_mm_terminal_gate, flags);
+	swapz_mm_scope_transition = false;
+unlock:
+	mutex_unlock(&swapz_mm_scope_lock);
+	return error;
+}
