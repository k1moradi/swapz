+/* The real allocator list, not a caller-chosen type or epoch. Hold the
+ * active swap file independently of the controller's opened mapper file.
+ * Direct block swap has the native [0, max) identity extent. */
+int swapz_mm_trial_area_get(struct file *mapper_file, sector_t first,
+	sector_t count, u32 *type, u64 *epoch, struct file **area_file)
+{
+	struct swap_info_struct *si;
+	struct block_device *bdev;
+	int error = -ESTALE;
+
+	if (!mapper_file || !type || !epoch || !area_file || PAGE_SIZE != 4096 ||
+	    !S_ISBLK(file_inode(mapper_file)->i_mode) || !first || (first & 7) ||
+	    !count || (count & 7) || count > 16 * 8 ||
+	    count > (sector_t)-1 - first)
+		return -EINVAL;
+	bdev = file_bdev(mapper_file);
+	if (!bdev || bdev_is_partition(bdev))
+		return -EINVAL;
+	spin_lock(&swap_lock);
+	plist_for_each_entry(si, &swap_active_head, list) {
+		u64 current_epoch;
+
+		if (!(si->flags & SWP_WRITEOK) || si->ops != &swap_bdev_ops ||
+		    si->bdev != bdev || !si->swap_file ||
+		    !S_ISBLK(file_inode(si->swap_file)->i_mode) ||
+		    si->swap_file->f_mapping != mapper_file->f_mapping ||
+		    first / 8 >= si->max || count / 8 > si->max - first / 8)
+			continue;
+		current_epoch = swapz_mm_trial_area_epoch(si->type);
+		if (!current_epoch)
+			break;
+		get_file(si->swap_file);
+		*area_file = si->swap_file;
+		*type = si->type;
+		*epoch = current_epoch;
+		error = 0;
+		break;
+	}
+	spin_unlock(&swap_lock);
+	return error;
+}
+#endif
