-static bool zswap_compress(struct folio *folio, long index,
+#ifdef CONFIG_SWAPZ_ORIGINAL_MM_CARRIER_TEST
+/* One optional scratch/carrier slot, NOT a production queue limit. Built-in
+ * static lifetime independent of target dtr. No new reclaim machinery.
+ * The route provider is intentionally absent until the selected-DM ABI and
+ * generation fencing are accepted; do not synthesize any target identity.
+ */
+static struct swapz_mm_carrier swapz_mm_carrier;
+static atomic_t swapz_mm_busy = ATOMIC_INIT(0);
+static atomic64_t swapz_mm_store_sequence = ATOMIC64_INIT(0);
+static atomic64_t swapz_mm_area_sequence = ATOMIC64_INIT(0);
+static atomic64_t swapz_mm_area_epochs[MAX_SWAPFILES];
+
+static u64 swapz_mm_next(atomic64_t *counter)
+{
+	s64 previous = atomic64_read(counter);
+
+	/* One CAS; contention/exhaustion declines optimization, never wraps. */
+	if (previous < 0 || previous == S64_MAX ||
+	    !atomic64_try_cmpxchg(counter, &previous, previous + 1))
+		return 0;
+	return previous + 1;
+}
+
+static u8 swapz_mm_profile(const char *name, const char *driver)
+{
+	if (!strcmp(name, "lz4") && !strcmp(driver, "lz4-scomp"))
+		return SWAPZ_TICKET_LZ4;
+	if (!strcmp(name, "lzo") && !strcmp(driver, "lzo-scomp"))
+		return SWAPZ_TICKET_LZO1X;
+	return 0;
+}
+
+/* One bounded contiguous sparse array; each cell is exclusively owned by
+ * one successful try-CAS, never held across SG pin or target callbacks.
+ * Collisions and contention only lose an optional credential. No allocations.
+ */
+struct swapz_mm_source_cell {
+	atomic_t busy;
+	struct swapz_mm_source source;
+};
+static struct swapz_mm_source_cell swapz_mm_sources[SWAPZ_MM_SOURCE_SLOTS];
+static DEFINE_MUTEX(swapz_mm_provider_lock);
+static const struct swapz_mm_route_provider __rcu *swapz_mm_provider;
+
+/* Registration and unregistration are process-context only, outside target
+ * and broker locks. Provider owner pins callback code and broker storage
+ * through unregister + RCU grace period; broker capabilities then pin
+ * outstanding independent leases. No raw target pointer escapes a callback.
+ */
+int swapz_mm_register_provider(const struct swapz_mm_route_provider *provider)
+{
+	int error = 0;
+
+	if (!provider || !provider->eligible || !provider->lookup)
+		return -EINVAL;
+	mutex_lock(&swapz_mm_provider_lock);
+	if (rcu_access_pointer(swapz_mm_provider))
+		error = -EBUSY;
+	else
+		rcu_assign_pointer(swapz_mm_provider, provider);
+	mutex_unlock(&swapz_mm_provider_lock);
+	return error;
+}
+
+int swapz_mm_unregister_provider(const struct swapz_mm_route_provider *provider)
+{
+	int error = 0;
+
+	mutex_lock(&swapz_mm_provider_lock);
+	if (!provider || rcu_access_pointer(swapz_mm_provider) != provider)
+		error = -EINVAL;
+	else {
+		rcu_assign_pointer(swapz_mm_provider, NULL);
+		synchronize_rcu();
+	}
+	mutex_unlock(&swapz_mm_provider_lock);
+	return error;
+}
+
+static bool swapz_mm_eligible(struct block_device *bdev, sector_t sector,
+			      u8 codec, u32 length)
+{
+	const struct swapz_mm_route_provider *provider;
+	bool eligible = false;
+
+	rcu_read_lock();
+	provider = rcu_dereference(swapz_mm_provider);
+	if (provider)
+		eligible = provider->eligible(bdev, sector, codec, length);
+	rcu_read_unlock();
+	return eligible;
+}
+
+static bool swapz_mm_route_try(struct swap_info_struct *si, sector_t sector,
+			      u8 codec, u32 length, struct swapz_mm_route *route,
+			      struct swapz_ticket_cap *cap)
+{
+	const struct swapz_mm_route_provider *provider;
+	bool retained = false;
+
+	rcu_read_lock();
+	provider = rcu_dereference(swapz_mm_provider);
+	if (provider && provider->lookup(si->bdev, sector, codec, length, route) &&
+	    route->broker && route->target_session && route->table_epoch &&
+	    route->target_epoch && route->dm_generation)
+		retained = !swapz_ticket_broker_try_get(route->broker,
+			route->target_session, route->table_epoch, cap);
+	rcu_read_unlock();
+	return retained;
+}
+
+static void swapz_mm_capture(struct zswap_entry *entry, struct folio *folio,
+			    long index, struct acomp_req *request, const u8 *bytes)
+{
+	struct crypto_acomp *tfm = crypto_acomp_reqtfm(request);
+	swp_entry_t slot = folio_swap_entry(folio, index);
+	struct swap_info_struct *si;
+	struct swapz_mm_source_cell *cell;
+	struct swapz_mm_source *source;
+	const void *original;
+	u64 sequence, area;
+	sector_t sector;
+	u8 codec;
+
+	/* No provider -> no hash, sequence increment or sparse-array access. */
+	if (!rcu_access_pointer(swapz_mm_provider) || PAGE_SIZE != 4096 ||
+	    index || folio_order(folio) || !entry->length || entry->length > 4095)
+		return;
+	codec = swapz_mm_profile(crypto_acomp_alg_name(tfm), crypto_acomp_driver_name(tfm));
+	area = atomic64_read(&swapz_mm_area_epochs[swp_type(slot)]);
+	if (!codec || !area)
+		return;
+	si = __swap_entry_to_info(slot);
+	if (!si || si->ops != &swap_bdev_ops || !si->bdev ||
+	    bdev_is_partition(si->bdev))
+		return;
+	sector = swap_folio_sector(folio);
+	if (!sector || (sector & 7) ||
+	    !swapz_mm_eligible(si->bdev, sector, codec, entry->length))
+		return;
+	sequence = swapz_mm_next(&swapz_mm_store_sequence);
+	if (!sequence)
+		return;
+	cell = &swapz_mm_sources[swapz_mm_source_index(sequence)];
+	if (atomic_cmpxchg_acquire(&cell->busy, 0, 1))
+		return;
+	source = &cell->source;
+	source->cookie = sequence;
+	source->area_epoch = area;
+	source->slot_offset = swp_offset(slot);
+	source->swap_type = swp_type(slot);
+	source->length = entry->length;
+	source->codec = codec;
+	source->crc = swapz_crc32c_bytes(bytes, entry->length);
+	original = kmap_local_folio(folio, 0);
+	sha256(original, 4096, source->sha256);
+	kunmap_local(original);
+	entry->original_cookie = sequence;
+	atomic_set_release(&cell->busy, 0);
+}
+
+/* A cookie is nonreused, even if the XArray entry or sparse cell is reused. */
+static bool swapz_mm_read_source(struct zswap_entry *entry, swp_entry_t slot,
+				 struct swapz_ticket_key *key)
+{
+	u64 cookie = entry->original_cookie;
+	struct swapz_mm_source_cell *cell;
+	bool valid;
+
+	if (!cookie)
+		return false;
+	cell = &swapz_mm_sources[swapz_mm_source_index(cookie)];
+	if (atomic_cmpxchg_acquire(&cell->busy, 0, 1))
+		return false;
+	valid = swapz_mm_source_key(&cell->source, cookie,
+		atomic64_read(&swapz_mm_area_epochs[swp_type(slot)]),
+		swp_offset(slot), swp_type(slot), entry->length, key);
+	atomic_set_release(&cell->busy, 0);
+	return valid;
+}
+
+
+static void swapz_mm_release_workfn(struct work_struct *work)
+{
+	(void)work;
+	if (swapz_mm_carrier.lease.broker &&
+	    WARN_ON_ONCE(swapz_ticket_put(&swapz_mm_carrier.lease)))
+		return; /* quarantine on broken ownership, never reuse */
+	if (swapz_mm_carrier.cap.broker &&
+	    WARN_ON_ONCE(swapz_ticket_broker_put(&swapz_mm_carrier.cap)))
+		return; /* quarantine a broken capability too */
+	swapz_mm_carrier.bdev = NULL;
+	swapz_mm_carrier.page = NULL;
+	atomic_set_release(&swapz_mm_busy, 0);
+}
+static DECLARE_WORK(swapz_mm_release_work, swapz_mm_release_workfn);
+
+void swapz_mm_drop(struct swapz_mm_carrier **owner)
+{
+	struct swapz_mm_carrier *carrier = *owner;
+
+	if (!carrier)
+		return;
+	*owner = NULL;
+	/* Static work item; no allocation or broker lock here. A busy slot
+	 * cannot be reused until its release worker finishes the final put.
+	 */
+	WARN_ON_ONCE(!queue_work(system_unbound_wq, &swapz_mm_release_work));
+}
+
+int swapz_mm_candidate_get(const struct bio *origin, struct swapz_ticket_ref *out)
+{
+	const struct swapz_mm_carrier *carrier;
+
+	if (!origin || !out || out->broker)
+		return -EINVAL;
+	carrier = origin->bi_swapz_original;
+	if (!swapz_mm_bio_matches(origin, carrier))
+		return -EOPNOTSUPP;
+	/* Caller proves origin stable, no foreign lock held. */
+	return swapz_ticket_retain(&carrier->lease, out);
+}
+
+static void swapz_mm_preerase(struct zswap_entry *entry, struct folio *folio,
+			     swp_entry_t slot, struct swap_io_ctx *ctx)
+{
+	struct swapz_ticket_key key = {};
+	struct swapz_mm_route route = {};
+	struct swapz_mm_carrier *carrier = &swapz_mm_carrier;
+	struct swap_info_struct *si = __swap_entry_to_info(slot);
+	struct zswap_pool *pool;
+	struct scatterlist sg[2];
+	const void *decoded;
+	u8 digest[32];
+	sector_t sector;
+	unsigned int nents;
+	size_t copied;
+
+	/* Caller already holds locked order-0 swapcache folio, verified the
+	 * actual XArray entry and successfully decompressed the full page.
+	 * That lifetime pins source pool/slot/area until original erase.
+	 */
+	if (PAGE_SIZE != 4096 || folio_order(folio) || !folio_test_locked(folio) ||
+	    !folio_test_swapcache(folio) || folio->swap.val != slot.val ||
+	    !swapz_mm_read_source(entry, slot, &key) ||
+	    ctx->sio || ctx->original || !si || si->ops != &swap_bdev_ops ||
+	    !si->bdev || bdev_is_partition(si->bdev))
+		return;
+	sector = swap_folio_sector(folio);
+	if (!sector || (sector & 7) || atomic_cmpxchg_acquire(&swapz_mm_busy, 0, 1))
+		return;
+	if (!swapz_mm_route_try(si, sector, key.codec, key.length,
+			       &route, &carrier->cap))
+		goto decline;
+	/* Source credential is not writable by the route provider. */
+	key.target_session = route.target_session;
+	key.table_epoch = route.table_epoch;
+	key.target_epoch = route.target_epoch;
+	key.logical_page = route.logical_page;
+	key.dm_generation = route.dm_generation;
+	if (swapz_ticket_reserve(carrier->cap.broker, &key, &carrier->lease))
+		goto decline;
+	pool = zswap_entry_pool(entry);
+	if (!pool)
+		goto decline;
+
+	zs_obj_read_sg_begin(pool->zs_pool, entry->handle, sg, key.length);
+	nents = sg_is_last(sg) ? 1 : 2;
+	copied = sg_copy_to_buffer(sg, nents, carrier->scratch, key.length);
+	zs_obj_read_sg_end(pool->zs_pool, entry->handle);
+	/* No SG, pool, XArray, acomp or target lock across seal/CRC/SHA. */
+	if (copied != key.length)
+		goto decline;
+	decoded = kmap_local_folio(folio, 0);
+	sha256(decoded, 4096, digest);
+	kunmap_local(decoded);
+	if (memcmp(digest, key.sha256, sizeof(digest)) ||
+	    swapz_ticket_seal(&carrier->lease, carrier->scratch, key.length))
+		goto decline;
+
+	carrier->bdev = si->bdev;
+	carrier->page = &folio->page;
+	carrier->sector = sector;
+	ctx->original = carrier; /* producer -> sole original ctx owner */
+	return;
+decline:
+	swapz_mm_drop(&carrier);
+}
+#endif
