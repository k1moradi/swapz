@@ -0,0 +1,112 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _LINUX_SWAPZ_MM_CARRIER_H
+#define _LINUX_SWAPZ_MM_CARRIER_H
+/* Unapplied candidate. No Kconfig/Kbuild enables this guard.
+ * Stage the exact product broker/codec beside this header for a future build.
+ * Only original sio owns the carrier; BIO has a non-owning, revocable view.
+ */
+#ifdef CONFIG_SWAPZ_ORIGINAL_MM_CARRIER_TEST
+#include <linux/blkdev.h>
+#include <linux/mm_types.h>
+#include "zswap-original-ticket.h"
+
+#define SWAPZ_MM_SOURCE_SLOTS 64U
+/* Source-only credential, never persisted and never contains route fields. */
+struct swapz_mm_source {
+	swapz_u64 cookie, area_epoch, slot_offset;
+	swapz_u32 swap_type, length, crc;
+	swapz_u8 sha256[32], codec;
+};
+
+static inline unsigned int swapz_mm_source_index(swapz_u64 cookie)
+{
+	return (unsigned int)(cookie & (SWAPZ_MM_SOURCE_SLOTS - 1U));
+}
+
+/* Caller exclusively pins the sparse cell. No output on mismatch. */
+static inline bool swapz_mm_source_key(const struct swapz_mm_source *source,
+	swapz_u64 cookie, swapz_u64 area, swapz_u64 offset, swapz_u32 type,
+	swapz_u32 length, struct swapz_ticket_key *key)
+{
+	if (!source || !key || !cookie || !area || source->cookie != cookie ||
+	    source->area_epoch != area || source->slot_offset != offset ||
+	    source->swap_type != type || source->length != length ||
+	    !length || length > 4095U ||
+	    (source->codec != SWAPZ_TICKET_LZ4 && source->codec != SWAPZ_TICKET_LZO1X))
+		return false;
+	*key = (struct swapz_ticket_key){
+		.area_epoch = area, .store_sequence = cookie, .slot_offset = offset,
+		.swap_type = type, .length = length, .decoded_length = 4096U,
+		.crc = source->crc, .representation = SWAPZ_TICKET_ORIGINAL,
+		.codec = source->codec, .version = 1U
+	};
+	for (unsigned int index = 0; index < sizeof(key->sha256); ++index)
+		key->sha256[index] = source->sha256[index];
+	return true;
+}
+
+struct swapz_mm_route {
+	struct swapz_ticket_broker *broker; /* borrowed until callback grace period */
+	swapz_u64 target_session, table_epoch, target_epoch, logical_page, dm_generation;
+};
+
+/* Immutable provider registration. Nonblocking callbacks under RCU; no
+ * sleeping, allocation, broker calls or target pointer escape. lookup must
+ * release all target locks before return; broker storage lives through
+ * unregister + RCU grace and every separately retained capability.
+ * Both callbacks check the exact codec and length against the current
+ * route policy (normal 3568 or separately admitted experimental 4095).
+ * Neither callback is source authentication. No default provider.
+ */
+struct swapz_mm_route_provider {
+	bool (*eligible)(struct block_device *, sector_t, swapz_u8, swapz_u32);
+	bool (*lookup)(struct block_device *, sector_t, swapz_u8, swapz_u32,
+		       struct swapz_mm_route *);
+};
+int swapz_mm_register_provider(const struct swapz_mm_route_provider *);
+int swapz_mm_unregister_provider(const struct swapz_mm_route_provider *);
+
+struct swapz_mm_carrier {
+	struct swapz_ticket_ref lease;
+	struct swapz_ticket_cap cap;
+	struct block_device *bdev; /* comparison only; no target pointer */
+	struct page *page; /* borrowed from locked/writeback folio */
+	sector_t sector;
+	u8 scratch[4096];
+};
+
+/* Exclusive owner variables only; no aliasing or manufacture of a lease. */
+static inline bool swapz_mm_move(struct swapz_mm_carrier **dst,
+			       struct swapz_mm_carrier **src)
+{
+	if (!dst || !src || dst == src || *dst || !*src)
+		return false;
+	*dst = *src;
+	*src = NULL;
+	return true;
+}
+
+/* Drops owner once, asynchronously; never acquire broker lock from endio. */
+void swapz_mm_drop(struct swapz_mm_carrier **owner);
+
+/* Selected DM core must prove actual clone/table and origin lifetime before
+ * this call; no foreign lock held. Generic clones never inherit the view.
+ * This is only a retained candidate, not claim or source authentication.
+ */
+int swapz_mm_candidate_get(const struct bio *origin, struct swapz_ticket_ref *out);
+
+static inline bool swapz_mm_bio_matches(const struct bio *bio,
+				       const struct swapz_mm_carrier *carrier)
+{
+	return bio && carrier && carrier->lease.broker && bio->bi_io_vec &&
+	       bio->bi_bdev == carrier->bdev &&
+	       bio->bi_iter.bi_sector == carrier->sector &&
+	       bio->bi_iter.bi_size == 4096 && !bio->bi_iter.bi_idx &&
+	       !bio->bi_iter.bi_offset && bio->bi_vcnt == 1 &&
+	       bio_op(bio) == REQ_OP_WRITE && (bio->bi_opf & REQ_SWAP) &&
+	       !bio_flagged(bio, BIO_CLONED) && !bio_flagged(bio, BIO_REMAPPED) &&
+	       bio->bi_io_vec[0].bv_page == carrier->page &&
+	       !bio->bi_io_vec[0].bv_offset && bio->bi_io_vec[0].bv_len == 4096;
+}
+#endif
+#endif
