diff --git a/mm/zswap.c b/mm/zswap.c
--- a/mm/zswap.c
+++ b/mm/zswap.c
@@ -1049,2 +1049,8 @@
-	(void)work;
-	if (swapz_mm_carrier.lease.broker &&
+	(void)work;
+	/* Terminal BIO clears its RCU borrow before this deferred work.
+	 * Readers already retaining a lease finish before reuse.
+	 * Only this worker waits, never ordinary I/O or target dtr.
+	 */
+	if (swapz_mm_carrier.bdev)
+		synchronize_rcu();
+	if (swapz_mm_carrier.lease.broker &&
@@ -1077,9 +1083,15 @@
-	const struct swapz_mm_carrier *carrier;
-
-	if (!origin || !out || out->broker)
-		return -EINVAL;
-	carrier = origin->bi_swapz_original;
-	if (!swapz_mm_bio_matches(origin, carrier))
-		return -EOPNOTSUPP;
-	/* Caller proves origin stable, no foreign lock held. */
-	return swapz_ticket_retain(&carrier->lease, out);
+	const struct swapz_mm_carrier *carrier;
+	int error = -EOPNOTSUPP;
+
+	if (!origin || !out || out->broker)
+		return -EINVAL;
+	/* Caller owns live mapping and stable BIO geometry. RCU pins the
+	 * carrier only, not the BIO or folio. No foreign lock; kernel
+	 * broker retain uses a non-sleeping spinlock.
+	 */
+	rcu_read_lock();
+	carrier = rcu_dereference(origin->bi_swapz_original);
+	if (swapz_mm_bio_matches(origin, carrier))
+		error = swapz_ticket_retain(&carrier->lease, out);
+	rcu_read_unlock();
+	return error;
