-	if (!rcu_access_pointer(swapz_mm_scope) || type >= MAX_SWAPFILES ||
+	if (!rcu_access_pointer(swapz_mm_capture_scope) || type >= MAX_SWAPFILES ||
@@ -1114,1 +1189,1 @@
-	scope = rcu_dereference(swapz_mm_scope);
+	scope = rcu_dereference(swapz_mm_capture_scope);
@@ -1157,1 +1232,1 @@
