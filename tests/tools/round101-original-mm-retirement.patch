+	return rcu_access_pointer(swapz_mm_capture_scope) != NULL;
@@ -1263,0 +1339,8 @@
+#ifdef SWAPZ_ROUND098_SCOPED_PRODUCER_TEST
+	/* Join cookie publication with capture stop, not just the lookup. */
+	rcu_read_lock();
+	if (!rcu_dereference(swapz_mm_capture_scope)) {
+		rcu_read_unlock();
+		return;
+	}
+#endif
@@ -1266,0 +1350,3 @@
+#ifdef SWAPZ_ROUND098_SCOPED_PRODUCER_TEST
+	rcu_read_unlock();
+#endif
@@ -1433,2 +1519,1 @@
-	    && rcu_dereference(swapz_mm_scope) &&
-	    carrier->scope_identity == swapz_mm_scope_storage.identity
+	    && swapz_mm_trial_scope_bind_permitted(carrier)
