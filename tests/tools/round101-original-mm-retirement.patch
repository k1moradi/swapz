diff --git a/src/kernel/zswap-original-broker-owner.inc b/src/kernel/zswap-original-broker-owner.inc
index 278a93a3fd3fd260444aebc55d4a87112e56f704..a6a025b1d56513919ac83f4367e9c306fa12c933 100644
--- a/src/kernel/zswap-original-broker-owner.inc
+++ b/src/kernel/zswap-original-broker-owner.inc
@@ -53,0 +54,5 @@
+/* Lifecycle mutex: exact last destruction and a process-context work join.
+ * No reopening is needed to observe retirement. */
+static swapz_u64 owner_retired_session, owner_retired_epoch;
+static bool owner_witness_joining;
+static int owner_first_error;
@@ -78,2 +83,3 @@
-/* Last broker debt is captured under the broker lock, then notified after
- * unlock. A late notifier cannot address freed arrays or a fresh session. */
+/* Last broker debt queues work under the broker lock. The gate never
+ * acquires the broker lock, and scheduling never invokes work inline.
+ * Retirement cannot overtake a final-debt notification. */
@@ -194,1 +200,1 @@
-	if (owner_broker.initialized || owner_quarantined) {
+	if (owner_broker.initialized || owner_quarantined || owner_witness_joining) {
@@ -271,0 +278,1 @@
+		owner_first_error = error;
@@ -347,0 +355,2 @@
+	owner_retired_session = session;
+	owner_retired_epoch = epoch;
@@ -351,0 +361,2 @@
+	if (!owner_first_error)
+		owner_first_error = error;
@@ -363,0 +375,38 @@
+	owner_unlock();
+	return error;
+}
+
+/* Query the exact old owner identity, never interpret ESTALE as success.
+ * A native flush joins a worker which may have just dropped the lifecycle
+ * mutex; no lock is held over that wait, and open cannot reuse its slot. */
+int swapz_mm_broker_owner_retired(swapz_u64 session, swapz_u64 epoch)
+{
+	unsigned long flags = 0;
+	int error = -ESTALE;
+	bool pending;
+
+	owner_lock();
+	if (!session || !epoch || session != owner_session || epoch != owner_epoch)
+		goto unlock;
+	if (owner_quarantined) {
+		error = owner_first_error ? owner_first_error : -EIO;
+		goto unlock;
+	}
+	error = -EBUSY;
+	if (owner_witness_joining || owner_broker.initialized ||
+	    owner_retired_session != session || owner_retired_epoch != epoch)
+		goto unlock;
+	owner_witness_joining = true;
+	owner_unlock();
+#ifdef __KERNEL__
+	flush_work(&owner_retry_work);
+#endif
+	owner_lock();
+	gate_lock(flags);
+	pending = owner_retry_pending || owner_retry_armed || owner_entrants || owner_accepting;
+	gate_unlock(flags);
+	if (!pending && !owner_broker.initialized && !owner_draining &&
+	    !owner_broker.slots && !owner_broker.payload && !owner_broker.free_indices)
+		error = 0;
+	owner_witness_joining = false;
+unlock:
