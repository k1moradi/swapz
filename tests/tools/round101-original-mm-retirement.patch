@@ -1075,1 +1080,4 @@
-int swapz_mm_trial_scope_revoke(u64 identity)
+/* Sleepable control. Only admission is stopped: readers that already
+ * crossed the capture gate may finish with their real retained debt.
+ * Never hold the control mutex across a grace period. */
+int swapz_mm_trial_scope_stop_capture(u64 identity)
@@ -1082,4 +1090,42 @@
-	/* No producer acquires this control mutex. Unpublish before grace;
-	 * a pre-reference entrant after grace sees NULL and cannot retain.
-	 * An already retained carrier keeps busy set through final release.
-	 */
+	if (swapz_mm_scope_transition) {
+		error = -EBUSY;
+		goto unlock;
+	}
+	if (swapz_mm_scope_capture_stopped) {
+		error = -EALREADY;
+		goto unlock;
+	}
+	swapz_mm_scope_transition = true;
+	rcu_assign_pointer(swapz_mm_capture_scope, NULL);
+	mutex_unlock(&swapz_mm_scope_lock);
+	synchronize_rcu();
+	mutex_lock(&swapz_mm_scope_lock);
+	swapz_mm_scope_capture_stopped = true;
+	swapz_mm_scope_transition = false;
+	error = 0;
+unlock:
+	mutex_unlock(&swapz_mm_scope_lock);
+	return error;
+}
+
+int swapz_mm_trial_scope_revoke(u64 identity)
+{
+	struct file *mapper_file = NULL;
+	int error;
+
+	/* Compatibility: the old revoke also stops capture. The caller must
+	 * already have stopped external ingress and joined area, target map,
+	 * original BIO and terminal callbacks before calling final revoke.
+	 * Busy retained carriers leave ordinary observation published. */
+	error = swapz_mm_trial_scope_stop_capture(identity);
+	if (error && error != -EALREADY)
+		return error;
+
+	mutex_lock(&swapz_mm_scope_lock);
+	error = -ESTALE;
+	if (!swapz_mm_scope_file || identity != swapz_mm_scope_storage.identity)
+		goto unlock;
+	error = -EBUSY;
+	if (swapz_mm_scope_transition || atomic_read_acquire(&swapz_mm_busy))
+		goto unlock;
+	swapz_mm_scope_transition = true;
@@ -1087,0 +1134,1 @@
+		mutex_unlock(&swapz_mm_scope_lock);
@@ -1088,0 +1136,1 @@
+		mutex_lock(&swapz_mm_scope_lock);
@@ -1090,1 +1138,1 @@
-	error = -EBUSY;
+	/* Recheck actual retained debt, never manufacture a zero count. */
@@ -1092,1 +1140,1 @@
-		goto unlock; /* controller joins external debt, then retries */
+		goto finish;
@@ -1094,4 +1142,6 @@
-	if (error)
-		goto unlock; /* quarantine file and storage; never reuse */
-	fput(swapz_mm_scope_file);
-	swapz_mm_scope_file = NULL;
+	if (!error) {
+		mapper_file = swapz_mm_scope_file;
+		swapz_mm_scope_file = NULL;
+	}
+finish:
+	swapz_mm_scope_transition = false;
@@ -1099,0 +1150,2 @@
+	if (mapper_file)
+		fput(mapper_file);
@@ -1102,0 +1155,23 @@
+/* Called by the initial BIO geometry check before the frozen page_io bind.
+ * A successful pre-stop check admits that existing carrier's bind; its
+ * SIO/worker debt must be joined externally before final revoke. */
+bool swapz_mm_trial_scope_bind_permitted(const struct swapz_mm_carrier *carrier)
+{
+	const struct swapz_mm_trial_scope *scope;
+	bool matched = false;
+
+	rcu_read_lock();
+	scope = rcu_dereference(swapz_mm_capture_scope);
+	if (scope && carrier && carrier->scope_identity == scope->identity &&
+	    carrier->bdev == scope->bdev && carrier->cap.broker == scope->broker &&
+	    carrier->cap.session == scope->session && carrier->cap.epoch == scope->table_epoch &&
+	    carrier->lease.broker == scope->broker && carrier->lease.session == scope->session &&
+	    !(carrier->sector & 7) && carrier->sector >= scope->first_sector &&
+	    carrier->sector - scope->first_sector <= scope->sector_count - 8 &&
+	    atomic64_read(&swapz_mm_area_epochs[scope->swap_type]) == scope->area_epoch)
+		matched = true;
+	rcu_read_unlock();
+	return matched;
+}
+EXPORT_SYMBOL_GPL(swapz_mm_trial_scope_bind_permitted);
+
