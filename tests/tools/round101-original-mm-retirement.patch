+/* Query the exact old owner identity, never interpret ESTALE as success.
+ * A native flush joins a worker which may have just dropped the lifecycle
+ * mutex; no lock is held over that wait, and open cannot reuse its slot. */
+int swapz_mm_broker_owner_retired(swapz_u64 session, swapz_u64 epoch)
+{
+	unsigned long flags = 0;
+	int error = -ESTALE;
+	bool pending;
+
+	owner_lock();
+	if (!session || !epoch || session != owner_session || epoch != owner_epoch)
+		goto unlock;
+	if (owner_quarantined) {
+		error = owner_first_error ? owner_first_error : -EIO;
+		goto unlock;
+	}
+	error = -EBUSY;
+	if (owner_witness_joining || owner_broker.initialized ||
+	    owner_retired_session != session || owner_retired_epoch != epoch)
+		goto unlock;
+	owner_witness_joining = true;
+	owner_unlock();
+#ifdef __KERNEL__
+	flush_work(&owner_retry_work);
+#endif
+	owner_lock();
+	gate_lock(flags);
+	pending = owner_retry_pending || owner_retry_armed || owner_entrants || owner_accepting;
+	gate_unlock(flags);
