@@ -973,0 +979,1 @@
+EXPORT_SYMBOL_GPL(swapz_mm_unregister_provider);
@@ -978,0 +985,1 @@
+	struct module *owner;
@@ -983,2 +990,7 @@
-	if (provider)
-		eligible = provider->eligible(bdev, sector, codec, length);
+	if (provider) {
+		owner = READ_ONCE(swapz_mm_provider_owner);
+		if (try_module_get(owner)) {
+			eligible = provider->eligible(bdev, sector, codec, length);
+			module_put(owner);
+		}
+	}
@@ -991,1 +1003,1 @@
-			      struct swapz_ticket_cap *cap)
+			      struct swapz_ticket_cap *cap, struct module **owner_out)
@@ -993,0 +1006,1 @@
+	struct module *owner;
@@ -998,5 +1011,14 @@
-	if (provider && provider->lookup(si->bdev, sector, codec, length, route) &&
-	    route->broker && route->target_session && route->table_epoch &&
-	    route->target_epoch && route->dm_generation)
-		retained = !swapz_ticket_broker_try_get(route->broker,
-			route->target_session, route->table_epoch, cap);
+	if (provider) {
+		owner = READ_ONCE(swapz_mm_provider_owner);
+		if (try_module_get(owner)) {
+			if (provider->lookup(si->bdev, sector, codec, length, route) &&
+			    route->broker && route->target_session && route->table_epoch &&
+			    route->target_epoch && route->dm_generation)
+				retained = !swapz_ticket_broker_try_get(route->broker,
+					route->target_session, route->table_epoch, cap);
+			if (retained)
+				*owner_out = owner; /* transfer to sole carrier */
+			else
+				module_put(owner);
+		}
+	}
@@ -1048,0 +1071,2 @@
+	struct module *owner;
+
@@ -1063,0 +1088,6 @@
+	owner = swapz_mm_carrier.provider_owner;
+	swapz_mm_carrier.provider_owner = NULL;
+	/* Reader grace and both broker puts precede the module put.
+	 * An invariant violation above quarantines the carrier and pin.
+	 */
+	module_put(owner);
@@ -1094,2 +1124,11 @@
-	if (swapz_mm_bio_matches(origin, carrier))
-		error = swapz_ticket_retain(&carrier->lease, out);
+	if (swapz_mm_bio_matches(origin, carrier)) {
+		struct module *owner = carrier->provider_owner;
+
+		if (try_module_get(owner)) {
+			error = swapz_ticket_retain(&carrier->lease, out);
+			if (error)
+				module_put(owner);
+			else
+				out->provider_owner = owner; /* independent candidate pin */
+		}
+	}
@@ -1098,0 +1138,1 @@
+EXPORT_SYMBOL_GPL(swapz_mm_candidate_get);
@@ -1139,1 +1179,1 @@
-			       &route, &carrier->cap))
+			       &route, &carrier->cap, &carrier->provider_owner))
diff --git a/include/linux/swapz_mm_carrier.h b/include/linux/swapz_mm_carrier.h
--- a/include/linux/swapz_mm_carrier.h
+++ b/include/linux/swapz_mm_carrier.h
@@ -10,0 +11,1 @@
+#include <linux/module.h>
@@ -37,1 +38,9 @@
-int swapz_mm_register_provider(const struct swapz_mm_route_provider *);
+/* Bind the real calling module; NULL is reserved for built-in code.
+ * Registration never self-pins. Revoke admission and quiesce external
+ * entrants, unregister, close and drain every ticket/cap before freeing
+ * broker arrays. Registration alone never authorizes a route.
+ */
+int swapz_mm_register_provider(const struct swapz_mm_route_provider *,
+			      struct module *);
+#define swapz_mm_register_provider(provider) \
+	(swapz_mm_register_provider)((provider), THIS_MODULE)
@@ -42,0 +52,1 @@
+	struct module *provider_owner; /* transient pin until deferred release */
