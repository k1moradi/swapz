+static struct module *swapz_mm_provider_owner;
@@ -940,4 +941,3 @@
-/* Registration and unregistration are process-context only, outside target
- * and broker locks. Provider owner pins callback code and broker storage
- * through unregister + RCU grace period; broker capabilities then pin
- * outstanding independent leases. No raw target pointer escapes a callback.
+/* Registration is process-context only, outside target and broker locks.
+ * No registration-time module reference: exit must remain reachable.
+ * Publish owner before provider; clear only after unregister's grace.
@@ -945,1 +945,2 @@
-int swapz_mm_register_provider(const struct swapz_mm_route_provider *provider)
+int (swapz_mm_register_provider)(const struct swapz_mm_route_provider *provider,
+				 struct module *owner)
@@ -954,1 +955,2 @@
-	else
+	else {
+		WRITE_ONCE(swapz_mm_provider_owner, owner);
@@ -955,0 +958,1 @@
+	}
@@ -958,0 +962,1 @@
+EXPORT_SYMBOL_GPL(swapz_mm_register_provider);
@@ -969,0 +974,1 @@
