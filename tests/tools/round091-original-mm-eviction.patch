+static void swapz_mm_preerase(struct zswap_entry *entry, struct folio *folio,
+			     swp_entry_t slot, struct swap_io_ctx *ctx)
+{
+	struct swapz_ticket_key key = {};
+	struct swapz_mm_route route = {};
+	struct swapz_mm_carrier *carrier = &swapz_mm_carrier;
+	struct swap_info_struct *si = __swap_entry_to_info(slot);
+	struct zswap_pool *pool;
+	struct scatterlist sg[2];
+	const void *decoded;
+	sector_t sector;
+	unsigned int nents;
+	size_t copied;
+	u64 area;
+	u8 codec;
+
+	/* Native writeback verified entry == xa_load(tree, offset) under
+	 * locked swapcache folio and decoded exactly PAGE_SIZE. The original
+	 * entry pins pool/handle, and the folio pins slot/area until erase.
+	 * Any uncertainty declines to the normal uncompressed full-page BIO.
+	 */
+	if (PAGE_SIZE != 4096 || folio_order(folio) || !folio_test_locked(folio) ||
+	    !folio_test_swapcache(folio) || folio->swap.val != slot.val ||
+	    entry->swpentry.val != slot.val || !entry->original_cookie ||
+	    !entry->length || entry->length > 4095 || ctx->sio || ctx->original ||
+	    !si || si->ops != &swap_bdev_ops || !si->bdev ||
+	    bdev_is_partition(si->bdev))
+		return;
+	area = atomic64_read(&swapz_mm_area_epochs[swp_type(slot)]);
+	pool = zswap_entry_pool(entry);
+	if (!area || !pool)
+		return;
+	codec = swapz_mm_pool_codec(pool->tfm_name);
+	if (!codec)
+		return;
+	sector = swap_folio_sector(folio);
+	if (!sector || (sector & 7) || atomic_cmpxchg_acquire(&swapz_mm_busy, 0, 1))
+		return;
+	if (!swapz_mm_route_try(si, sector, codec, entry->length,
+			       &route, &carrier->cap))
+		goto decline;
+
+	/* Capture the actual original compressed stream, never recompress.
+	 * Exit the zsmalloc SG pin before hash, broker lock or callbacks.
+	 */
+	zs_obj_read_sg_begin(pool->zs_pool, entry->handle, sg, entry->length);
+	nents = sg_is_last(sg) ? 1 : 2;
+	copied = sg_copy_to_buffer(sg, nents, carrier->scratch, entry->length);
+	zs_obj_read_sg_end(pool->zs_pool, entry->handle);
+	if (copied != entry->length)
+		goto decline;
+	decoded = kmap_local_folio(folio, 0);
+	if (!swapz_mm_eviction_key(&key, entry->original_cookie, area,
+				  swp_offset(slot), swp_type(slot), codec,
+				  entry->length, carrier->scratch, decoded)) {
+		kunmap_local(decoded);
+		goto decline;
+	}
+	kunmap_local(decoded);
+
+	/* Complete source provenance before introducing value-only route IDs.
+	 * Reservation/seal failure releases optional credits and never changes
+	 * the original full-page BIO or its normal completion.
+	 */
+	key.target_session = route.target_session;
+	key.table_epoch = route.table_epoch;
+	key.target_epoch = route.target_epoch;
+	key.logical_page = route.logical_page;
+	key.dm_generation = route.dm_generation;
+	if (swapz_ticket_reserve(carrier->cap.broker, &key, &carrier->lease) ||
+	    swapz_ticket_seal(&carrier->lease, carrier->scratch, key.length))
+		goto decline;
+	carrier->bdev = si->bdev;
+	carrier->page = &folio->page;
+	carrier->sector = sector;
+	ctx->original = carrier;
+	return;
+decline:
+	swapz_mm_drop(&carrier);
+}
