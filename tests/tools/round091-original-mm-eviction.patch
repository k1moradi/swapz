+static u8 swapz_mm_profile(const char *name, const char *driver)
+{
+	if (!strcmp(name, "lz4") && !strcmp(driver, "lz4-scomp"))
+		return SWAPZ_TICKET_LZ4;
+	if (!strcmp(name, "lzo") && !strcmp(driver, "lzo-scomp"))
+		return SWAPZ_TICKET_LZO1X;
+	return 0;
+}
+
+static u8 swapz_mm_pool_codec(const char *name)
+{
+	/* The eligible-store cookie was minted only after the original
+	 * request's exact name+driver check. Its entry holds a pool ref,
+	 * so this pool's compressor name cannot change until eviction.
+	 */
+	if (name && !strcmp(name, "lz4"))
+		return SWAPZ_TICKET_LZ4;
+	if (name && !strcmp(name, "lzo"))
+		return SWAPZ_TICKET_LZO1X;
+	return 0;
+}
+
+static bool swapz_mm_eviction_key(struct swapz_ticket_key *key,
+				 u64 sequence, u64 area, u64 offset, u32 type,
+				 u8 codec, u32 length, const u8 *compressed,
+				 const void *decoded)
+{
+	/* Called only after native full-page decode, selected route,
+	 * exact SG copy and exclusive source/folio lifetime checks.
+	 * No hash on stores, unsupported routes or failed source proof.
+	 */
+	if (!key || !sequence || !area || !compressed || !decoded ||
+	    !length || length > 4095 ||
+	    (codec != SWAPZ_TICKET_LZ4 && codec != SWAPZ_TICKET_LZO1X))
+		return false;
+	*key = (struct swapz_ticket_key){
+		.area_epoch = area, .store_sequence = sequence, .slot_offset = offset,
+		.swap_type = type, .length = length, .decoded_length = 4096,
+		.representation = SWAPZ_TICKET_ORIGINAL, .codec = codec,
+		.version = 1
+	};
+	key->crc = swapz_crc32c_bytes(compressed, length);
+	sha256(decoded, 4096, key->sha256);
+	return true;
+}
