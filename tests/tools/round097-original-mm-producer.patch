+/* No current runtime scope or publication mechanism. The hard-off gate
+ * below also protects ordinary store and eviction from speculative work.
+ */
+static const struct swapz_mm_trial_scope swapz_mm_scope;
+
+static bool swapz_mm_scope_matches(const struct swapz_mm_trial_scope *scope,
+	struct block_device *bdev, sector_t sector, u64 area, u32 type,
+	u8 codec, u32 length, const struct swapz_mm_route *route)
+{
+	return scope && scope->identity && scope->bdev && bdev == scope->bdev &&
+	       scope->broker && scope->session && scope->table_epoch &&
+	       scope->target_epoch && area && area == scope->area_epoch &&
+	       type == scope->swap_type && scope->first_sector &&
+	       !(scope->first_sector & 7) && scope->sector_count >= 8 &&
+	       scope->sector_count <= (sector_t)-1 - scope->first_sector &&
+	       !(scope->sector_count & 7) && sector >= scope->first_sector &&
+	       !(sector & 7) && sector - scope->first_sector <= scope->sector_count - 8 &&
+	       length && length <= 3568 &&
+	       (codec == SWAPZ_TICKET_LZ4 || codec == SWAPZ_TICKET_LZO1X) &&
+	       route && route->broker == scope->broker &&
+	       route->target_session == scope->session &&
+	       route->table_epoch == scope->table_epoch &&
+	       route->target_epoch == scope->target_epoch &&
+	       route->logical_page == sector / 8 && route->dm_generation &&
+	       route->dm_generation <= U32_MAX && route->logical_page <= U32_MAX;
+}
