+#endif
@@ -1148,0 +1280,27 @@
+#ifdef SWAPZ_NATIVE_OBSERVATION_ADAPTER
+bool swapz_mm_candidate_observation(const struct bio *origin,
+	const struct swapz_ticket_ref *ref, struct swapz_observation_record *out)
+{
+	const struct swapz_mm_carrier *carrier;
+	bool matched = false;
+
+	if (!origin || !ref || !ref->broker || !out ||
+	    !swapz_trial_observation_active())
+		return false;
+	rcu_read_lock();
+	carrier = rcu_dereference(origin->bi_swapz_original);
+	if (swapz_mm_bio_matches(origin, carrier) &&
+	    ref->broker == carrier->lease.broker &&
+	    ref->session == carrier->lease.session &&
+	    ref->index == carrier->lease.index &&
+	    ref->generation == carrier->lease.generation &&
+	    carrier->observation.operation && carrier->observation.original) {
+		*out = carrier->observation;
+		matched = true;
+	}
+	rcu_read_unlock();
+	return matched;
+}
+EXPORT_SYMBOL_GPL(swapz_mm_candidate_observation);
+#endif
