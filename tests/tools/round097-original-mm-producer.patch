+#ifdef SWAPZ_NATIVE_OBSERVATION_ADAPTER
+static void swapz_mm_observation_capture(struct swapz_mm_carrier *carrier,
+	const struct swapz_ticket_key *key)
+{
+	struct swapz_observation_record *record = &carrier->observation;
+	u64 operation;
+
+	if (!swapz_trial_observation_active())
+		return;
+	operation = swapz_trial_observation_mint();
+	if (!operation)
+		return;
+	*record = (struct swapz_observation_record){
+		.operation = operation, .operation_kind = SWAPZ_OBS_TYPED_WRITE,
+		.event = SWAPZ_OBS_CAPTURE, .slot = key->slot_offset,
+		.area_epoch = key->area_epoch, .store = key->store_sequence,
+		.logical = (u32)key->logical_page, .generation = (u32)key->dm_generation,
+		.swap_type = key->swap_type, .compressed_length = key->length,
+		.decoded_length = key->decoded_length, .codec = key->codec,
+		.tag = key->representation, .version = key->version,
+		.dictionary = key->dictionary
+	};
+	sha256(carrier->scratch, key->length, record->compressed_sha256);
+	memcpy(record->page_sha256, key->sha256, sizeof(record->page_sha256));
+	if (!swapz_trial_observation_append(record)) {
+		record->operation = 0;
+		return;
+	}
+	/* Actual native decompression was completed before preerase.
+	 * This is an observed earlier prerequisite, not a timestamp claim. */
+	{
+		struct swapz_observation_record preparation = *record;
+
+		preparation.event = SWAPZ_OBS_PREPARATION;
+		preparation.flags = 1;
+		swapz_trial_observation_append(&preparation);
+	}
+}
+
+void swapz_mm_observation_bind(struct swapz_mm_carrier *carrier)
+{
+	struct swapz_observation_record *record;
+
+	if (!carrier || !swapz_trial_observation_active())
+		return;
+	record = &carrier->observation;
+	if (!record->operation || record->original)
+		return;
+	record->original = swapz_trial_observation_mint();
+	if (!record->original)
+		return;
+	record->event = SWAPZ_OBS_BIND;
+	swapz_trial_observation_append(record);
+}
+
+void swapz_mm_observation_endio(const struct swapz_mm_carrier *carrier, u32 status)
+{
+	struct swapz_observation_record record;
+
+	if (!carrier || !swapz_trial_observation_active() ||
+	    !carrier->observation.operation || !carrier->observation.original)
+		return;
+	record = carrier->observation;
+	record.event = SWAPZ_OBS_UPPER_ENDIO;
+	record.status = status;
+	swapz_trial_observation_append(&record);
+}
+
+static void swapz_mm_observation_release(struct swapz_mm_carrier *carrier)
+{
+	struct swapz_observation_record record;
+
+	if (carrier->observation.operation && swapz_trial_observation_active()) {
+		record = carrier->observation;
+		/* No original BIO publication: actual optional capture drop.
+		 * A bound but unaccepted operation stays incomplete, never
+		 * invent a target refusal or ACK to satisfy the parser. */
+		if (!record.original) {
+			record.event = SWAPZ_OBS_CAPTURE_DROP;
+			record.status = EOPNOTSUPP;
+			swapz_trial_observation_append(&record);
+		}
+		record.event = SWAPZ_OBS_CARRIER_RELEASE;
+		record.status = 0;
+		swapz_trial_observation_append(&record);
+	}
+	/* Inactive path avoids copying/clearing the full record. */
+	carrier->observation.operation = 0;
+	carrier->observation.original = 0;
+}
+#endif
+
