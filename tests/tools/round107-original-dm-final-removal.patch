+#ifdef SWAPZ_ROUND107_FINAL_REMOVAL_TEST
+static bool dm_swapz_final_drained(struct mapped_device *md)
+{
+	lockdep_assert_held(&md->suspend_lock);
+	return dm_suspended_md(md) && !dm_suspended_internally_md(md) &&
+	       test_bit(DMF_BLOCK_IO_FOR_SUSPEND, &md->flags) &&
+	       !test_bit(DMF_POST_SUSPENDING, &md->flags) &&
+	       !dm_request_based(md) && !dm_in_flight_bios(md) &&
+	       !dm_swapz_final_pending(md);
+}
+
+/* Private cold seam, deliberately no caller under AUTH0. Only an
+ * independently already-admitted owner with live md/table/target lifetime,
+ * an immutable retained key and explicit final-removal intent may call.
+ * This is NOT an authorization entry and never suspends, opens, removes,
+ * or invokes normal dtr. A successful result means deletion eligibility
+ * at this check, not final close or destruction.
+ *
+ * Hold the native SRCU table borrow and our own md holder over the
+ * synchronous frozen controller callback. Release suspend_lock and
+ * _minor_lock first; controller may detach/put its own and MM/target files.
+ * Release our SRCU borrow before reacquiring suspend_lock, so a concurrent
+ * table synchronization never waits on a reader waiting for that lock.
+ * The reservation fences swap/resume/delete until the final check.
+ * Only EBUSY from the callback permits exact-key retry. After callback
+ * success, waiting for actual opens to close must not call it again.
+ */
+static __used noinline int dm_swapz_retire_final_table(struct mapped_device *md,
+		struct dm_table *expected_table,
+		const struct swapz_trial_retained_scope *retained)
+{
+	struct swapz_trial_retained_scope key;
+	struct dm_table *table;
+	struct dm_target *target;
+	bool invoke = true, release_holder = false, drained, same_table;
+	int error, srcu_idx;
+
+	if (!md || !expected_table || !retained)
+		return -EINVAL;
+	key = *retained;
+	if (!key.identity || !key.session || !key.epoch || !key.target_epoch ||
+	    !key.registration_epoch)
+		return -EINVAL;
+
+	lockdep_assert_not_held(&_minor_lock);
+	lockdep_assert_not_held(&md->suspend_lock);
+	mutex_lock(&md->suspend_lock);
+	table = dm_get_live_table(md, &srcu_idx);
+	error = -ESTALE;
+	if (table != expected_table || dm_table_get_md(table) != md ||
+	    table->num_targets != 1)
+		goto unlock_table;
+	target = dm_table_get_target(table, 0);
+	if (!target || target->table != table || !target->type ||
+	    strcmp(target->type->name, "swapz"))
+		goto unlock_table;
+	error = -EBUSY;
+	if (!dm_swapz_final_drained(md))
+		goto unlock_table;
+
+	spin_lock(&_minor_lock);
+	if (test_bit(DMF_FREEING, &md->flags) || dm_deleting_md(md))
+		goto unlock_minor;
+	if (dm_swapz_final.md) {
+		error = -ESTALE;
+		if (dm_swapz_final.md != md || dm_swapz_final.table != table ||
+		    !dm_swapz_final_key_matches(&key))
+			goto unlock_minor;
+		error = -EBUSY;
+		if (dm_swapz_final.phase == DM_SWAPZ_FINAL_RUNNING)
+			goto unlock_minor;
+		if (dm_swapz_final.phase == DM_SWAPZ_FINAL_QUARANTINED) {
+			error = dm_swapz_final.first_error;
+			goto unlock_minor;
+		}
+		error = -EALREADY;
+		if (dm_swapz_final.phase == DM_SWAPZ_FINAL_READY)
+			goto unlock_minor;
+		invoke = dm_swapz_final.phase == DM_SWAPZ_FINAL_RETRY;
+		if (!invoke && dm_swapz_final.phase != DM_SWAPZ_FINAL_RETIRED)
+			goto unlock_minor;
+	} else {
+		error = -EALREADY;
+		if (dm_swapz_final.phase != DM_SWAPZ_FINAL_IDLE)
+			goto unlock_minor;
+		/* dm_get is under _minor_lock, after the freeing/deleting check.
+		 * The extra holder is independent of all open mapper files. */
+		dm_get(md);
+		dm_swapz_final.md = md;
+		dm_swapz_final.table = table;
+		dm_swapz_final.key = key;
+	}
+	dm_swapz_final.phase = DM_SWAPZ_FINAL_RUNNING;
+	spin_unlock(&_minor_lock);
+	mutex_unlock(&md->suspend_lock);
+
+	error = invoke ? swapz_trial_controller_retire_registered(target, &key) : 0;
+	dm_put_live_table(md, srcu_idx);
+
+	mutex_lock(&md->suspend_lock);
+	same_table = rcu_dereference_protected(md->map,
+				lockdep_is_held(&md->suspend_lock)) == expected_table;
+	drained = dm_swapz_final_drained(md);
+	spin_lock(&_minor_lock);
+	/* The exact reservation must still be ours. Never accept a stale
+	 * callback or release a holder owned by another transaction. */
+	if (WARN_ON_ONCE(dm_swapz_final.md != md ||
+			 dm_swapz_final.table != expected_table ||
+			 dm_swapz_final.phase != DM_SWAPZ_FINAL_RUNNING ||
+			 !dm_swapz_final_key_matches(&key))) {
+		if (!error)
+			error = -ESTALE;
+		goto unlock_result;
+	}
+	if (!same_table || test_bit(DMF_FREEING, &md->flags) ||
+	    dm_deleting_md(md)) {
+		if (!error || error == -EBUSY)
+			error = -ESTALE;
+	}
+	if (error && error != -EBUSY) {
+		if (!dm_swapz_final.first_error)
+			dm_swapz_final.first_error = error;
+		dm_swapz_final.phase = DM_SWAPZ_FINAL_QUARANTINED;
+	} else if (error) {
+		dm_swapz_final.phase = DM_SWAPZ_FINAL_RETRY;
+	} else if (!drained || dm_open_count(md) || dm_swapz_final_pending(md)) {
+		/* fput may be asynchronous. Preserve the reservation until
+		 * the real native open count is zero, never force it. */
+		dm_swapz_final.phase = DM_SWAPZ_FINAL_RETIRED;
+		error = -EBUSY;
+	} else {
+		dm_swapz_final.phase = DM_SWAPZ_FINAL_READY;
+		release_holder = true;
+	}
+unlock_result:
+	spin_unlock(&_minor_lock);
+	mutex_unlock(&md->suspend_lock);
+	if (release_holder)
+		dm_put(md);
+	return error;
+
+unlock_minor:
+	spin_unlock(&_minor_lock);
+unlock_table:
+	mutex_unlock(&md->suspend_lock);
+	dm_put_live_table(md, srcu_idx);
+	return error;
+}
+#endif
+
+/*
+ * Swap in a new table, returning the old one for the caller to destroy.
+ */
