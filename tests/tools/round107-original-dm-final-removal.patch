+#ifdef SWAPZ_ROUND107_FINAL_REMOVAL_TEST
+/* One private, built-in trial owner. _minor_lock protects every field.
+ * The reservation owns one md holder until READY; the live table cannot
+ * be swapped or destroyed while reserved. No target pointer is retained.
+ * A terminal failure quarantines that ownership, not ordinary devices.
+ */
+enum dm_swapz_final_phase {
+	DM_SWAPZ_FINAL_IDLE,
+	DM_SWAPZ_FINAL_RUNNING,
+	DM_SWAPZ_FINAL_RETRY,
+	DM_SWAPZ_FINAL_RETIRED,
+	DM_SWAPZ_FINAL_READY,
+	DM_SWAPZ_FINAL_QUARANTINED,
+	DM_SWAPZ_FINAL_DELETING,
+	DM_SWAPZ_FINAL_DESTROYED,
+};
+
+static struct {
+	struct mapped_device *md;
+	struct dm_table *table;
+	struct swapz_trial_retained_scope key;
+	enum dm_swapz_final_phase phase;
+	int first_error;
+} dm_swapz_final;
+
+static bool dm_swapz_final_key_matches(const struct swapz_trial_retained_scope *key)
+{
+	lockdep_assert_held(&_minor_lock);
+	return key->identity == dm_swapz_final.key.identity &&
+	       key->session == dm_swapz_final.key.session &&
+	       key->epoch == dm_swapz_final.key.epoch &&
+	       key->target_epoch == dm_swapz_final.key.target_epoch &&
+	       key->registration_epoch == dm_swapz_final.key.registration_epoch;
+}
+
+/* suspend_lock -> _minor_lock; no reverse nesting. Native deferred-list
+ * mutation holds only deferred_lock here, never _minor_lock.
+ */
+static bool dm_swapz_final_fenced(struct mapped_device *md)
+{
+	bool fenced;
+
+	lockdep_assert_held(&md->suspend_lock);
+	spin_lock(&_minor_lock);
+	fenced = dm_swapz_final.md == md;
+	spin_unlock(&_minor_lock);
+	return fenced;
+}
+
+static bool dm_swapz_final_pending(struct mapped_device *md)
+{
+	unsigned long flags;
+	bool pending;
+
+	spin_lock_irqsave(&md->deferred_lock, flags);
+	pending = !bio_list_empty(&md->deferred) || md->requeue_list;
+	spin_unlock_irqrestore(&md->deferred_lock, flags);
+	return pending;
+}
+#endif
+
+static void do_deferred_remove(struct work_struct *w);
