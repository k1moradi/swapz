diff --git a/include/linux/swapz_mm_carrier.h b/include/linux/swapz_mm_carrier.h
index b930f6f04a21d3f2b8b6f2279e028a94cfc99502..bd88db905e5009e0e6161cad1d09b6d33bde2560 100644
--- a/include/linux/swapz_mm_carrier.h
+++ b/include/linux/swapz_mm_carrier.h
@@ -123,2 +123,22 @@
-int swapz_mm_trial_scope_join_external(u64 identity, u64 session,
-	u64 table_epoch, u64 target_epoch);
+int swapz_mm_trial_scope_join_external(u64 identity, u64 session,
+	u64 table_epoch, u64 target_epoch);
+
+/* Internal process-context MM witnesses; not activation or target proof.
+ * Snapshot counts actual retained tickets including detached callbacks.
+ * Output is unchanged on error; no clean status may be inferred from it
+ * unless capture stopped, area retired, terminal closed/joined and no fault. */
+struct swapz_mm_trial_terminal_snapshot {
+	u64 area_epoch;
+	unsigned int mm_callbacks, dm_callbacks, dm_entrants;
+	bool carrier_busy, capture_stopped, area_retired;
+	bool terminal_closed, terminal_joined, fault, files_detached;
+};
+int swapz_mm_trial_scope_terminal_snapshot(u64 identity, u64 session,
+	u64 table_epoch, u64 target_epoch,
+	struct swapz_mm_trial_terminal_snapshot *snapshot);
+/* After actual MM join, relinquish MM's own open files, keeping broker cap
+ * and exact identity until final revoke. Caller must not hold controller,
+ * target or DM locks; independently drop its own refs and prove table dtr.
+ * Does not prove all device openers are gone. Exact idempotent while retained. */
+int swapz_mm_trial_scope_detach_files(u64 identity, u64 session,
+	u64 table_epoch, u64 target_epoch);
