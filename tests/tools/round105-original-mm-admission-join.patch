diff --git a/mm/swapz-trial-terminal.inc b/mm/swapz-trial-terminal.inc
index b0acebd01b19ea0900300a609ffbf9448aec51d3..697f3c9fc51738fedabc58cefc4eee6fddc8358c 100644
--- a/mm/swapz-trial-terminal.inc
+++ b/mm/swapz-trial-terminal.inc
@@ -9,0 +10,18 @@
+/* Protected by the cold scope mutex. Detached retains only the exact
+ * scalar identity and independent broker cap, not an open mapper file. */
+static bool swapz_mm_scope_files_detached;
+
+static bool swapz_mm_trial_scope_retained(u64 identity)
+{
+	return identity && identity == swapz_mm_scope_storage.identity &&
+	       (swapz_mm_scope_file || swapz_mm_scope_files_detached);
+}
+
+static bool swapz_mm_trial_scope_retained_exact(u64 identity, u64 session,
+	u64 table_epoch, u64 target_epoch)
+{
+	return swapz_mm_trial_scope_retained(identity) &&
+	       session == swapz_mm_scope_storage.session &&
+	       table_epoch == swapz_mm_scope_storage.table_epoch &&
+	       target_epoch == swapz_mm_scope_storage.target_epoch;
+}
@@ -344,4 +362,1 @@
-	if (!swapz_mm_scope_file || identity != swapz_mm_scope_storage.identity ||
-	    session != swapz_mm_scope_storage.session ||
-	    table_epoch != swapz_mm_scope_storage.table_epoch ||
-	    target_epoch != swapz_mm_scope_storage.target_epoch)
+	if (!swapz_mm_trial_scope_retained_exact(identity, session, table_epoch, target_epoch))
@@ -375,0 +391,122 @@
+	return error;
+}
+
+/* Cold, exact, read-only accounting. A detached object still owes its
+ * ticket until callback return; count tickets, not non-NULL owner pointers.
+ * Snapshot is not a target/provider/broker join or a CLEANUP record. */
+int swapz_mm_trial_scope_terminal_snapshot(u64 identity, u64 session,
+	u64 table_epoch, u64 target_epoch,
+	struct swapz_mm_trial_terminal_snapshot *snapshot)
+{
+	struct swapz_mm_trial_terminal_snapshot observed = {};
+	unsigned long flags;
+	unsigned int index;
+	int error = -ESTALE;
+
+	if (!snapshot)
+		return -EINVAL;
+	mutex_lock(&swapz_mm_scope_lock);
+	if (!swapz_mm_trial_scope_retained_exact(identity, session, table_epoch, target_epoch))
+		goto unlock;
+	error = -EBUSY;
+	if (swapz_mm_scope_transition)
+		goto unlock;
+	spin_lock_irqsave(&swapz_mm_terminal_gate, flags);
+	observed.area_epoch = swapz_mm_scope_storage.area_epoch;
+	observed.capture_stopped = swapz_mm_scope_capture_stopped;
+	observed.area_retired = swapz_mm_area_drained;
+	observed.terminal_closed = swapz_mm_terminal_closed;
+	observed.terminal_joined = swapz_mm_terminal_joined;
+	observed.carrier_busy = atomic_read_acquire(&swapz_mm_busy) != 0;
+	observed.files_detached = swapz_mm_scope_files_detached;
+	for (index = 0; index < SWAPZ_TRIAL_DEBT_SLOTS; ++index) {
+		const struct swapz_trial_debt_slot *slot = &swapz_mm_terminal_debt.slots[index];
+
+		if (!slot->ticket)
+			continue;
+		switch (slot->kind) {
+		case SWAPZ_TRIAL_MM:
+			++observed.mm_callbacks;
+			break;
+		case SWAPZ_TRIAL_DM:
+			++observed.dm_callbacks;
+			break;
+		case SWAPZ_TRIAL_ENTRY:
+			++observed.dm_entrants;
+			break;
+		default:
+			swapz_mm_terminal_debt.fault = true;
+		}
+	}
+	if (observed.mm_callbacks + observed.dm_callbacks + observed.dm_entrants !=
+	    swapz_mm_terminal_debt.count)
+		swapz_mm_terminal_debt.fault = true;
+	observed.fault = swapz_mm_terminal_debt.fault;
+	spin_unlock_irqrestore(&swapz_mm_terminal_gate, flags);
+	*snapshot = observed;
+	error = 0;
+unlock:
+	mutex_unlock(&swapz_mm_scope_lock);
+	return error;
+}
+
+/* Drop only MM-owned open-file refs, not the independent broker cap.
+ * The controller must release its own mapper/table refs separately, outside
+ * controller/target/DM locks, and still prove actual final table retirement.
+ * fput relinquishes ownership; it does not certify synchronous final close.
+ * A transition remains busy across grace and both puts. No raw bdev pointer
+ * is retained after the observation publication has been joined. */
+int swapz_mm_trial_scope_detach_files(u64 identity, u64 session,
+	u64 table_epoch, u64 target_epoch)
+{
+	struct file *mapper_file, *area_file;
+	unsigned long flags;
+	int error = -ESTALE;
+
+	mutex_lock(&swapz_mm_scope_lock);
+	if (!swapz_mm_trial_scope_retained_exact(identity, session, table_epoch, target_epoch))
+		goto unlock;
+	error = -EBUSY;
+	if (swapz_mm_scope_transition || !swapz_mm_scope_capture_stopped)
+		goto unlock;
+	spin_lock_irqsave(&swapz_mm_terminal_gate, flags);
+	if (swapz_mm_terminal_debt.fault)
+		error = -EUCLEAN;
+	else if (swapz_mm_terminal_joined && swapz_mm_terminal_ready()) {
+		if (swapz_mm_scope_files_detached) {
+			error = 0;
+		} else if (swapz_mm_scope_file && swapz_mm_area_file) {
+			swapz_mm_scope_transition = true;
+			rcu_assign_pointer(swapz_mm_scope, NULL);
+			error = 0;
+		} else {
+			error = -EUCLEAN;
+		}
+	}
+	spin_unlock_irqrestore(&swapz_mm_terminal_gate, flags);
+	if (error || swapz_mm_scope_files_detached)
+		goto unlock;
+	mutex_unlock(&swapz_mm_scope_lock);
+	synchronize_rcu();
+	mutex_lock(&swapz_mm_scope_lock);
+	spin_lock_irqsave(&swapz_mm_terminal_gate, flags);
+	if (!swapz_mm_terminal_joined || !swapz_mm_terminal_ready()) {
+		error = swapz_mm_terminal_debt.fault ? -EUCLEAN : -EBUSY;
+		spin_unlock_irqrestore(&swapz_mm_terminal_gate, flags);
+		goto finish;
+	}
+	mapper_file = swapz_mm_scope_file;
+	area_file = swapz_mm_area_file;
+	swapz_mm_scope_file = NULL;
+	swapz_mm_area_file = NULL;
+	swapz_mm_scope_storage.bdev = NULL;
+	swapz_mm_scope_files_detached = true;
+	spin_unlock_irqrestore(&swapz_mm_terminal_gate, flags);
+	mutex_unlock(&swapz_mm_scope_lock);
+	fput(area_file);
+	fput(mapper_file);
+	mutex_lock(&swapz_mm_scope_lock);
+finish:
+	swapz_mm_scope_transition = false;
+unlock:
+	mutex_unlock(&swapz_mm_scope_lock);
