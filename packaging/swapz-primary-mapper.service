[Unit]
Description=Own the primary swapz mapper and swap lifecycle
DefaultDependencies=no
Requires=-.mount
# Persistent qualification evidence is read from /var/lib; mutable lifecycle
# ownership is kept only in RuntimeDirectory=/run/swapz below.
# Legacy-named persistent path: source-bound qualification evidence only.
# Lifecycle ownership stays under /run/swapz; mapping/extent/CRC/GC authority stays in RAM.
RequiresMountsFor=/var/lib/swapz/physical-recovery
After=-.mount systemd-modules-load.service dev-mapper-swapz\x2dprimary.swap
Before=swap.target shutdown.target
Conflicts=shutdown.target
# swapzctl primary start performs swapon; primary stop performs swapoff.
# Do not start the passive .swap unit as a second activation job. This service
# is WantedBy=swap.target and must stop *before* the observed .swap unit so
# that the manager owns the only swapoff and same-boot ownership transition.
RefuseManualStart=yes
RefuseManualStop=yes

[Service]
Type=oneshot
RemainAfterExit=yes
# systemd owns the volatile authorization directory for the entire mapper
# service lifetime. The cross-boot preflight writes the only enable token.
RuntimeDirectory=swapz
RuntimeDirectoryMode=0700
# Refuse any mutating recovery/start transaction while a hibernation-capable
# systemd unit is active or activating. The hibernation side independently
# refuses the entire configured-primary interval, closing both race directions.
ExecStartPre=@SWAPZ_SBINDIR@/swapz-primary-runtime-health activation-guard
# A failed same-boot recovery is intentionally followed by prepare: prepare can
# reconcile volatile READY/COMPLETE ownership records, but unsafe live state
# still blocks. No raw swap header is restored or reformatted.
ExecStartPre=@SWAPZ_SBINDIR@/swapz-primary-boot-verify preflight
ExecStartPre=-@SWAPZ_SBINDIR@/swapzctl primary recover
ExecStartPre=@SWAPZ_SBINDIR@/swapzctl primary prepare
ExecStart=@SWAPZ_SBINDIR@/swapzctl primary start
ExecStop=@SWAPZ_SBINDIR@/swapzctl primary stop
# The post-stop observer is read-only. Its failure is ignored so it can report
# a retained active swap/mapper after a native stop failure without masking or
# retrying the native manager's authoritative stop result.
ExecStopPost=-@SWAPZ_SBINDIR@/swapz-primary-runtime-health stop-observe
TimeoutStartSec=120s
TimeoutStopSec=120s
UMask=0077
# Lifecycle operations make direct DM ioctls, finit_module and swapon/swapoff.
# Keep CAP_SYS_ADMIN/CAP_SYS_MODULE and /dev available. CAP_SYS_PTRACE is also
# required: the native manager scans /proc/<pid>/mountinfo across users and
# namespaces before raw writes, including on procfs mounted with hidepid.
# Exclude unrelated privileges rather than guessing a tighter untested allowlist.
CapabilityBoundingSet=~CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_SYS_BOOT CAP_SYS_TIME CAP_SYSLOG CAP_MAC_ADMIN CAP_MAC_OVERRIDE CAP_BPF CAP_PERFMON CAP_CHECKPOINT_RESTORE
NoNewPrivileges=yes
# Full (rather than strict) intentionally keeps /run/lock/swapz and /run/swapz
# writable for ownership, while /var/lib/swapz retains qualification evidence.
# udev coordination remains available to the lifecycle owner.
ProtectSystem=full
ProtectHome=yes
# PrivateTmp=yes implicitly orders tmp.mount ahead of this early swap owner;
# tmp.mount can wait for swap.target, creating an unfixable boot ordering cycle.
# This is intentionally not enabled on the mapper (unlike the later observers).
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
# CAP_SYS_ADMIN is required for DM/swap ownership, so deny mount namespace
# mutation explicitly; module and swap syscalls remain available to the owner.
SystemCallFilter=~@mount
SystemCallErrorNumber=EPERM
# Do not bind-mount the package journal read-only: the native manager checks
# its mount ID against its parent and refuses mount substitution. The journal
# is only inspected by this service; completion belongs to the installer.

[Install]
WantedBy=swap.target
