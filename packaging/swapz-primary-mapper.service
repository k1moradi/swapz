[Unit]
Description=Prepare the swapz primary swap mapper
DefaultDependencies=no
Requires=-.mount
After=-.mount systemd-modules-load.service
Before=dev-mapper-swapz\x2dprimary.swap shutdown.target
Before=dev-disk-by\x2duuid-728b4c06\x2d44b0\x2d46ee\x2d91ec\x2d560ab1bad358.swap
Conflicts=dev-disk-by\x2duuid-728b4c06\x2d44b0\x2d46ee\x2d91ec\x2d560ab1bad358.swap
Conflicts=shutdown.target
PartOf=dev-mapper-swapz\x2dprimary.swap
RefuseManualStart=yes
RefuseManualStop=yes
ConditionPathExists=/var/lib/swapz/physical-recovery/primary-state.json

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=@SWAPZ_SBINDIR@/swapzctl primary start
ExecStop=@SWAPZ_SBINDIR@/swapzctl primary stop
TimeoutStartSec=120s
TimeoutStopSec=infinity
UMask=0077
