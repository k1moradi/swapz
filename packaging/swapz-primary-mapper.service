[Unit]
Description=Own the primary swapz mapper and swap lifecycle
DefaultDependencies=no
Requires=-.mount
RequiresMountsFor=/var/lib/swapz/physical-recovery
After=-.mount systemd-modules-load.service dev-mapper-swapz\x2dprimary.swap
Before=swap.target shutdown.target
Conflicts=shutdown.target
# swapzctl primary start performs swapon; primary stop performs swapoff.
# Do not start the passive .swap unit as a second activation job. This service
# is WantedBy=swap.target and must stop *before* the observed .swap unit so
# that the manager owns the only swapoff and durable ownership transition.
RefuseManualStart=yes
RefuseManualStop=yes

[Service]
Type=oneshot
RemainAfterExit=yes
# systemd owns the volatile authorization directory for the entire mapper
# service lifetime. The cross-boot preflight writes the only enable token.
RuntimeDirectory=swapz
RuntimeDirectoryMode=0700
# Refuse any mutating recovery/start transaction while a hibernation-capable
# systemd unit is active or activating. The hibernation side independently
# refuses the entire configured-primary interval, closing both race directions.
ExecStartPre=@SWAPZ_SBINDIR@/swapz-primary-runtime-health activation-guard
# A failed recovery is intentionally followed by prepare: prepare can reconcile
# metadata-only READY/COMPLETE records, but any unsafe stale state still blocks.
ExecStartPre=@SWAPZ_SBINDIR@/swapz-primary-boot-verify preflight
ExecStartPre=-@SWAPZ_SBINDIR@/swapzctl primary recover
ExecStartPre=@SWAPZ_SBINDIR@/swapzctl primary prepare
ExecStart=@SWAPZ_SBINDIR@/swapzctl primary start
ExecStop=@SWAPZ_SBINDIR@/swapzctl primary stop
# The post-stop observer is read-only. Its failure is ignored so it can report
# a retained active swap/mapper after a native stop failure without masking or
# retrying the native manager's authoritative stop result.
ExecStopPost=-@SWAPZ_SBINDIR@/swapz-primary-runtime-health stop-observe
TimeoutStartSec=120s
TimeoutStopSec=120s
UMask=0077
# Lifecycle operations make direct DM ioctls, finit_module and swapon/swapoff.
# Keep CAP_SYS_ADMIN/CAP_SYS_MODULE and /dev available; these exclusions only
# remove unrelated privileges, rather than guessing an untested allowlist.
CapabilityBoundingSet=~CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_SYS_PTRACE CAP_SYS_BOOT CAP_SYS_TIME CAP_SYSLOG CAP_MAC_ADMIN CAP_MAC_OVERRIDE CAP_BPF CAP_PERFMON CAP_CHECKPOINT_RESTORE
NoNewPrivileges=yes
# Full (rather than strict) intentionally keeps /run/lock/swapz, /run/swapz,
# udev coordination and durable /var/lib/swapz recovery writable for the owner.
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
# A lifecycle transaction may inspect an incomplete package journal but must
# not repair or remove it; the package installer owns journal completion.
ReadOnlyPaths=-/var/lib/swapz-package-transactions

[Install]
WantedBy=swap.target
