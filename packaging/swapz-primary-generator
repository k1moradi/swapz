#!/bin/sh
# Emit selected-target ordering for the disabled primary-swap systemd units.
set -eu
umask 077

fail()
{
	failure_status=$1
	failure_phase=$2
	failure_source=$3
	failure_validation=$4
	failure_withheld=$5
	printf 'swapz-primary-generator: phase=%s source=%s validation=%s status=%s withheld=%s\n' \
		"$failure_phase" "$failure_source" "$failure_validation" \
		"$failure_status" "$failure_withheld" >&2
	exit "$failure_status"
}

if [ "$#" -ne 3 ]; then
	fail 2 arguments generator-output count mapper-active-job
fi

normal_dir=$1
early_dir=$2
late_dir=$3
safe_output_directory()
{
	# Systemd supplies absolute paths. Refuse a symlinked ancestor or a
	# lexical alias rather than writing through an unexpected directory.
	current_directory=$1
	while [ "$current_directory" != / ]; do
		case "$current_directory" in
		*/.|*/..) return 1 ;;
		esac
		[ -d "$current_directory" ] && [ ! -L "$current_directory" ] || return 1
		current_directory=${current_directory%/*}
		[ -n "$current_directory" ] || current_directory=/
	done
}
for output_dir in "$normal_dir" "$early_dir" "$late_dir"; do
	case "$output_dir" in
	/*) ;;
	*) fail 2 arguments generator-output absolute-path mapper-active-job ;;
	esac
	if ! safe_output_directory "$output_dir"; then
		fail 2 arguments generator-output unsafe-output-directory mapper-active-job
	fi
done
if [ "$normal_dir" = "$early_dir" ] || [ "$normal_dir" = "$late_dir" ] ||
	[ "$early_dir" = "$late_dir" ] ||
	[ "$normal_dir" -ef "$early_dir" ] || [ "$normal_dir" -ef "$late_dir" ] ||
	[ "$early_dir" -ef "$late_dir" ]; then
	fail 2 arguments generator-output duplicate-output-directory mapper-active-job
fi

# The mask is the publication barrier: enabled swap.target wants may already
# exist, but a failed regeneration must never expose an executable mapper job.
# generator.early outranks even administrator /etc units; a normal-dir mask
# cannot reliably block an enabled mapper on selector/admission failure.
mapper_unit=$early_dir/swapz-primary-mapper.service
mask_temporary=$early_dir/.swapz-primary-mask.$$
mapper_mask_is_active()
{
	[ -L "$mapper_unit" ] || return 1
	if active_mask_destination=$(readlink -- "$mapper_unit"); then
		[ "$active_mask_destination" = /dev/null ]
	else
		return 1
	fi
}
replace_with_verified_mask()
{
	# The early-priority mapper name is reserved for the safety barrier.
	# Replace a substituted symlink without following its foreign target
	# even if a prior rm claimed success without consuming the pathname.
	if ln -sfnT -- /dev/null "$mapper_unit"; then :; else
		return $?
	fi
	mapper_mask_is_active
}
install_verified_mask()
{
	requested_mask_validation=$1
	if ln -s /dev/null "$mask_temporary"; then :; else
		fail "$?" mask generator-output create-mask mapper-active-job
	fi
	# A rename can report success without moving (or fail after moving).
	# Verify the early barrier before staging anything activation-capable.
	mask_status=0
	if mv -fT -- "$mask_temporary" "$mapper_unit"; then :; else
		mask_status=$?
	fi
	if [ "$mask_status" -eq 0 ] && mapper_mask_is_active &&
		[ ! -e "$mask_temporary" ] && [ ! -L "$mask_temporary" ]; then :; else
		[ "$mask_status" -ne 0 ] || mask_status=1
		mask_restore_status=0
		if ! mapper_mask_is_active; then
			# Retry the atomic mask replacement. If rename remains broken, a
			# direct link at this reserved safety name is the last resort.
			rm -f -- "$mask_temporary" || :
			if ln -s /dev/null "$mask_temporary"; then
				if mv -fT -- "$mask_temporary" "$mapper_unit"; then :; else
					mask_restore_status=$?
				fi
			else
				mask_restore_status=$?
			fi
			if ! mapper_mask_is_active; then
				rm -f -- "$mask_temporary" || :
				if rm -f -- "$mapper_unit"; then
					if ln -s /dev/null "$mapper_unit"; then
						mask_restore_status=0
					else
						mask_restore_status=$?
					fi
				else
					mask_restore_status=$?
				fi
			fi
		fi
		if ! mapper_mask_is_active; then
			if replace_with_verified_mask; then
				mask_restore_status=0
			else
				mask_restore_status=$?
			fi
		fi
		if rm -f -- "$mask_temporary"; then :; else
			temporary_mask_remove_status=$?
			[ "$mask_restore_status" -ne 0 ] ||
				mask_restore_status=$temporary_mask_remove_status
		fi
		rollback_outcome=complete
		surviving_artifacts=none
		if [ -e "$mask_temporary" ] || [ -L "$mask_temporary" ]; then
			rollback_outcome=incomplete
			surviving_artifacts=temporary-mask
		fi
		if mapper_mask_is_active; then
			observed_mask=/dev/null
		else
			observed_mask=missing-or-substituted
			rollback_outcome=incomplete
		fi
		printf 'swapz-primary-generator: phase=mask expected_mask=/dev/null observed_mask=%s original_status=%s restore_status=%s original_errno=unavailable surviving_artifacts=%s rollback=%s\n' \
			"$observed_mask" "$mask_status" "$mask_restore_status" "$surviving_artifacts" "$rollback_outcome" >&2
		fail "$mask_status" mask generator-output "$requested_mask_validation" mapper-active-job
	fi
}

fail_serialization()
{
	serialization_status=$1
	serialization_validation=$2
	if mapper_mask_is_active; then
		observed_mask=/dev/null
		rollback_outcome=early-mask-retained
	else
		observed_mask=missing-or-substituted
		rollback_outcome=incomplete
	fi
	printf 'swapz-primary-generator: phase=serialization expected=exclusive-generator-transaction expected_mask=/dev/null observed_mask=%s original_status=%s original_errno=unavailable surviving_artifacts=none rollback=%s\n' \
		"$observed_mask" "$serialization_status" "$rollback_outcome" >&2
	fail "$serialization_status" serialization generator-output "$serialization_validation" mapper-active-job
}

# Serialize this generator across overlapping reloads. The directory FD has
# no persistent lock artifact, and the early mask is installed while held.
if {
	if flock -x 9 2>/dev/null; then :; else
		serialization_status=$?
		install_verified_mask lock-failure-mask
		fail_serialization "$serialization_status" acquire-transaction-lock
	fi
	preexisting_unit=none
	if [ -L "$mapper_unit" ]; then
		if mask_destination=$(readlink -- "$mapper_unit"); then
			[ "$mask_destination" = /dev/null ] || preexisting_unit=unexpected-unit
		else
			fail "$?" mask generator-output read-existing-mask mapper-active-job
		fi
	elif [ -e "$mapper_unit" ]; then
		preexisting_unit=unexpected-unit
	fi
	install_verified_mask publish-mask
stage_dir=
mapper_dropin=
device_dropin=
published_mapper=0
published_device=0
transaction_committed=0
preserve_stage_dir=0
cleanup()
{
	cleanup_original_status=$?
	cleanup_command_status=0
	# Remove a partial graph while the mapper mask is still in force. Never
	# follow a substituted symlink to an external destination.
	if [ "$transaction_committed" -eq 0 ]; then
		if [ "$published_mapper" -eq 1 ] && [ ! -L "$mapper_dropin" ] &&
			[ "$stage_dir/owned-mapper" -ef "$mapper_dropin" ]; then
			if rm -f -- "$mapper_dropin"; then :; else
				cleanup_remove_status=$?
				[ "$cleanup_command_status" -ne 0 ] ||
					cleanup_command_status=$cleanup_remove_status
			fi
		fi
		if [ "$published_device" -eq 1 ] && [ ! -L "$device_dropin" ] &&
			[ "$stage_dir/owned-device" -ef "$device_dropin" ]; then
			if rm -f -- "$device_dropin"; then :; else
				cleanup_remove_status=$?
				[ "$cleanup_command_status" -ne 0 ] ||
					cleanup_command_status=$cleanup_remove_status
			fi
		fi
	fi
	# Classify survivors against the pinned inode before discarding staging.
	cleanup_observed_mapper=absent
	cleanup_observed_device=absent
	if [ "$published_mapper" -eq 1 ]; then
		if [ -L "$mapper_dropin" ]; then
			cleanup_observed_mapper=foreign-symlink
		elif [ -e "$mapper_dropin" ]; then
			if [ "$stage_dir/owned-mapper" -ef "$mapper_dropin" ]; then
				cleanup_observed_mapper=owned-inode-retained
			else
				cleanup_observed_mapper=foreign-inode-retained
			fi
		fi
	fi
	if [ "$published_device" -eq 1 ]; then
		if [ -L "$device_dropin" ]; then
			cleanup_observed_device=foreign-symlink
		elif [ -e "$device_dropin" ]; then
			if [ "$stage_dir/owned-device" -ef "$device_dropin" ]; then
				cleanup_observed_device=owned-inode-retained
			else
				cleanup_observed_device=foreign-inode-retained
			fi
		fi
	fi
	if [ -n "$stage_dir" ] && [ "$preserve_stage_dir" -eq 0 ]; then
		if rm -rf -- "$stage_dir"; then :; else
			cleanup_remove_status=$?
			[ "$cleanup_command_status" -ne 0 ] ||
				cleanup_command_status=$cleanup_remove_status
		fi
	fi
	# A cleanup command can substitute the early mapper unit after the
	# original failure. Re-establish the barrier after all rollback removals;
	# their command statuses do not prove the mask is still in force.
	cleanup_mask_restore_status=0
	cleanup_mask_repair_first_status=0
	cleanup_mask_was_missing=0
	if [ "$cleanup_original_status" -ne 0 ] && ! mapper_mask_is_active; then
		cleanup_mask_was_missing=1
		if replace_with_verified_mask; then :; else
			cleanup_mask_repair_first_status=$?
			cleanup_mask_restore_status=$cleanup_mask_repair_first_status
			# A falsely successful ln -sfnT is not a restored mask.
			# Try an independently staged, no-follow rename.
			if ln -s /dev/null "$mask_temporary"; then
				if mv -fT -- "$mask_temporary" "$mapper_unit"; then :; else
					cleanup_mask_restore_status=$?
				fi
			else
				cleanup_mask_restore_status=$?
			fi
			if [ -e "$mask_temporary" ] || [ -L "$mask_temporary" ]; then
				if rm -f -- "$mask_temporary"; then :; else
					cleanup_remove_status=$?
					[ "$cleanup_command_status" -ne 0 ] ||
						cleanup_command_status=$cleanup_remove_status
				fi
			fi
			if ! mapper_mask_is_active; then
				if replace_with_verified_mask; then :; else
					cleanup_mask_restore_status=$?
				fi
			fi
		fi
		if mapper_mask_is_active; then
			cleanup_mask_restore_status=0
		fi
	fi
	if [ "$cleanup_original_status" -ne 0 ] &&
		{ [ "$published_mapper" -eq 1 ] || [ "$published_device" -eq 1 ] ||
			[ "$cleanup_mask_was_missing" -eq 1 ]; }; then
		# A zero command status never proves unlink or private-stage cleanup.
		if [ -e "$mapper_dropin" ] || [ -L "$mapper_dropin" ]; then
			[ "$cleanup_observed_mapper" != absent ] ||
				cleanup_observed_mapper=late-substitution
		else
			cleanup_observed_mapper=absent
		fi
		if [ -e "$device_dropin" ] || [ -L "$device_dropin" ]; then
			[ "$cleanup_observed_device" != absent ] ||
				cleanup_observed_device=late-substitution
		else
			cleanup_observed_device=absent
		fi
		cleanup_observed_stage=absent
		if [ -n "$stage_dir" ] &&
			{ [ -e "$stage_dir" ] || [ -L "$stage_dir" ]; }; then
			cleanup_observed_stage=retained
		fi
		cleanup_observed_temporary_mask=absent
		if [ -e "$mask_temporary" ] || [ -L "$mask_temporary" ]; then
			cleanup_observed_temporary_mask=retained
		fi
		cleanup_observed_mask=missing-or-substituted
		if mapper_mask_is_active; then
			cleanup_observed_mask=/dev/null
		fi
		cleanup_rollback=complete
		cleanup_action=retain-early-mask
		if [ "$cleanup_observed_mapper" != absent ] ||
			[ "$cleanup_observed_device" != absent ] ||
			[ "$cleanup_observed_stage" != absent ] ||
			[ "$cleanup_observed_temporary_mask" != absent ] ||
			[ "$cleanup_observed_mask" != /dev/null ]; then
			cleanup_rollback=incomplete
			cleanup_action=retain-mask-and-refuse-activation
		fi
		if [ "$cleanup_observed_mask" != /dev/null ]; then
			cleanup_action=mask-unproven-owner-intervention-required
		fi
		printf 'swapz-primary-generator: phase=rollback expected=owned-dropins-absent expected_mask=/dev/null observed_mapper=%s observed_device=%s observed_stage=%s observed_temporary_mask=%s observed_mask=%s original_status=%s cleanup_status=%s mask_repair_first_status=%s mask_restore_status=%s original_errno=unavailable rollback=%s action=%s\n' \
			"$cleanup_observed_mapper" "$cleanup_observed_device" \
			"$cleanup_observed_stage" "$cleanup_observed_temporary_mask" \
			"$cleanup_observed_mask" "$cleanup_original_status" \
			"$cleanup_command_status" "$cleanup_mask_repair_first_status" \
			"$cleanup_mask_restore_status" "$cleanup_rollback" "$cleanup_action" >&2
	fi
}
trap cleanup EXIT
trap 'exit 1' HUP INT TERM
[ "$preexisting_unit" = none ] ||
	fail 1 mask generator-output unexpected-existing-unit mapper-active-job
for other_output_dir in "$normal_dir" "$late_dir"; do
	if [ -e "$other_output_dir/swapz-primary-mapper.service" ] ||
		[ -L "$other_output_dir/swapz-primary-mapper.service" ]; then
		fail 1 mask generator-output duplicate-mapper-unit mapper-active-job
	fi
done

if stage_dir=$(mktemp -d "$normal_dir/.swapz-primary-generator.XXXXXXXX"); then :; else
	fail "$?" staging generator-output create-private-directory mapper-active-job
fi
# The scratch directory remains private; published unit directories retain
# their original systemd-readable 0755 mode.
umask 022

# Clear only the generator's own prior target drop-ins, including a previous
# PARTUUID after a selector change. Other units and drop-ins are not ours.
refuse_unowned_dropin()
{
	unowned_validation=$1
	if mapper_mask_is_active; then
		observed_mask=/dev/null
		rollback_outcome=early-mask-retained
	else
		observed_mask=missing-or-substituted
		rollback_outcome=incomplete
	fi
	printf 'swapz-primary-generator: phase=cleanup expected=canonical-owned-dropin observed=foreign-regular-content expected_mask=/dev/null observed_mask=%s original_status=1 original_errno=not-applicable surviving_artifacts=unowned-dropin rollback=%s\n' \
		"$observed_mask" "$rollback_outcome" >&2
	fail 1 cleanup generator-output "$unowned_validation" mapper-active-job
}
refuse_replaced_dropin()
{
	replaced_source=$1
	replaced_staged=$2
	replaced_validation=$3
	replaced_status=$4
	[ "$replaced_status" -ne 0 ] || replaced_status=1
	surviving_artifacts=private-stage-unowned-dropin
	rollback_outcome=incomplete
	# If a regular replacement was moved into private staging, restore an
	# equivalent hardlink at its public path without overwriting any newer file.
	# The staged link can then be removed without deleting the foreign inode.
	if [ ! -L "$replaced_staged" ] && [ -f "$replaced_staged" ] &&
		[ ! -e "$replaced_source" ] && [ ! -L "$replaced_source" ] &&
		ln -- "$replaced_staged" "$replaced_source" &&
		[ ! -L "$replaced_source" ] &&
		[ "$replaced_staged" -ef "$replaced_source" ]; then
		if rm -f -- "$replaced_staged"; then
			surviving_artifacts=unowned-dropin-restored
			rollback_outcome=early-mask-retained
		else
			preserve_stage_dir=1
		fi
	else
		preserve_stage_dir=1
	fi
	if mapper_mask_is_active; then
		observed_mask=/dev/null
	else
		observed_mask=missing-or-substituted
		rollback_outcome=incomplete
	fi
	printf 'swapz-primary-generator: phase=cleanup expected=validated-owned-inode observed=replaced-inode expected_mask=/dev/null observed_mask=%s original_status=%s original_errno=unavailable surviving_artifacts=%s rollback=%s\n' \
		"$observed_mask" "$replaced_status" "$surviving_artifacts" "$rollback_outcome" >&2
	fail "$replaced_status" cleanup generator-output "$replaced_validation" mapper-active-job
}
refuse_unconsumed_dropin()
{
	unconsumed_source=$1
	unconsumed_validation=$2
	if [ -L "$unconsumed_source" ]; then
		observed_source=symlink
	else
		observed_source=retained-path
	fi
	if mapper_mask_is_active; then
		observed_mask=/dev/null
		rollback_outcome=early-mask-retained
	else
		observed_mask=missing-or-substituted
		rollback_outcome=incomplete
	fi
	# The rename reported success, but retirement is incomplete until the
	# original pathname is absent. Leave that path untouched on failure.
	printf 'swapz-primary-generator: phase=cleanup expected=consumed-stale-source observed=%s expected_mask=/dev/null observed_mask=%s original_status=1 rename_status=0 original_errno=not-applicable surviving_artifacts=stale-source rollback=%s\n' \
		"$observed_source" "$observed_mask" "$rollback_outcome" >&2
	fail 1 cleanup generator-output "$unconsumed_validation" mapper-active-job
}
mapper_dropin_dir=$normal_dir/swapz-primary-mapper.service.d
if [ -L "$mapper_dropin_dir" ]; then
	fail 1 cleanup generator-output symlinked-mapper-directory mapper-active-job
fi
if [ -d "$mapper_dropin_dir" ]; then
	old_mapper_dropin=$mapper_dropin_dir/50-selected-target.conf
	if [ -L "$old_mapper_dropin" ]; then
		fail 1 cleanup generator-output symlinked-mapper-dropin mapper-active-job
	fi
	if [ -e "$old_mapper_dropin" ]; then
		[ -f "$old_mapper_dropin" ] || fail 1 cleanup generator-output invalid-mapper-dropin mapper-active-job
		# Pin the inode before validating it. Retirement then quarantines the
		# pathname and verifies that the moved inode is the one we validated.
		old_mapper_pin=$stage_dir/owned-previous-mapper
		if ln -P -- "$old_mapper_dropin" "$old_mapper_pin"; then :; else
			fail "$?" cleanup generator-output pin-old-mapper-dropin mapper-active-job
		fi
		if [ -L "$old_mapper_pin" ] || [ ! -f "$old_mapper_pin" ]; then
			refuse_unowned_dropin unowned-mapper-dropin
		fi
		if previous_device_unit=$(sed -n '2{s/^Requires=//p;q;}' -- "$old_mapper_pin"); then :; else
			fail "$?" cleanup generator-output read-old-mapper-dropin mapper-active-job
		fi
		case "$previous_device_unit" in
		'dev-disk-by\x2dpartuuid-'*.device) ;;
		*) refuse_unowned_dropin unowned-mapper-dropin ;;
		esac
		previous_swap_unit=${previous_device_unit%.device}.swap
		if printf '[Unit]\nRequires=%s\nAfter=%s\nConflicts=%s\nBefore=%s\nJobTimeoutSec=300s\nJobTimeoutAction=none\n' \
			"$previous_device_unit" "$previous_device_unit" "$previous_swap_unit" "$previous_swap_unit" |
			cmp -s - "$old_mapper_pin"; then :; else
			compare_status=$?
			[ "$compare_status" -eq 1 ] && refuse_unowned_dropin unowned-mapper-dropin
			fail "$compare_status" cleanup generator-output compare-old-mapper-dropin mapper-active-job
		fi
		old_mapper_staged=$stage_dir/previous-mapper.conf
		old_mapper_move_status=0
		if mv -nT -- "$old_mapper_dropin" "$old_mapper_staged"; then :; else
			old_mapper_move_status=$?
		fi
		if [ ! -L "$old_mapper_staged" ] && [ -f "$old_mapper_staged" ] &&
			[ "$old_mapper_pin" -ef "$old_mapper_staged" ]; then
			[ "$old_mapper_move_status" -eq 0 ] ||
				fail "$old_mapper_move_status" cleanup generator-output stage-old-mapper-dropin mapper-active-job
			if [ -e "$old_mapper_dropin" ] || [ -L "$old_mapper_dropin" ]; then
				refuse_unconsumed_dropin "$old_mapper_dropin" stale-mapper-source-not-consumed
			fi
		else
			refuse_replaced_dropin "$old_mapper_dropin" "$old_mapper_staged" \
				stale-mapper-inode-replaced "$old_mapper_move_status"
		fi
	fi
elif [ -e "$mapper_dropin_dir" ]; then
	fail 1 cleanup generator-output invalid-mapper-directory mapper-active-job
fi

stale_device_index=0
for old_device_dir in "$normal_dir"/dev-disk-by\\x2dpartuuid-*.device.d; do
	[ -e "$old_device_dir" ] || [ -L "$old_device_dir" ] || continue
	if [ -L "$old_device_dir" ] || [ ! -d "$old_device_dir" ]; then
		fail 1 cleanup generator-output unsafe-stale-device-directory mapper-active-job
	fi
	old_device_dropin=$old_device_dir/50-swapz-timeout.conf
	if [ -L "$old_device_dropin" ]; then
		fail 1 cleanup generator-output symlinked-device-dropin mapper-active-job
	fi
	if [ -e "$old_device_dropin" ]; then
		[ -f "$old_device_dropin" ] || fail 1 cleanup generator-output invalid-device-dropin mapper-active-job
		stale_device_index=$((stale_device_index + 1))
		old_device_pin=$stage_dir/owned-previous-device-$stale_device_index
		old_device_staged=$stage_dir/previous-device-$stale_device_index.conf
		if ln -P -- "$old_device_dropin" "$old_device_pin"; then :; else
			fail "$?" cleanup generator-output pin-stale-device-dropin mapper-active-job
		fi
		if [ -L "$old_device_pin" ] || [ ! -f "$old_device_pin" ]; then
			refuse_unowned_dropin unowned-stale-device-dropin
		fi
		if printf '[Unit]\nJobTimeoutSec=30s\nJobTimeoutAction=none\n' |
			cmp -s - "$old_device_pin"; then :; else
			compare_status=$?
			[ "$compare_status" -eq 1 ] && refuse_unowned_dropin unowned-stale-device-dropin
			fail "$compare_status" cleanup generator-output compare-stale-device-dropin mapper-active-job
		fi
		old_device_move_status=0
		if mv -nT -- "$old_device_dropin" "$old_device_staged"; then :; else
			old_device_move_status=$?
		fi
		if [ ! -L "$old_device_staged" ] && [ -f "$old_device_staged" ] &&
			[ "$old_device_pin" -ef "$old_device_staged" ]; then
			[ "$old_device_move_status" -eq 0 ] ||
				fail "$old_device_move_status" cleanup generator-output stage-stale-device-dropin mapper-active-job
			if [ -e "$old_device_dropin" ] || [ -L "$old_device_dropin" ]; then
				refuse_unconsumed_dropin "$old_device_dropin" stale-device-source-not-consumed
			fi
		else
			refuse_replaced_dropin "$old_device_dropin" "$old_device_staged" \
				stale-device-inode-replaced "$old_device_move_status"
		fi
	fi
	# Keep a directory containing someone else's drop-ins.
	rmdir -- "$old_device_dir" 2>/dev/null || :
done

# Hibernation cannot preserve swapz's volatile mapping authority. Install a
# narrow pre-hibernation guard on every systemd sleep path that can write a
# hibernation image. The helper is observation-only and blocks rather than
# deactivating or recreating a mapping. Generators rerun on daemon-reload, so
# these transient drop-ins follow the installed helper path automatically.
for sleep_service in systemd-hibernate.service systemd-hybrid-sleep.service systemd-suspend-then-hibernate.service; do
	hibernate_dropin_dir=$normal_dir/$sleep_service.d
	if [ -L "$hibernate_dropin_dir" ]; then
		fail 1 hibernation generator-output symlinked-hibernation-directory 'hibernate-guard,mapper-active-job'
	fi
	if mkdir -p -- "$hibernate_dropin_dir"; then :; else
		fail "$?" hibernation generator-output create-hibernation-directory 'hibernate-guard,mapper-active-job'
	fi
	if [ ! -d "$hibernate_dropin_dir" ] || [ -L "$hibernate_dropin_dir" ]; then
		fail 1 hibernation generator-output unsafe-hibernation-directory 'hibernate-guard,mapper-active-job'
	fi
	hibernate_dropin=$hibernate_dropin_dir/50-swapz-no-hibernate.conf
	if [ -L "$hibernate_dropin" ]; then
		fail 1 hibernation generator-output symlinked-hibernation-dropin 'hibernate-guard,mapper-active-job'
	fi
	hibernate_temporary=$stage_dir/$sleep_service.conf
	if printf '[Service]\nExecStartPre=@SWAPZ_SBINDIR@/swapz-primary-runtime-health hibernate-guard\n' > "$hibernate_temporary"; then :; else
		fail "$?" hibernation generator-output write-hibernation-guard 'hibernate-guard,mapper-active-job'
	fi
	if chmod 0644 "$hibernate_temporary" && mv -fT -- "$hibernate_temporary" "$hibernate_dropin"; then :; else
		fail "$?" hibernation generator-output publish-hibernation-guard 'hibernate-guard,mapper-active-job'
	fi
done

# swapzctl owns selector parsing, root-ownership checks, PARTUUID normalization,
# and escaping. The generator must never infer or substitute a target itself.
# Bound manager stdout on disk before shell expansion, retaining its exit status.
response_file=$stage_dir/units
if (ulimit -f 2; "@SWAPZ_SBINDIR@/swapzctl" primary systemd-units) > "$response_file" 2>/dev/null; then :; else
	fail "$?" selection protected-selector manager-status mapper-active-job
fi
if response_size=$(wc -c < "$response_file"); then :; else
	fail "$?" selection manager-output measure-response mapper-active-job
fi
if [ "$response_size" -gt 512 ]; then
	fail 1 selection manager-output oversized-response mapper-active-job
fi
if units=$(cat -- "$response_file"); then :; else
	fail "$?" selection manager-output read-response mapper-active-job
fi
# Command substitution erases terminal newlines (and some shells drop NULs).
# Recheck the exact bounded bytes, including one mandatory final newline.
if printf '%s\n' "$units" | cmp -s - "$response_file"; then :; else
	compare_status=$?
	if [ "$compare_status" -eq 1 ]; then
		fail 1 selection manager-output noncanonical-response mapper-active-job
	fi
	fail "$compare_status" selection manager-output compare-response mapper-active-job
fi
case "$units" in
*'
'*) fail 1 selection manager-output multiline-response mapper-active-job ;;
esac
set -f
old_ifs=$IFS
IFS=' '
# shellcheck disable=SC2086 # Intentional strict split; exact reconstruction follows.
set -- $units
IFS=$old_ifs
set +f
if [ "$#" -ne 2 ] || [ "$1 $2" != "$units" ]; then
	fail 1 selection manager-output malformed-response mapper-active-job
fi
device_unit=$1
swap_unit=$2

case "$device_unit" in
'dev-disk-by\x2dpartuuid-'*.device) ;;
*) fail 1 selection manager-output invalid-device-unit mapper-active-job ;;
esac
case "$swap_unit" in
'dev-disk-by\x2dpartuuid-'*.swap) ;;
*) fail 1 selection manager-output invalid-raw-swap-unit mapper-active-job ;;
esac
encoded_device=${device_unit#'dev-disk-by\x2dpartuuid-'}
encoded_device=${encoded_device%.device}
encoded_swap=${swap_unit#'dev-disk-by\x2dpartuuid-'}
encoded_swap=${encoded_swap%.swap}
[ "$encoded_device" = "$encoded_swap" ] ||
	fail 1 selection manager-output identity-mismatch mapper-active-job

valid_encoded_partuuid()
{
	value=$1
	decoded_length=0
	hex_digit_count=0
	previous_was_hyphen=1
	while [ -n "$value" ]; do
		case "$value" in
		'\x2d'*)
			[ "$previous_was_hyphen" -eq 0 ] || return 1
			value=${value#'\x2d'}
			decoded_length=$((decoded_length + 1))
			previous_was_hyphen=1
			;;
		[0-9a-f]*)
			value=${value#?}
			decoded_length=$((decoded_length + 1))
			hex_digit_count=$((hex_digit_count + 1))
			previous_was_hyphen=0
			;;
		*) return 1 ;;
		esac
		[ "$decoded_length" -le 64 ] || return 1
	done
	# Match the protected selector grammar, not merely the decoded length.
	[ "$decoded_length" -ge 8 ] && [ "$hex_digit_count" -ge 8 ] &&
		[ "$previous_was_hyphen" -eq 0 ]
}
valid_encoded_partuuid "$encoded_device" ||
	fail 1 selection manager-output invalid-escaped-partuuid mapper-active-job

# The mapper job spans bounded mapper start and, on shutdown, can include
# swapoff followed by mapper teardown. Allow both 120s phases plus slack.
# A mapper job timeout alone cannot bound the separate .device job queued by
# Requires=, so cap that exact udev device job independently at 30s.
device_dropin_dir=$normal_dir/$device_unit.d
for dropin_dir in "$mapper_dropin_dir" "$device_dropin_dir"; do
	if [ -L "$dropin_dir" ]; then
		fail 1 publication generator-output symlinked-dropin-directory mapper-active-job
	fi
	if mkdir -p -- "$dropin_dir"; then :; else
		fail "$?" publication generator-output create-dropin-directory mapper-active-job
	fi
	if [ ! -d "$dropin_dir" ] || [ -L "$dropin_dir" ]; then
		fail 1 publication generator-output unsafe-dropin-directory mapper-active-job
	fi
done

# A second generator's same-named unit is an unresolved activation identity.
# Never overwrite it or release our mask on a collision.
for duplicate_output_dir in "$normal_dir" "$early_dir" "$late_dir"; do
	for duplicate_unit in "$duplicate_output_dir/$device_unit" \
		"$duplicate_output_dir/$swap_unit" \
		"$duplicate_output_dir/swap.target.wants/$swap_unit"; do
		if [ -e "$duplicate_unit" ] || [ -L "$duplicate_unit" ]; then
			fail 1 publication generator-output duplicate-selected-unit mapper-active-job
		fi
	done
done
mapper_dropin=$mapper_dropin_dir/50-selected-target.conf
device_dropin=$device_dropin_dir/50-swapz-timeout.conf
for dropin in "$mapper_dropin" "$device_dropin"; do
	if [ -e "$dropin" ] || [ -L "$dropin" ]; then
		fail 1 publication generator-output duplicate-generated-dropin mapper-active-job
	fi
done
mapper_temporary=$stage_dir/mapper.conf
device_temporary=$stage_dir/device.conf
if printf '[Unit]\nRequires=%s\nAfter=%s\nConflicts=%s\nBefore=%s\nJobTimeoutSec=300s\nJobTimeoutAction=none\n' \
	"$device_unit" "$device_unit" "$swap_unit" "$swap_unit" > "$mapper_temporary"; then :; else
	fail "$?" publication generator-output write-mapper-dropin mapper-active-job
fi
if printf '[Unit]\nJobTimeoutSec=30s\nJobTimeoutAction=none\n' > "$device_temporary"; then :; else
	fail "$?" publication generator-output write-device-dropin mapper-active-job
fi
if chmod 0644 "$mapper_temporary" "$device_temporary"; then :; else
	fail "$?" publication generator-output chmod-dropins mapper-active-job
fi
# Retain private hardlinks to verify rollback owns the published inode even
# when a rename succeeds but its wrapper reports failure or substitutes a file.
if ln -- "$device_temporary" "$stage_dir/owned-device" &&
	ln -- "$mapper_temporary" "$stage_dir/owned-mapper"; then :; else
	fail "$?" publication generator-output pin-published-files mapper-active-job
fi
# Neither path may replace a unit substituted after the collision preflight.
# GNU mv -n may succeed without moving; check the pinned inode and source.
published_device=1
if mv -nT -- "$device_temporary" "$device_dropin" &&
	[ ! -L "$device_dropin" ] &&
	[ "$stage_dir/owned-device" -ef "$device_dropin" ] &&
	[ ! -e "$device_temporary" ]; then :; else
	fail "$?" publication generator-output publish-device-dropin mapper-active-job
fi
published_mapper=1
if mv -nT -- "$mapper_temporary" "$mapper_dropin" &&
	[ ! -L "$mapper_dropin" ] &&
	[ "$stage_dir/owned-mapper" -ef "$mapper_dropin" ] &&
	[ ! -e "$mapper_temporary" ]; then :; else
	fail "$?" publication generator-output publish-mapper-dropin mapper-active-job
fi
# Publish the activation barrier last; any earlier error leaves the mask.
# A failed or falsely successful unlink must not commit the target graph.
# The earlier publication checks are not proof that both inode identities
# still match when the barrier is about to be removed.
if [ -L "$mapper_dropin" ] || [ -L "$device_dropin" ] ||
	[ ! "$stage_dir/owned-mapper" -ef "$mapper_dropin" ] ||
	[ ! "$stage_dir/owned-device" -ef "$device_dropin" ]; then
	fail 1 publication generator-output pre-release-inode-mismatch mapper-active-job
fi
if rm -f -- "$mapper_unit"; then
	# A release wrapper can report success while substituting a published
	# drop-in. A missing mask is not a committed, owned dependency graph.
	if [ ! -e "$mapper_unit" ] && [ ! -L "$mapper_unit" ] &&
		[ ! -L "$mapper_dropin" ] && [ ! -L "$device_dropin" ] &&
		[ "$stage_dir/owned-mapper" -ef "$mapper_dropin" ] &&
		[ "$stage_dir/owned-device" -ef "$device_dropin" ]; then
		transaction_committed=1
		exit 0
	fi
	mask_status=1
	mask_validation=publication-ownership-not-proven
	if [ -e "$mapper_unit" ] || [ -L "$mapper_unit" ]; then
		mask_validation=mask-not-released
	fi
else
	mask_status=$?
	mask_validation=release-mask
fi
# An unlink may have succeeded despite a failing wrapper/status. A symlink is
# a mask only when it still targets /dev/null; replace a substituted unit at
# this early-priority safety path before reporting that publication failed.
mask_restore_status=0
if ! mapper_mask_is_active; then
	rm -f -- "$mask_temporary" || :
	if ln -s /dev/null "$mask_temporary"; then
		if mv -fT -- "$mask_temporary" "$mapper_unit"; then :; else
			mask_restore_status=$?
		fi
	else
		mask_restore_status=$?
	fi
	if mapper_mask_is_active; then
		mask_restore_status=0
	else
		# The initial barrier already owns this exact early unit name by
		# replacing collisions with a mask before failing. Rollback must do
		# the same rather than preserve an activation-capable substitution.
		rm -f -- "$mask_temporary" || :
		if rm -f -- "$mapper_unit"; then :; else
			fallback_remove_status=$?
			[ "$mask_restore_status" -ne 0 ] ||
				mask_restore_status=$fallback_remove_status
		fi
		if [ ! -e "$mapper_unit" ] && [ ! -L "$mapper_unit" ]; then
			if ln -s /dev/null "$mapper_unit"; then
				mask_restore_status=0
			else
				mask_restore_status=$?
			fi
		fi
		mapper_mask_is_active && mask_restore_status=0 || :
		if ! mapper_mask_is_active; then
			if replace_with_verified_mask; then
				mask_restore_status=0
			else
				mask_restore_status=$?
			fi
		fi
	fi
fi
# The unlink result is the original failure. Check rollback without
# exposing the selected identity or overwriting that status.
cleanup
trap - EXIT
rollback_outcome=complete
if [ -e "$mapper_dropin" ] || [ -L "$mapper_dropin" ] ||
	[ -e "$device_dropin" ] || [ -L "$device_dropin" ]; then
	rollback_outcome=incomplete
fi
if mapper_mask_is_active; then
	observed_mask=early-mask-retained
else
	observed_mask=early-mask-missing-or-substituted
	rollback_outcome=incomplete
fi
printf 'swapz-primary-generator: phase=rollback expected=early-mask-and-no-owned-dropins observed=%s original_status=%s restore_status=%s original_errno=unavailable rollback=%s\n' \
	"$observed_mask" "$mask_status" "$mask_restore_status" "$rollback_outcome" >&2
fail "$mask_status" publication generator-output "$mask_validation" mapper-active-job
} 9< "$early_dir"; then
	exit 0
else
	serialization_status=$?
	install_verified_mask lock-open-failure-mask
	fail_serialization "$serialization_status" open-transaction-lock
fi
