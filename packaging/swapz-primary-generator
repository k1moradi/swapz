#!/bin/sh
# Emit selected-target ordering for the disabled primary-swap systemd units.
set -eu
umask 077

fail()
{
	failure_status=$1
	failure_phase=$2
	failure_source=$3
	failure_validation=$4
	failure_withheld=$5
	printf 'swapz-primary-generator: phase=%s source=%s validation=%s status=%s withheld=%s\n' \
		"$failure_phase" "$failure_source" "$failure_validation" \
		"$failure_status" "$failure_withheld" >&2
	exit "$failure_status"
}

if [ "$#" -ne 3 ]; then
	fail 2 arguments generator-output count mapper-active-job
fi

normal_dir=$1
early_dir=$2
late_dir=$3
safe_output_directory()
{
	# Systemd supplies absolute paths. Refuse a symlinked ancestor or a
	# lexical alias rather than writing through an unexpected directory.
	current_directory=$1
	while [ "$current_directory" != / ]; do
		case "$current_directory" in
		*/.|*/..) return 1 ;;
		esac
		[ -d "$current_directory" ] && [ ! -L "$current_directory" ] || return 1
		current_directory=${current_directory%/*}
		[ -n "$current_directory" ] || current_directory=/
	done
}
for output_dir in "$normal_dir" "$early_dir" "$late_dir"; do
	case "$output_dir" in
	/*) ;;
	*) fail 2 arguments generator-output absolute-path mapper-active-job ;;
	esac
	if ! safe_output_directory "$output_dir"; then
		fail 2 arguments generator-output unsafe-output-directory mapper-active-job
	fi
done
if [ "$normal_dir" = "$early_dir" ] || [ "$normal_dir" = "$late_dir" ] ||
	[ "$early_dir" = "$late_dir" ] ||
	[ "$normal_dir" -ef "$early_dir" ] || [ "$normal_dir" -ef "$late_dir" ] ||
	[ "$early_dir" -ef "$late_dir" ]; then
	fail 2 arguments generator-output duplicate-output-directory mapper-active-job
fi

# The mask is the publication barrier: enabled swap.target wants may already
# exist, but a failed regeneration must never expose an executable mapper job.
# generator.early outranks even administrator /etc units; a normal-dir mask
# cannot reliably block an enabled mapper on selector/admission failure.
mapper_unit=$early_dir/swapz-primary-mapper.service
mask_temporary=$early_dir/.swapz-primary-mask.$$
preexisting_unit=none
if [ -L "$mapper_unit" ]; then
	if mask_destination=$(readlink -- "$mapper_unit"); then
		[ "$mask_destination" = /dev/null ] || preexisting_unit=unexpected-unit
	else
		fail "$?" mask generator-output read-existing-mask mapper-active-job
	fi
elif [ -e "$mapper_unit" ]; then
	preexisting_unit=unexpected-unit
fi
if ln -s /dev/null "$mask_temporary"; then :; else
	fail "$?" mask generator-output create-mask mapper-active-job
fi
if mv -fT -- "$mask_temporary" "$mapper_unit"; then :; else
	mask_status=$?
	rm -f -- "$mask_temporary"
	fail "$mask_status" mask generator-output publish-mask mapper-active-job
fi

stage_dir=
mapper_dropin=
device_dropin=
published_mapper=0
published_device=0
transaction_committed=0
cleanup()
{
	# Remove a partial graph while the mapper mask is still in force. Never
	# follow a substituted symlink to an external destination.
	if [ "$transaction_committed" -eq 0 ]; then
		if [ "$published_mapper" -eq 1 ] && [ ! -L "$mapper_dropin" ] &&
			[ "$stage_dir/owned-mapper" -ef "$mapper_dropin" ]; then
			rm -f -- "$mapper_dropin" || :
		fi
		if [ "$published_device" -eq 1 ] && [ ! -L "$device_dropin" ] &&
			[ "$stage_dir/owned-device" -ef "$device_dropin" ]; then
			rm -f -- "$device_dropin" || :
		fi
	fi
	[ -z "$stage_dir" ] || rm -rf -- "$stage_dir" || :
}
trap cleanup EXIT
trap 'exit 1' HUP INT TERM
[ "$preexisting_unit" = none ] ||
	fail 1 mask generator-output unexpected-existing-unit mapper-active-job
for other_output_dir in "$normal_dir" "$late_dir"; do
	if [ -e "$other_output_dir/swapz-primary-mapper.service" ] ||
		[ -L "$other_output_dir/swapz-primary-mapper.service" ]; then
		fail 1 mask generator-output duplicate-mapper-unit mapper-active-job
	fi
done

if stage_dir=$(mktemp -d "$normal_dir/.swapz-primary-generator.XXXXXXXX"); then :; else
	fail "$?" staging generator-output create-private-directory mapper-active-job
fi
# The scratch directory remains private; published unit directories retain
# their original systemd-readable 0755 mode.
umask 022

# Clear only the generator's own prior target drop-ins, including a previous
# PARTUUID after a selector change. Other units and drop-ins are not ours.
mapper_dropin_dir=$normal_dir/swapz-primary-mapper.service.d
if [ -L "$mapper_dropin_dir" ]; then
	fail 1 cleanup generator-output symlinked-mapper-directory mapper-active-job
fi
if [ -d "$mapper_dropin_dir" ]; then
	old_mapper_dropin=$mapper_dropin_dir/50-selected-target.conf
	if [ -L "$old_mapper_dropin" ]; then
		fail 1 cleanup generator-output symlinked-mapper-dropin mapper-active-job
	fi
	if [ -e "$old_mapper_dropin" ]; then
		[ -f "$old_mapper_dropin" ] || fail 1 cleanup generator-output invalid-mapper-dropin mapper-active-job
		# Keep the old inode owned in private staging until the new file is
		# published; an immediate unlink could recycle it on daemon-reload.
		if mv -fT -- "$old_mapper_dropin" "$stage_dir/previous-mapper.conf"; then :; else
			fail "$?" cleanup generator-output stage-old-mapper-dropin mapper-active-job
		fi
	fi
elif [ -e "$mapper_dropin_dir" ]; then
	fail 1 cleanup generator-output invalid-mapper-directory mapper-active-job
fi

for old_device_dir in "$normal_dir"/dev-disk-by\\x2dpartuuid-*.device.d; do
	[ -e "$old_device_dir" ] || [ -L "$old_device_dir" ] || continue
	if [ -L "$old_device_dir" ] || [ ! -d "$old_device_dir" ]; then
		fail 1 cleanup generator-output unsafe-stale-device-directory mapper-active-job
	fi
	old_device_dropin=$old_device_dir/50-swapz-timeout.conf
	if [ -L "$old_device_dropin" ]; then
		fail 1 cleanup generator-output symlinked-device-dropin mapper-active-job
	fi
	if [ -e "$old_device_dropin" ]; then
		[ -f "$old_device_dropin" ] || fail 1 cleanup generator-output invalid-device-dropin mapper-active-job
		if rm -f -- "$old_device_dropin"; then :; else
			fail "$?" cleanup generator-output remove-stale-device-dropin mapper-active-job
		fi
	fi
	# Keep a directory containing someone else's drop-ins.
	rmdir -- "$old_device_dir" 2>/dev/null || :
done

# Hibernation cannot preserve swapz's volatile mapping authority. Install a
# narrow pre-hibernation guard on every systemd sleep path that can write a
# hibernation image. The helper is observation-only and blocks rather than
# deactivating or recreating a mapping. Generators rerun on daemon-reload, so
# these transient drop-ins follow the installed helper path automatically.
for sleep_service in systemd-hibernate.service systemd-hybrid-sleep.service systemd-suspend-then-hibernate.service; do
	hibernate_dropin_dir=$normal_dir/$sleep_service.d
	if [ -L "$hibernate_dropin_dir" ]; then
		fail 1 hibernation generator-output symlinked-hibernation-directory 'hibernate-guard,mapper-active-job'
	fi
	if mkdir -p -- "$hibernate_dropin_dir"; then :; else
		fail "$?" hibernation generator-output create-hibernation-directory 'hibernate-guard,mapper-active-job'
	fi
	if [ ! -d "$hibernate_dropin_dir" ] || [ -L "$hibernate_dropin_dir" ]; then
		fail 1 hibernation generator-output unsafe-hibernation-directory 'hibernate-guard,mapper-active-job'
	fi
	hibernate_dropin=$hibernate_dropin_dir/50-swapz-no-hibernate.conf
	if [ -L "$hibernate_dropin" ]; then
		fail 1 hibernation generator-output symlinked-hibernation-dropin 'hibernate-guard,mapper-active-job'
	fi
	hibernate_temporary=$stage_dir/$sleep_service.conf
	if printf '[Service]\nExecStartPre=@SWAPZ_SBINDIR@/swapz-primary-runtime-health hibernate-guard\n' > "$hibernate_temporary"; then :; else
		fail "$?" hibernation generator-output write-hibernation-guard 'hibernate-guard,mapper-active-job'
	fi
	if chmod 0644 "$hibernate_temporary" && mv -fT -- "$hibernate_temporary" "$hibernate_dropin"; then :; else
		fail "$?" hibernation generator-output publish-hibernation-guard 'hibernate-guard,mapper-active-job'
	fi
done

# swapzctl owns selector parsing, root-ownership checks, PARTUUID normalization,
# and escaping. The generator must never infer or substitute a target itself.
# Bound manager stdout on disk before shell expansion, retaining its exit status.
response_file=$stage_dir/units
if (ulimit -f 2; "@SWAPZ_SBINDIR@/swapzctl" primary systemd-units) > "$response_file" 2>/dev/null; then :; else
	fail "$?" selection protected-selector manager-status mapper-active-job
fi
if response_size=$(wc -c < "$response_file"); then :; else
	fail "$?" selection manager-output measure-response mapper-active-job
fi
if [ "$response_size" -gt 512 ]; then
	fail 1 selection manager-output oversized-response mapper-active-job
fi
if units=$(cat -- "$response_file"); then :; else
	fail "$?" selection manager-output read-response mapper-active-job
fi
# Command substitution erases terminal newlines (and some shells drop NULs).
# Recheck the exact bounded bytes, including one mandatory final newline.
if printf '%s\n' "$units" | cmp -s - "$response_file"; then :; else
	compare_status=$?
	if [ "$compare_status" -eq 1 ]; then
		fail 1 selection manager-output noncanonical-response mapper-active-job
	fi
	fail "$compare_status" selection manager-output compare-response mapper-active-job
fi
case "$units" in
*'
'*) fail 1 selection manager-output multiline-response mapper-active-job ;;
esac
set -f
old_ifs=$IFS
IFS=' '
# shellcheck disable=SC2086 # Intentional strict split; exact reconstruction follows.
set -- $units
IFS=$old_ifs
set +f
if [ "$#" -ne 2 ] || [ "$1 $2" != "$units" ]; then
	fail 1 selection manager-output malformed-response mapper-active-job
fi
device_unit=$1
swap_unit=$2

case "$device_unit" in
'dev-disk-by\x2dpartuuid-'*.device) ;;
*) fail 1 selection manager-output invalid-device-unit mapper-active-job ;;
esac
case "$swap_unit" in
'dev-disk-by\x2dpartuuid-'*.swap) ;;
*) fail 1 selection manager-output invalid-raw-swap-unit mapper-active-job ;;
esac
encoded_device=${device_unit#'dev-disk-by\x2dpartuuid-'}
encoded_device=${encoded_device%.device}
encoded_swap=${swap_unit#'dev-disk-by\x2dpartuuid-'}
encoded_swap=${encoded_swap%.swap}
[ "$encoded_device" = "$encoded_swap" ] ||
	fail 1 selection manager-output identity-mismatch mapper-active-job

valid_encoded_partuuid()
{
	value=$1
	decoded_length=0
	hex_digit_count=0
	previous_was_hyphen=1
	while [ -n "$value" ]; do
		case "$value" in
		'\x2d'*)
			[ "$previous_was_hyphen" -eq 0 ] || return 1
			value=${value#'\x2d'}
			decoded_length=$((decoded_length + 1))
			previous_was_hyphen=1
			;;
		[0-9a-f]*)
			value=${value#?}
			decoded_length=$((decoded_length + 1))
			hex_digit_count=$((hex_digit_count + 1))
			previous_was_hyphen=0
			;;
		*) return 1 ;;
		esac
		[ "$decoded_length" -le 64 ] || return 1
	done
	# Match the protected selector grammar, not merely the decoded length.
	[ "$decoded_length" -ge 8 ] && [ "$hex_digit_count" -ge 8 ] &&
		[ "$previous_was_hyphen" -eq 0 ]
}
valid_encoded_partuuid "$encoded_device" ||
	fail 1 selection manager-output invalid-escaped-partuuid mapper-active-job

# The mapper job spans bounded mapper start and, on shutdown, can include
# swapoff followed by mapper teardown. Allow both 120s phases plus slack.
# A mapper job timeout alone cannot bound the separate .device job queued by
# Requires=, so cap that exact udev device job independently at 30s.
device_dropin_dir=$normal_dir/$device_unit.d
for dropin_dir in "$mapper_dropin_dir" "$device_dropin_dir"; do
	if [ -L "$dropin_dir" ]; then
		fail 1 publication generator-output symlinked-dropin-directory mapper-active-job
	fi
	if mkdir -p -- "$dropin_dir"; then :; else
		fail "$?" publication generator-output create-dropin-directory mapper-active-job
	fi
	if [ ! -d "$dropin_dir" ] || [ -L "$dropin_dir" ]; then
		fail 1 publication generator-output unsafe-dropin-directory mapper-active-job
	fi
done

# A second generator's same-named unit is an unresolved activation identity.
# Never overwrite it or release our mask on a collision.
for duplicate_output_dir in "$normal_dir" "$early_dir" "$late_dir"; do
	for duplicate_unit in "$duplicate_output_dir/$device_unit" \
		"$duplicate_output_dir/$swap_unit" \
		"$duplicate_output_dir/swap.target.wants/$swap_unit"; do
		if [ -e "$duplicate_unit" ] || [ -L "$duplicate_unit" ]; then
			fail 1 publication generator-output duplicate-selected-unit mapper-active-job
		fi
	done
done
mapper_dropin=$mapper_dropin_dir/50-selected-target.conf
device_dropin=$device_dropin_dir/50-swapz-timeout.conf
for dropin in "$mapper_dropin" "$device_dropin"; do
	if [ -e "$dropin" ] || [ -L "$dropin" ]; then
		fail 1 publication generator-output duplicate-generated-dropin mapper-active-job
	fi
done
mapper_temporary=$stage_dir/mapper.conf
device_temporary=$stage_dir/device.conf
if printf '[Unit]\nRequires=%s\nAfter=%s\nConflicts=%s\nBefore=%s\nJobTimeoutSec=300s\nJobTimeoutAction=none\n' \
	"$device_unit" "$device_unit" "$swap_unit" "$swap_unit" > "$mapper_temporary"; then :; else
	fail "$?" publication generator-output write-mapper-dropin mapper-active-job
fi
if printf '[Unit]\nJobTimeoutSec=30s\nJobTimeoutAction=none\n' > "$device_temporary"; then :; else
	fail "$?" publication generator-output write-device-dropin mapper-active-job
fi
if chmod 0644 "$mapper_temporary" "$device_temporary"; then :; else
	fail "$?" publication generator-output chmod-dropins mapper-active-job
fi
# Retain private hardlinks to verify rollback owns the published inode even
# when a rename succeeds but its wrapper reports failure or substitutes a file.
if ln -- "$device_temporary" "$stage_dir/owned-device" &&
	ln -- "$mapper_temporary" "$stage_dir/owned-mapper"; then :; else
	fail "$?" publication generator-output pin-published-files mapper-active-job
fi
# Neither path may replace a unit substituted after the collision preflight.
# GNU mv -n may succeed without moving; check the pinned inode and source.
published_device=1
if mv -nT -- "$device_temporary" "$device_dropin" &&
	[ ! -L "$device_dropin" ] &&
	[ "$stage_dir/owned-device" -ef "$device_dropin" ] &&
	[ ! -e "$device_temporary" ]; then :; else
	fail "$?" publication generator-output publish-device-dropin mapper-active-job
fi
published_mapper=1
if mv -nT -- "$mapper_temporary" "$mapper_dropin" &&
	[ ! -L "$mapper_dropin" ] &&
	[ "$stage_dir/owned-mapper" -ef "$mapper_dropin" ] &&
	[ ! -e "$mapper_temporary" ]; then :; else
	fail "$?" publication generator-output publish-mapper-dropin mapper-active-job
fi
# Publish the activation barrier last; any earlier error leaves the mask.
transaction_committed=1
if rm -f -- "$mapper_unit"; then :; else
	mask_status=$?
	# An unlink may have succeeded despite a failing wrapper/status. Restore
	# the fail-closed barrier before reporting that publication failed.
	if [ ! -L "$mapper_unit" ]; then
		if ln -s /dev/null "$mask_temporary" &&
			mv -fT -- "$mask_temporary" "$mapper_unit"; then :; else
			fail "$?" publication generator-output restore-mask mapper-active-job
		fi
	fi
	fail "$mask_status" publication generator-output release-mask mapper-active-job
fi
exit 0
