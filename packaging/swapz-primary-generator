#!/bin/sh
# Emit selected-target ordering for the disabled primary-swap systemd units.
set -eu
umask 022

if [ "$#" -ne 3 ]; then
	echo "swapz-primary-generator: expected normal/early/late output directories" >&2
	exit 2
fi

normal_dir=$1
case "$normal_dir" in
/*) ;;
*)
	echo "swapz-primary-generator: invalid normal output directory" >&2
	exit 2
	;;
esac
if [ ! -d "$normal_dir" ] || [ -L "$normal_dir" ]; then
	echo "swapz-primary-generator: normal output directory is unavailable or unsafe" >&2
	exit 2
fi

# Hibernation cannot preserve swapz's volatile mapping authority. Install a
# narrow pre-hibernation guard on every systemd sleep path that can write a
# hibernation image. The helper is observation-only and blocks rather than
# deactivating or recreating a mapping. Generators rerun on daemon-reload, so
# these transient drop-ins follow the installed helper path automatically.
hibernate_temporary=
cleanup_hibernate()
{
	[ -z "$hibernate_temporary" ] || rm -f -- "$hibernate_temporary"
}
trap cleanup_hibernate EXIT HUP INT TERM
for sleep_service in systemd-hibernate.service systemd-hybrid-sleep.service systemd-suspend-then-hibernate.service; do
	hibernate_dropin_dir=$normal_dir/$sleep_service.d
	if [ -L "$hibernate_dropin_dir" ]; then
		echo "swapz-primary-generator: refusing symlinked hibernation drop-in directory" >&2
		exit 1
	fi
	mkdir -p -- "$hibernate_dropin_dir"
	if [ ! -d "$hibernate_dropin_dir" ] || [ -L "$hibernate_dropin_dir" ]; then
		echo "swapz-primary-generator: cannot create safe hibernation drop-in directory" >&2
		exit 1
	fi
	hibernate_dropin=$hibernate_dropin_dir/50-swapz-no-hibernate.conf
	hibernate_temporary=$hibernate_dropin.tmp.$$
	( set -C; : > "$hibernate_temporary" ) 2>/dev/null || {
		echo "swapz-primary-generator: cannot create hibernation drop-in" >&2
		exit 1
	}
	printf '[Service]\nExecStartPre=@SWAPZ_SBINDIR@/swapz-primary-runtime-health hibernate-guard\n' > "$hibernate_temporary"
	chmod 0644 "$hibernate_temporary"
	mv -fT -- "$hibernate_temporary" "$hibernate_dropin"
	hibernate_temporary=
done
trap - EXIT HUP INT TERM

# swapzctl owns selector parsing, root-ownership checks, PARTUUID normalization,
# and escaping. The generator must never infer or substitute a target itself.
units=$("@SWAPZ_SBINDIR@/swapzctl" primary systemd-units) || {
	echo "swapz-primary-generator: selected target is unavailable or invalid" >&2
	exit 1
}
case "$units" in
*'
'*)
	echo "swapz-primary-generator: malformed unit response" >&2
	exit 1
	;;
esac
set -f
old_ifs=$IFS
IFS=' '
# shellcheck disable=SC2086 # Intentional strict split; exact reconstruction follows.
set -- $units
IFS=$old_ifs
if [ "$#" -ne 2 ] || [ "$1 $2" != "$units" ]; then
	echo "swapz-primary-generator: malformed unit response" >&2
	exit 1
fi
device_unit=$1
swap_unit=$2

case "$device_unit" in
'dev-disk-by\x2dpartuuid-'*.device) ;;
*)
	echo "swapz-primary-generator: invalid selected device unit" >&2
	exit 1
	;;
esac
case "$swap_unit" in
'dev-disk-by\x2dpartuuid-'*.swap) ;;
*)
	echo "swapz-primary-generator: invalid selected raw-swap unit" >&2
	exit 1
	;;
esac
encoded_device=${device_unit#'dev-disk-by\x2dpartuuid-'}
encoded_device=${encoded_device%.device}
encoded_swap=${swap_unit#'dev-disk-by\x2dpartuuid-'}
encoded_swap=${encoded_swap%.swap}
[ "$encoded_device" = "$encoded_swap" ] || {
	echo "swapz-primary-generator: selected unit identities disagree" >&2
	exit 1
}

valid_encoded_partuuid()
{
	value=$1
	decoded_length=0
	hex_digit_count=0
	previous_was_hyphen=1
	while [ -n "$value" ]; do
		case "$value" in
		'\x2d'*)
			[ "$previous_was_hyphen" -eq 0 ] || return 1
			value=${value#'\x2d'}
			decoded_length=$((decoded_length + 1))
			previous_was_hyphen=1
			;;
		[0-9a-f]*)
			value=${value#?}
			decoded_length=$((decoded_length + 1))
			hex_digit_count=$((hex_digit_count + 1))
			previous_was_hyphen=0
			;;
		*)
			return 1
			;;
		esac
		[ "$decoded_length" -le 64 ] || return 1
	done
	# Match the protected selector grammar, not merely the decoded length.
	[ "$decoded_length" -ge 8 ] && [ "$hex_digit_count" -ge 8 ] &&
		[ "$previous_was_hyphen" -eq 0 ]
}
valid_encoded_partuuid "$encoded_device" || {
	echo "swapz-primary-generator: invalid escaped PARTUUID" >&2
	exit 1
}

# The mapper job spans bounded mapper start and, on shutdown, can include
# swapoff followed by mapper teardown. Allow both 120s phases plus slack.
# A mapper job timeout alone cannot bound the separate .device job queued by
# Requires=, so cap that exact udev device job independently at 30s.
mapper_dropin_dir=$normal_dir/swapz-primary-mapper.service.d
device_dropin_dir=$normal_dir/$device_unit.d
for dropin_dir in "$mapper_dropin_dir" "$device_dropin_dir"; do
	if [ -L "$dropin_dir" ]; then
		echo "swapz-primary-generator: refusing symlinked drop-in directory" >&2
		exit 1
	fi
	mkdir -p -- "$dropin_dir"
	if [ ! -d "$dropin_dir" ] || [ -L "$dropin_dir" ]; then
		echo "swapz-primary-generator: cannot create safe drop-in directory" >&2
		exit 1
	fi
done

mapper_dropin=$mapper_dropin_dir/50-selected-target.conf
device_dropin=$device_dropin_dir/50-swapz-timeout.conf
mapper_temporary=$mapper_dropin.tmp.$$
device_temporary=$device_dropin.tmp.$$
cleanup()
{
	rm -f -- "$mapper_temporary" "$device_temporary"
}
trap cleanup EXIT HUP INT TERM
( set -C; : > "$mapper_temporary" && : > "$device_temporary" ) 2>/dev/null || {
	echo "swapz-primary-generator: cannot create drop-in" >&2
	exit 1
}
printf '[Unit]\nRequires=%s\nAfter=%s\nConflicts=%s\nBefore=%s\nJobTimeoutSec=300s\nJobTimeoutAction=none\n' \
	"$device_unit" "$device_unit" "$swap_unit" "$swap_unit" > "$mapper_temporary"
printf '[Unit]\nJobTimeoutSec=30s\nJobTimeoutAction=none\n' > "$device_temporary"
chmod 0644 "$mapper_temporary" "$device_temporary"
mv -fT -- "$device_temporary" "$device_dropin"
mv -fT -- "$mapper_temporary" "$mapper_dropin"
trap - EXIT HUP INT TERM
exit 0
