		expected_module_sha=$(arm_field expected_module_sha256 2>/dev/null || printf 'unavailable')
		expected_source_sha=$(arm_field expected_module_source_sha 2>/dev/null || printf 'unavailable')
		if valid_boot_id "$boot_id" 2>/dev/null && valid_boot_id "$armed_boot_id" 2>/dev/null; then
			if [ "$boot_id" != "$armed_boot_id" ]; then
				cold_boot_observed=yes
				observation_expected=1
				[ "$kernel_release" = "$expected_kernel_release" ] || append_failure kernel_release_mismatch
			else
				append_incomplete owner_reboot_not_observed
			fi
		else
			append_incomplete arm_record_invalid
		fi
