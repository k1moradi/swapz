#!/bin/sh
# Arm, gate, and persist cold-boot observations for the primary swapz mapping.
set -eu
umask 077

usage()
{
	echo "Usage: swapz-primary-boot-verify arm|preflight|observe" >&2
	exit 2
}

[ "$#" -eq 1 ] || usage
mode=$1
case "$mode" in
arm|preflight|observe) ;;
*) usage ;;
esac

self_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
prefix_dir=$(dirname -- "$self_dir")
swapzctl=$self_dir/swapzctl
runtime_health=$self_dir/swapz-primary-runtime-health
module_artifact=$prefix_dir/libexec/swapz/dm-swapz.ko
proc_root=/proc
sys_root=/sys
dev_root=/dev
report_base=/var/lib/swapz/boot-acceptance
expected_uid=0

# Isolated rootless regression fixtures override only observation roots and the
# installed module path. Production systemd units never set this marker.
if [ "${SWAPZ_PRIMARY_SYSTEMD_TESTING:-0}" = 1 ]; then
	proc_root=${SWAPZ_PRIMARY_TEST_PROC_ROOT:?missing test proc root}
	sys_root=${SWAPZ_PRIMARY_TEST_SYS_ROOT:?missing test sys root}
	dev_root=${SWAPZ_PRIMARY_TEST_DEV_ROOT:?missing test dev root}
	report_base=${SWAPZ_PRIMARY_TEST_REPORT_BASE:?missing test report base}
	module_artifact=${SWAPZ_PRIMARY_TEST_MODULE_ARTIFACT:?missing test module artifact}
	expected_uid=$(id -u)
fi

recovery_base=/var/lib/swapz/physical-recovery
runtime_base=/run/swapz
if [ "${SWAPZ_PRIMARY_SYSTEMD_TESTING:-0}" = 1 ]; then
	recovery_base=${SWAPZ_PRIMARY_TEST_RECOVERY_BASE:?missing test recovery base}
	runtime_base=$report_base/runtime
fi
arm_file=$report_base/armed.env
runtime_enable_file=$runtime_base/primary-execution.env
mapper_swap_unit='dev-mapper-swapz\x2dprimary.swap'
mapper_service=swapz-primary-mapper.service
mapper_path=$dev_root/mapper/swapz-primary
failure_reasons=
incomplete_reasons=

fail()
{
	echo "swapz-primary-boot-verify: $*" >&2
	exit 1
}

append_failure()
{
	if [ -n "$failure_reasons" ]; then
		failure_reasons=$failure_reasons,$1
	else
		failure_reasons=$1
	fi
}

append_incomplete()
{
	if [ -n "$incomplete_reasons" ]; then
		incomplete_reasons=$incomplete_reasons,$1
	else
		incomplete_reasons=$1
	fi
}

require_command()
{
	command -v "$1" >/dev/null 2>&1 || fail "required command is unavailable: $1"
}

single_line_file()
{
	file=$1
	[ -f "$file" ] || return 1
	value=$(cat -- "$file") || return 1
	case "$value" in
	*'
'*) return 1 ;;
	esac
	[ -n "$value" ] || return 1
	printf '%s\n' "$value"
}

valid_boot_id()
{
	printf '%s\n' "$1" | grep -Eq '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'
}

valid_partuuid()
{
	value=$1
	length=${#value}
	[ "$length" -ge 8 ] && [ "$length" -le 64 ] || return 1
	printf '%s\n' "$value" | grep -Eq '^[0-9a-f]+(-[0-9a-f]+)*$'
}

current_boot_id()
{
	value=$(single_line_file "$proc_root/sys/kernel/random/boot_id") || return 1
	valid_boot_id "$value" || return 1
	printf '%s\n' "$value"
}

secure_report_directory()
{
	if [ "${SWAPZ_PRIMARY_SYSTEMD_TESTING:-0}" = 1 ]; then
		[ ! -L "$report_base" ] || fail "test report directory is a symlink"
		mkdir -p -- "$report_base"
		# Fixture metadata must not be silently repaired before validation.
	else
		[ "$(id -u)" -eq 0 ] || fail "root privileges are required"
		parent=/var/lib/swapz
		[ ! -L "$parent" ] || fail "$parent must not be a symlink"
		if [ ! -e "$parent" ]; then
			mkdir -m 0755 -- "$parent" || fail "cannot create $parent"
		fi
		[ -d "$parent" ] || fail "$parent is not a directory"
		owner=$(stat -c '%u' -- "$parent") || fail "cannot inspect $parent"
		permissions=$(stat -c '%a' -- "$parent") || fail "cannot inspect $parent permissions"
		[ "$owner" -eq 0 ] || fail "$parent is not root-owned"
		case "$permissions" in
		[0-7][0145][0145]) ;;
		*) fail "$parent is group/world writable or has unexpected permissions" ;;
		esac
		[ ! -L "$report_base" ] || fail "$report_base must not be a symlink"
		if [ ! -e "$report_base" ]; then
			mkdir -m 0700 -- "$report_base" || fail "cannot create $report_base"
		fi
	fi
	[ -d "$report_base" ] || fail "$report_base is not a directory"
	owner=$(stat -c '%u' -- "$report_base") || fail "cannot inspect report directory"
	permissions=$(stat -c '%a' -- "$report_base") || fail "cannot inspect report directory permissions"
	[ "$owner" -eq "$expected_uid" ] || fail "report directory has unexpected owner"
	[ "$permissions" = 700 ] || fail "report directory mode must be 0700"
}

commit_file()
{
	temporary=$1
	destination=$2
	# Never follow or replace unsafe pre-existing evidence paths.
	if [ -e "$destination" ] || [ -L "$destination" ]; then
		if [ ! -f "$destination" ] || [ -L "$destination" ] ||
		   [ "$(stat -c '%u' -- "$destination")" != "$expected_uid" ] ||
		   [ "$(stat -c '%a' -- "$destination")" != 600 ] ||
		   [ "$(stat -c '%h' -- "$destination")" != 1 ]; then
			rm -f -- "$temporary"
			fail "unsafe evidence destination: $destination"
		fi
	fi
	chmod 0600 "$temporary"
	sync -f "$temporary"
	mv -fT -- "$temporary" "$destination"
	sync -f "$report_base"
}


secure_runtime_directory()
{
	if [ "${SWAPZ_PRIMARY_SYSTEMD_TESTING:-0}" != 1 ]; then
		[ "$(id -u)" -eq 0 ] || fail "root privileges are required"
	fi
	[ -e "$runtime_base" ] || mkdir -m 0700 -- "$runtime_base" ||
		fail "cannot create primary runtime directory"
	[ -d "$runtime_base" ] && [ ! -L "$runtime_base" ] ||
		fail "primary runtime directory is unavailable or symlinked"
	owner=$(stat -c '%u' -- "$runtime_base") ||
		fail "cannot inspect primary runtime directory owner"
	permissions=$(stat -c '%a' -- "$runtime_base") ||
		fail "cannot inspect primary runtime directory permissions"
	[ "$owner" -eq "$expected_uid" ] && [ "$permissions" = 700 ] ||
		fail "primary runtime directory must be owned mode 0700"
}

clear_runtime_authorization()
{
	secure_runtime_directory
	rm -f -- "$runtime_enable_file"
	sync -f "$runtime_base"
}

commit_runtime_authorization()
{
	boot_id=$1
	source_sha=$2
	partuuid=$3
	target_size=$4
	target_device=$5
	temporary=$(mktemp "$runtime_base/.primary-execution.XXXXXX") ||
		fail "cannot create runtime authorization temporary"
	cat > "$temporary" <<AUTH
schema=swapz-primary-execution-v2
boot_id=$boot_id
source_sha=$source_sha
partuuid=$partuuid
target_device=$target_device
target_size_bytes=$target_size
AUTH
	chmod 0600 "$temporary"
	sync -f "$temporary"
	mv -f -- "$temporary" "$runtime_enable_file"
	sync -f "$runtime_base"
}

validate_arm_file()
{
	[ -f "$arm_file" ] && [ ! -L "$arm_file" ] || return 1
	owner=$(stat -c '%u' -- "$arm_file") || return 1
	permissions=$(stat -c '%a' -- "$arm_file") || return 1
	links=$(stat -c '%h' -- "$arm_file") || return 1
	[ "$owner" -eq "$expected_uid" ] && [ "$permissions" = 600 ] &&
		[ "$links" -eq 1 ] && [ "$(stat -c '%s' -- "$arm_file")" -le 4096 ] || return 1
	# The arm record is complete and ordered; missing, duplicated, unexpected,
	# empty, or rearranged fields never authorize a cold boot.
	LC_ALL=C awk '
		BEGIN { count = split("schema arm_boot_id arm_kernel_release armed_epoch expected_partuuid expected_target_size_bytes expected_target_model expected_target_serial expected_target_wwn expected_target_transport expected_target_removable expected_module_sha256 expected_module_source_sha expected_module_source_clean", keys, " ") }
		NR > count { invalid = 1; next }
		{
			prefix = keys[NR] "="
			if (index($0, prefix) != 1 || length($0) <= length(prefix))
				invalid = 1
		}
		END { if (invalid || NR != count) exit 1 }
	' "$arm_file"
}

arm_field()
{
	key=$1
	awk -v wanted="$key" '
		BEGIN { count = 0 }
		index($0, wanted "=") == 1 {
			count++
			value = substr($0, length(wanted) + 2)
		}
		END {
			if (count != 1) exit 2
			print value
		}
	' "$arm_file"
}

identity_attribute()
{
	# lsblk strings can originate in removable-reader firmware. Strip control
	# characters, delimiters and cap their size before saving them as evidence.
	attribute=$(printf '%s' "$1" | LC_ALL=C tr '\r\n\t=' '    ' | LC_ALL=C tr -cd '[:print:]') || return 1
	[ "${#attribute}" -le 128 ] || return 1
	[ -n "$attribute" ] || attribute=unavailable
	printf '%s\n' "$attribute"
}

manager_target_identity()
{
	units=$("$swapzctl" primary systemd-units) || return 1
	case "$units" in
	*'
'*) return 1 ;;
	esac
	set -f
	old_ifs=$IFS
	IFS=' '
	# shellcheck disable=SC2086 # Strict split is checked by exact reconstruction.
	set -- $units
	IFS=$old_ifs
	[ "$#" -eq 2 ] && [ "$1 $2" = "$units" ] || return 1
	selected_device_unit=$1
	selected_raw_swap_unit=$2
	case "$selected_device_unit" in
	'dev-disk-by\x2dpartuuid-'*.device) ;;
	*) return 1 ;;
	esac
	case "$selected_raw_swap_unit" in
	'dev-disk-by\x2dpartuuid-'*.swap) ;;
	*) return 1 ;;
	esac
	encoded=${selected_device_unit#'dev-disk-by\x2dpartuuid-'}
	encoded=${encoded%.device}
	raw_encoded=${selected_raw_swap_unit#'dev-disk-by\x2dpartuuid-'}
	raw_encoded=${raw_encoded%.swap}
	[ "$encoded" = "$raw_encoded" ] || return 1
	selected_partuuid=$(printf '%s\n' "$encoded" | sed 's/\\x2d/-/g')
	valid_partuuid "$selected_partuuid" || return 1
	selected_path=$dev_root/disk/by-partuuid/$selected_partuuid
	return 0
}

target_identity()
{
	[ -e "$selected_path" ] || return 1
	target_type=$(lsblk -dnro TYPE -- "$selected_path" 2>/dev/null) || return 1
	[ "$target_type" = part ] || return 1
	target_major_minor=$(lsblk -dnro MAJ:MIN -- "$selected_path" 2>/dev/null) || return 1
	printf '%s\n' "$target_major_minor" | grep -Eq '^[0-9]+:[0-9]+$' || return 1
	target_size_bytes=$(blockdev --getsize64 "$selected_path" 2>/dev/null) || return 1
	printf '%s\n' "$target_size_bytes" | grep -Eq '^[1-9][0-9]*$' || return 1
	target_parent=$(lsblk -dnro PKNAME -- "$selected_path" 2>/dev/null || true)
	target_parent=$(printf '%s' "$target_parent" | tr '\n\r\t' '   ')
	target_model=unavailable
	target_serial=unavailable
	target_wwn=unavailable
	target_transport=unavailable
	target_removable=unavailable
	case "$target_parent" in
	''|*[!A-Za-z0-9._-]*) ;;
	*)
		parent_path=$dev_root/$target_parent
		target_model=$(lsblk -dnro MODEL -- "$parent_path" 2>/dev/null || true)
		target_serial=$(lsblk -dnro SERIAL -- "$parent_path" 2>/dev/null || true)
		target_wwn=$(lsblk -dnro WWN -- "$parent_path" 2>/dev/null || true)
		target_transport=$(lsblk -dnro TRAN -- "$parent_path" 2>/dev/null || true)
		target_removable=$(lsblk -dnro RM -- "$parent_path" 2>/dev/null || true)
		# Never evaluate reader-provided metadata as shell source. Keep one
		# bounded, printable line per attribute for the persistent arm record.
		target_model=$(identity_attribute "$target_model") || return 1
		target_serial=$(identity_attribute "$target_serial") || return 1
		target_wwn=$(identity_attribute "$target_wwn") || return 1
		target_transport=$(identity_attribute "$target_transport") || return 1
		target_removable=$(identity_attribute "$target_removable") || return 1
		;;
	esac
	return 0
}

module_artifact_metadata()
{
	[ -f "$module_artifact" ] && [ ! -L "$module_artifact" ] || return 1
	module_sha256=$(sha256sum -- "$module_artifact" 2>/dev/null | awk '{print $1}') || return 1
	printf '%s\n' "$module_sha256" | grep -Eq '^[0-9a-f]{64}$' || return 1
	module_source_sha=$(modinfo -F swapz_build_source_sha "$module_artifact" 2>/dev/null) || return 1
	module_source_clean=$(modinfo -F swapz_build_source_clean "$module_artifact" 2>/dev/null) || return 1
	case "$module_source_sha" in *'
'*|'') return 1 ;; esac
	case "$module_source_clean" in *'
'*|'') return 1 ;; esac
	printf '%s\n' "$module_source_sha" | grep -Eq '^[0-9a-f]{40}$' || return 1
	[ "$module_source_clean" = 1 ] || return 1
	return 0
}

path_major_minor()
{
	candidate=$1
	[ -n "$candidate" ] || return 1
	value=$(lsblk -dnro MAJ:MIN -- "$candidate" 2>/dev/null) || return 1
	case "$value" in *'
'*|'') return 1 ;; esac
	printf '%s\n' "$value" | grep -Eq '^[0-9]+:[0-9]+$' || return 1
	printf '%s\n' "$value"
}

device_like_swap_source()
{
	case "$1" in
	"$dev_root"/*|UUID=*|PARTUUID=*|LABEL=*|PARTLABEL=*) return 0 ;;
	*) return 1 ;;
	esac
}

raw_swap_alias_guard()
{
	# The stable by-PARTUUID unit is handled by the generator's Conflicts=. This
	# identity scan closes by-UUID/by-id/by-path/plain-device aliases without
	# ever stopping or modifying an unrelated swap area.
	# No second unit may activate this mapper through a different pathname.
	# Prior to mapper creation its block identity may be absent; the literal
	# canonical path is rejected independently below.
	mapper_alias_major_minor=$(path_major_minor "$mapper_path" 2>/dev/null || true)
	proc_swaps=$proc_root/swaps
	[ -r "$proc_swaps" ] || return 1
	active_sources=$(mktemp "$report_base/.active-sources.XXXXXX") || return 1
	if ! awk 'NR > 1 { print $1 }' "$proc_swaps" > "$active_sources"; then
		rm -f -- "$active_sources"
		return 1
	fi
	while IFS= read -r source; do
		[ -n "$source" ] || continue
		major_minor=$(path_major_minor "$source" 2>/dev/null || true)
		if [ "$major_minor" = "$target_major_minor" ]; then
			echo "swapz-primary-boot-verify: selected partition is already active as raw swap: $source" >&2
			rm -f -- "$active_sources"
			return 1
		fi
		if [ -z "$major_minor" ] && device_like_swap_source "$source"; then
			echo "swapz-primary-boot-verify: unresolved active block-device swap prevents alias proof: $source" >&2
			rm -f -- "$active_sources"
			return 1
		fi
	done < "$active_sources"
	rm -f -- "$active_sources"

	fstab_sources=$(mktemp "$report_base/.fstab-sources.XXXXXX") || return 1
	fstab_errors=$(mktemp "$report_base/.fstab-errors.XXXXXX") || {
		rm -f -- "$fstab_sources"
		return 1
	}
	if findmnt --fstab --types swap --evaluate --noheadings --output SOURCE \
		>"$fstab_sources" 2>"$fstab_errors"; then
		:
	else
		findmnt_status=$?
		if [ "$findmnt_status" -ne 1 ] || [ -s "$fstab_errors" ]; then
			cat "$fstab_errors" >&2
			rm -f -- "$fstab_sources" "$fstab_errors"
			return 1
		fi
	fi
	while IFS= read -r source; do
		[ -n "$source" ] || continue
		major_minor=$(path_major_minor "$source" 2>/dev/null || true)
		if [ "$major_minor" = "$target_major_minor" ]; then
			echo "swapz-primary-boot-verify: fstab still configures selected partition as raw swap: $source" >&2
			rm -f -- "$fstab_sources" "$fstab_errors"
			return 1
		fi
		if [ "$source" = "$mapper_path" ] || { [ -n "$mapper_alias_major_minor" ] && [ "$major_minor" = "$mapper_alias_major_minor" ]; }; then
			echo "swapz-primary-boot-verify: fstab configures duplicate mapper swap activation: $source" >&2
			rm -f -- "$fstab_sources" "$fstab_errors"
			return 1
		fi
		if [ -z "$major_minor" ] && device_like_swap_source "$source"; then
			echo "swapz-primary-boot-verify: unresolved fstab block-device swap source prevents alias proof: $source" >&2
			rm -f -- "$fstab_sources" "$fstab_errors"
			return 1
		fi
	done < "$fstab_sources"
	rm -f -- "$fstab_sources" "$fstab_errors"

	loaded_swaps=$(mktemp "$report_base/.loaded-swaps.XXXXXX") || return 1
	if ! systemctl list-units --type=swap --all --plain --no-legend --no-pager \
		>"$loaded_swaps" 2>/dev/null; then
		rm -f -- "$loaded_swaps"
		return 1
	fi
	while IFS=' ' read -r unit _rest; do
		[ -n "$unit" ] || continue
		[ "$unit" = "$mapper_swap_unit" ] && continue
		if ! what=$(systemctl show --property=What --value "$unit" 2>/dev/null); then
			echo "swapz-primary-boot-verify: cannot inspect loaded swap unit: $unit" >&2
			rm -f -- "$loaded_swaps"
			return 1
		fi
		case "$what" in
		*'
'*|'')
			echo "swapz-primary-boot-verify: ambiguous What= of loaded swap unit: $unit" >&2
			rm -f -- "$loaded_swaps"
			return 1
			;;
		esac
		major_minor=$(path_major_minor "$what" 2>/dev/null || true)
		if [ "$major_minor" = "$target_major_minor" ]; then
			echo "swapz-primary-boot-verify: loaded raw swap unit aliases selected partition: $unit ($what)" >&2
			rm -f -- "$loaded_swaps"
			return 1
		fi
		if [ "$what" = "$mapper_path" ] || { [ -n "$mapper_alias_major_minor" ] && [ "$major_minor" = "$mapper_alias_major_minor" ]; }; then
			echo "swapz-primary-boot-verify: loaded swap unit duplicates primary mapper activation: $unit ($what)" >&2
			rm -f -- "$loaded_swaps"
			return 1
		fi
		if [ -z "$major_minor" ] && device_like_swap_source "$what"; then
			echo "swapz-primary-boot-verify: unresolved loaded block-device swap source prevents alias proof: $unit ($what)" >&2
			rm -f -- "$loaded_swaps"
			return 1
		fi
	done < "$loaded_swaps"
	rm -f -- "$loaded_swaps"
	return 0
}

valid_primary_record()
{
	# Match the manager's 0600, root-owned, single-link recovery records.
	[ -f "$1" ] && [ ! -L "$1" ] || return 1
	[ "$(stat -c '%u' -- "$1")" -eq "$expected_uid" ] || return 1
	[ "$(stat -c '%a' -- "$1")" = 600 ] || return 1
	[ "$(stat -c '%h' -- "$1")" -eq 1 ] || return 1
	[ "$(stat -c '%s' -- "$1")" -le 4096 ] || return 1
}

active_transaction_run_id()
{
	# This is an observer-only consistency check. The manager performs full
	# transaction parsing and enforces immutable ownership at every mutation.
	state=$recovery_base/primary-state.json
	valid_primary_record "$state" || return 1
	state_record=$(cat -- "$state") || return 1
	run_id=$(printf '%s\n' "$state_record" | sed -nE \
		's/^\{"schema":"swapz-primary-state-v1","run_id":"([0-9a-f]{32})","stage":"ACTIVE","recovery_previous_stage":null\}$/\1/p')
	[ "${#run_id}" -eq 32 ] || return 1
	[ "$(printf '%s\n' "$state_record" | wc -l)" -eq 1 ] || return 1
	[ "$selected_partuuid" != unavailable ] && [ "$target_major_minor" != unavailable ] || return 1
	major=${target_major_minor%:*}
	minor=${target_major_minor#*:}
	expected_claim=$(printf '{"major":%s,"minor":%s,"partuuid":"%s","run_id":"%s"}' \
		"$major" "$minor" "$selected_partuuid" "$run_id")
	for record in "$recovery_base/partition-$selected_partuuid.active" \
		"$recovery_base/consumed-$run_id.json"; do
		valid_primary_record "$record" || return 1
		[ "$(cat -- "$record")" = "$expected_claim" ] || return 1
	done
	printf '%s\n' "$run_id"
}

hibernation_resume_guard()
{
	[ -x "$runtime_health" ] || {
		echo "swapz-primary-boot-verify: runtime health helper is unavailable" >&2
		return 1
	}
	"$runtime_health" hibernation-config-check
}

verify_persistent_report_storage()
{
	# The manager already proves that its recovery filesystem is persistent and
	# belongs to a different physical disk from the selected SD card. Keep the
	# boot evidence on that *same filesystem* rather than trusting a pathname
	# that might itself be a mount over the disposable card or a tmpfs.
	if [ "${SWAPZ_PRIMARY_SYSTEMD_TESTING:-0}" != 1 ]; then
		[ -d "$recovery_base" ] && [ ! -L "$recovery_base" ] ||
			fail "primary recovery directory is unavailable or symlinked"
		report_filesystem=$(stat -c '%d' -- "$report_base") ||
			fail "cannot identify report filesystem"
		recovery_filesystem=$(stat -c '%d' -- "$recovery_base") ||
			fail "cannot identify recovery filesystem"
		[ "$report_filesystem" = "$recovery_filesystem" ] ||
			fail "boot evidence is not on the qualified recovery filesystem"
	fi

	# primary plan is deliberately a read-only BLOCKED report today, so its
	# documented success path exits 2 after emitting complete JSON. Accept
	# only that bounded status (or a future ordinary success status 0) and
	# still require the exact persistence proof from the payload.
	plan_status=0
	plan=$("$swapzctl" primary plan) || plan_status=$?
	case "$plan_status" in
	0|2) ;;
	*) fail "cannot query read-only recovery storage plan" ;;
	esac
	case "$plan" in
	*'"schema":"swapz-primary-plan-v1"'*'"recovery_preflight_read":true'*'"recovery_filesystem_supported":true'*'"recovery_directly_not_target":true'*'"recovery_source_chain_checked":true'*'"recovery_same_physical_disk_as_target":false'*) ;;
	*) fail "read-only plan cannot prove recovery and boot evidence are persistent and outside the selected SD card" ;;
	esac
}

arm_harness()
{
	secure_report_directory
	for command_name in grep sed awk stat sync lsblk blockdev sha256sum modinfo findmnt systemctl uname date; do
		require_command "$command_name"
	done
	[ -x "$swapzctl" ] || fail "installed swapzctl is unavailable"
	boot_id=$(current_boot_id) || fail "cannot read a valid boot ID"
	kernel_release=$(uname -r) || fail "cannot read kernel release"
	manager_target_identity || fail "protected primary selector is invalid"
	target_identity || fail "selected PARTUUID device is unavailable or invalid"
	[ "$target_removable" = 1 ] || fail "selected target parent is not reported as removable"
	# A removable reader's model alone does not identify the selected parent.
	[ "$target_serial" != unavailable ] || [ "$target_wwn" != unavailable ] || \
		fail "selected target parent has neither a stable serial nor WWN"
	verify_persistent_report_storage
	raw_swap_alias_guard || fail "selected partition has a raw-swap alias conflict or alias inventory is unavailable"
	hibernation_resume_guard || fail "unsupported hibernation/resume configuration selects swapz"
	module_artifact_metadata || fail "installed module provenance is unavailable or unqualified"

	temporary=$(mktemp "$report_base/.armed.env.XXXXXX") || fail "cannot create arm record"
	cat > "$temporary" <<ARM
schema=swapz-primary-boot-arm-v1
arm_boot_id=$boot_id
arm_kernel_release=$kernel_release
armed_epoch=$(date +%s)
expected_partuuid=$selected_partuuid
expected_target_size_bytes=$target_size_bytes
expected_target_model=$target_model
expected_target_serial=$target_serial
expected_target_wwn=$target_wwn
expected_target_transport=$target_transport
expected_target_removable=$target_removable
expected_module_sha256=$module_sha256
expected_module_source_sha=$module_source_sha
expected_module_source_clean=$module_source_clean
ARM
	commit_file "$temporary" "$arm_file"
	printf 'COLD_BOOT_HARNESS=ARMED arm_boot_id=%s partuuid=%s module_source=%s COLD_BOOT_OBSERVED=NO\n' \
		"$boot_id" "$selected_partuuid" "$module_source_sha"
}

preflight_boot()
{
	secure_report_directory
	# Any failed or repeated preflight must remove an earlier authorization
	# before evaluating current boot/source/target facts.
	clear_runtime_authorization
	for command_name in grep sed awk stat sync lsblk blockdev sha256sum modinfo findmnt systemctl uname; do
		require_command "$command_name"
	done
	[ -x "$swapzctl" ] || fail "installed swapzctl is unavailable"
	validate_arm_file || fail "cold-boot harness is not securely armed"
	[ "$(arm_field schema)" = swapz-primary-boot-arm-v1 ] || fail "invalid arm-record schema"
	armed_boot_id=$(arm_field arm_boot_id) || fail "arm record lacks boot ID"
	valid_boot_id "$armed_boot_id" || fail "arm record contains invalid boot ID"
	boot_id=$(current_boot_id) || fail "cannot read a valid boot ID"
	[ "$boot_id" != "$armed_boot_id" ] || fail "owner reboot has not occurred since the cold-boot harness was armed"
	expected_kernel_release=$(arm_field arm_kernel_release) || fail "arm record lacks kernel release"
	expected_partuuid=$(arm_field expected_partuuid) || fail "arm record lacks PARTUUID"
	expected_size=$(arm_field expected_target_size_bytes) || fail "arm record lacks target size"
	expected_model=$(arm_field expected_target_model) || fail "arm record lacks target model"
	expected_serial=$(arm_field expected_target_serial) || fail "arm record lacks target serial"
	expected_wwn=$(arm_field expected_target_wwn) || fail "arm record lacks target WWN"
	expected_transport=$(arm_field expected_target_transport) || fail "arm record lacks target transport"
	expected_removable=$(arm_field expected_target_removable) || fail "arm record lacks removable marker"
	expected_module_sha=$(arm_field expected_module_sha256) || fail "arm record lacks module hash"
	expected_source_sha=$(arm_field expected_module_source_sha) || fail "arm record lacks source provenance"
	expected_source_clean=$(arm_field expected_module_source_clean) || fail "arm record lacks clean-source marker"
	current_kernel_release=$(uname -r) || fail "cannot read kernel release after reboot"
	[ "$current_kernel_release" = "$expected_kernel_release" ] || fail "kernel release changed after arming"
	manager_target_identity || fail "protected primary selector is invalid after reboot"
	[ "$selected_partuuid" = "$expected_partuuid" ] || fail "selected PARTUUID changed after arming"
	target_identity || fail "selected PARTUUID device is unavailable after reboot"
	[ "$target_size_bytes" = "$expected_size" ] || fail "selected target size changed after arming"
	[ "$target_removable" = 1 ] || fail "selected target parent is no longer reported as removable"
	# The parent device name (sda/sdb) may change on reboot; bind instead
	# to the stable reader attributes recorded during arming.
	[ "$expected_serial" != unavailable ] || [ "$expected_wwn" != unavailable ] || \
		fail "arm record lacks stable selected-parent identity"
	[ "$expected_removable" = 1 ] || fail "arm record lacks removable-parent identity"
	[ "$target_model" = "$expected_model" ] || fail "selected target model changed after arming"
	[ "$target_serial" = "$expected_serial" ] || fail "selected target serial changed after arming"
	[ "$target_wwn" = "$expected_wwn" ] || fail "selected target WWN changed after arming"
	[ "$target_transport" = "$expected_transport" ] || fail "selected target transport changed after arming"
	[ "$target_removable" = "$expected_removable" ] || fail "selected target removable marker changed after arming"
	verify_persistent_report_storage
	raw_swap_alias_guard || fail "selected partition has a raw-swap alias conflict or alias inventory is unavailable"
	hibernation_resume_guard || fail "unsupported hibernation/resume configuration selects swapz"
	module_artifact_metadata || fail "installed module provenance cannot be verified after reboot"
	[ "$module_sha256" = "$expected_module_sha" ] || fail "installed module bytes changed after arming"
	[ "$module_source_sha" = "$expected_source_sha" ] || fail "installed module source changed after arming"
	[ "$module_source_clean" = "$expected_source_clean" ] || fail "installed module clean marker changed after arming"
	commit_runtime_authorization \
		"$boot_id" "$expected_source_sha" "$selected_partuuid" \
		"$target_size_bytes" "$target_major_minor"
	printf 'PRIMARY_BOOT_PREFLIGHT=PASS boot_id=%s armed_boot_id=%s partuuid=%s\n' \
		"$boot_id" "$armed_boot_id" "$selected_partuuid"
}

maximum_logical_sectors()
{
	device_bytes=$1
	printf '%s\n' "$device_bytes" | grep -Eq '^[1-9][0-9]*$' || return 1
	[ "${#device_bytes}" -le 18 ] || return 1
	[ $((device_bytes % 4096)) -eq 0 ] || return 1
	blocks=$((device_bytes / 4096))
	[ "$blocks" -gt 1 ] || return 1
	physical_blocks=$((((blocks - 1) / 256) * 256))
	[ "$physical_blocks" -gt 0 ] || return 1
	# Production authority indexes physical blocks with swapz_u32.
	[ "$physical_blocks" -le 4294967295 ] || return 1
	low=0
	high=$physical_blocks
	while [ "$low" -lt "$high" ]; do
		candidate=$((low + (high - low + 1) / 2))
		reserve=$(((candidate + 7) / 8))
		[ "$reserve" -ge 512 ] || reserve=512
		if [ "$reserve" -ge "$physical_blocks" ]; then
			fits=0
		else
			data_blocks=$((((physical_blocks - reserve) / 256) * 256))
			# GC reserve is not foreground allocation authority. Keep one
			# independent 256-block segment for the first all-RAW COW write.
			if [ "$data_blocks" -ge 256 ] &&
			   [ "$candidate" -le "$((data_blocks - 256))" ]; then
				fits=1
			else
				fits=0
			fi
		fi
		if [ "$fits" -eq 1 ]; then
			low=$candidate
		else
			high=$((candidate - 1))
		fi
	done
	[ "$low" -gt 0 ] || return 1
	printf '%s\n' $((low * 8))
}

canonical_status_error()
{
	value=$1
	case "$value" in
	0) return 0 ;;
	-*) magnitude=$(printf '%s' "$value" | cut -c2-); limit=2147483648 ;;
	*) magnitude=$value; limit=2147483647 ;;
	esac
	printf '%s\n' "$magnitude" | grep -Eq '^[1-9][0-9]{0,9}$' || return 1
	[ "$(printf '%s' "$magnitude" | wc -c)" -lt 10 ] || [ "$magnitude" -le "$limit" ]
}

status_token()
{
	key=$1
	text=$2
	printf '%s\n' "$text" | awk -v wanted="$key" '
		{
			for (position = 1; position <= NF; ++position) {
				if (index($position, wanted "=") != 1)
					continue
				value = substr($position, length(wanted) + 2)
				if (seen || value == "" || index(value, "=") != 0)
					invalid = 1
				else { result = value; seen = 1 }
			}
		}
		END {
			if (invalid) print "invalid"
			else if (seen) print result
		}
	'
}

observe_boot()
{
