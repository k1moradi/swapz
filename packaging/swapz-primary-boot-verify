	fi

	selected_partuuid=unavailable
	selected_path=unavailable
	target_major_minor=unavailable
	target_size_bytes=unavailable
	target_parent=unavailable
	target_model=unavailable
	target_serial=unavailable
	target_wwn=unavailable
	target_transport=unavailable
	target_removable=unavailable
	if [ -x "$swapzctl" ] && manager_target_identity && target_identity; then
		if [ "$observation_expected" -eq 1 ]; then
			[ "$selected_partuuid" = "$expected_partuuid" ] || append_failure selected_partuuid_mismatch
			[ "$target_size_bytes" = "$expected_target_size" ] || append_failure selected_target_size_mismatch
			[ "$expected_target_serial" != unavailable ] || [ "$expected_target_wwn" != unavailable ] || append_failure armed_parent_identity_unavailable
			[ "$expected_target_removable" = 1 ] && [ "$target_removable" = 1 ] || append_failure selected_target_not_removable
			[ "$target_model" = "$expected_target_model" ] || append_failure selected_parent_model_mismatch
			[ "$target_serial" = "$expected_target_serial" ] || append_failure selected_parent_serial_mismatch
			[ "$target_wwn" = "$expected_target_wwn" ] || append_failure selected_parent_wwn_mismatch
			[ "$target_transport" = "$expected_target_transport" ] || append_failure selected_parent_transport_mismatch
			if ! raw_swap_alias_guard; then
				append_failure selected_target_raw_swap_alias_or_inventory_unavailable
			fi
		fi
	else
		if [ "$observation_expected" -eq 1 ]; then
			append_failure selected_target_unavailable
		else
			append_incomplete selected_target_unavailable
		fi
	fi

	if [ ! -x "$runtime_health" ]; then
		if [ "$observation_expected" -eq 1 ]; then
			append_failure runtime_health_helper_unavailable
		else
			append_incomplete runtime_health_helper_unavailable
		fi
	elif ! "$runtime_health" hibernation-config-check >/dev/null 2>&1; then
