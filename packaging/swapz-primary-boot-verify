			append_failure hibernation_resume_configuration_conflict
		else
			append_incomplete hibernation_resume_configuration_conflict
		fi
	fi

	active_run_id=unavailable
	expected_dm_uuid=unavailable
	if [ "$observation_expected" -eq 1 ]; then
		if active_run_id=$(active_transaction_run_id); then
			expected_dm_uuid=SWAPZ-PRIMARY-$active_run_id
		else
			active_run_id=unavailable
			append_failure primary_active_transaction_or_owner_claim_invalid
		fi
	fi

	module_sha256=unavailable
	module_source_sha=unavailable
	module_source_clean=unavailable
	if module_artifact_metadata 2>/dev/null; then
		if [ "$observation_expected" -eq 1 ]; then
			[ "$module_sha256" = "$expected_module_sha" ] || append_failure installed_module_hash_mismatch
			[ "$module_source_sha" = "$expected_source_sha" ] || append_failure installed_module_source_mismatch
		fi
	else
		if [ "$observation_expected" -eq 1 ]; then append_failure installed_module_unavailable; else append_incomplete installed_module_unavailable; fi
	fi

	loaded_module_source_sha=unavailable
	loaded_module_source_clean=unavailable
	loaded_source_file=$sys_root/module/dm_swapz/parameters/build_source_sha
	loaded_clean_file=$sys_root/module/dm_swapz/parameters/build_source_clean
	if loaded_module_source_sha=$(single_line_file "$loaded_source_file" 2>/dev/null) && \
	   loaded_module_source_clean=$(single_line_file "$loaded_clean_file" 2>/dev/null); then
		if [ "$observation_expected" -eq 1 ]; then
			[ "$loaded_module_source_sha" = "$expected_source_sha" ] || append_failure loaded_module_source_mismatch
			[ "$loaded_module_source_clean" = 1 ] || append_failure loaded_module_not_clean
		fi
	else
		loaded_module_source_sha=unavailable
		loaded_module_source_clean=unavailable
		if [ "$observation_expected" -eq 1 ]; then append_failure module_not_loaded; else append_incomplete module_not_loaded; fi
	fi

	dm_uuid=unavailable
	dm_table=unavailable
	dm_logical_sectors=0
	dm_logical_bytes=0
	dm_status=unavailable
	expected_dm_logical_sectors=unavailable
	if [ "$target_size_bytes" != unavailable ]; then
		expected_dm_logical_sectors=$(maximum_logical_sectors "$target_size_bytes" 2>/dev/null || printf 'unavailable')
	fi
	swapz_failed=unavailable
	swapz_error=unavailable
	swapz_flush_err=unavailable
	swapz_segment_discards_failed=unavailable
	swapz_upper_write_completed_err=unavailable
	swapz_endio_write_seen_err=unavailable
	swapz_endio_write_forced_err=unavailable
	gc_victims=unavailable
	gc_pages=unavailable
	gc_no_headroom_skips=unavailable
	gc_reserve_segments_initial=unavailable
	gc_reserve_segments_current=unavailable
	gc_destination_advances=unavailable
	window_gc_pressure=unavailable
	mapper_major_minor=unavailable
	mapper_sysfs_dm_name=unavailable
	dm_status_file=$report_base/report-$boot_id.dm-status.txt
	if command -v dmsetup >/dev/null 2>&1; then
		dm_uuid=$(dmsetup info --columns --noheadings --separator '|' -o uuid swapz-primary 2>/dev/null | awk 'NR == 1 { gsub(/^[[:space:]]+|[[:space:]]+$/, ""); print; exit }' || true)
		dm_table=$(dmsetup table swapz-primary 2>/dev/null || true)
		dm_status=$(dmsetup status swapz-primary 2>/dev/null || true)
		mapper_major_minor=$(lsblk -dnro MAJ:MIN -- "$mapper_path" 2>/dev/null || printf 'unavailable')
		# The pathname must resolve to the exact DM object being observed.
		if [ "$observation_expected" -eq 1 ] &&
		   printf '%s\n' "$mapper_major_minor" | grep -Eq '^[0-9]+:[0-9]+$'; then
			dm_name_path=$sys_root/dev/block/$mapper_major_minor/dm/name
			if mapper_sysfs_dm_name=$(single_line_file "$dm_name_path" 2>/dev/null); then
				[ "$mapper_sysfs_dm_name" = swapz-primary ] ||
					append_failure mapper_sysfs_identity_mismatch
			else
				mapper_sysfs_dm_name=unavailable
				append_incomplete mapper_sysfs_identity_unavailable
			fi
		fi
		case "$dm_table" in *'
'*)
			if [ "$(printf '%s\n' "$dm_table" | wc -l)" -ne 1 ]; then
				[ "$observation_expected" -eq 1 ] && append_failure mapper_table_not_single_target
			fi
			;;
		esac
		set -f
		old_ifs=$IFS
		IFS=' '
		# shellcheck disable=SC2086 # DM table fields are intentionally tokenized.
		set -- $dm_table
		IFS=$old_ifs
		if [ "$#" -eq 12 ] && [ "$1" = 0 ] && \
		   [ "${#2}" -le 15 ] && printf '%s\n' "$2" | grep -Eq '^[1-9][0-9]*$' && \
		   [ "$3" = swapz ] && [ "$5" = 0 ] && [ "$6" = 64 ] && \
		   [ "$7" = 0 ] && [ "$8" = 2 ] && [ "$9" = 0 ] && \
		   [ "${10}" = 1 ] && [ "${11}" = 0 ] && [ "${12}" = 0 ]; then
			dm_logical_sectors=$2
			dm_logical_bytes=$((dm_logical_sectors * 512))
			if [ "$observation_expected" -eq 1 ]; then
				[ "$target_major_minor" != unavailable ] && [ "$4" = "$target_major_minor" ] || append_failure mapper_backing_identity_mismatch
				[ "$expected_dm_logical_sectors" != unavailable ] && [ "$dm_logical_sectors" = "$expected_dm_logical_sectors" ] || append_failure mapper_logical_capacity_mismatch
			fi
		else
			if [ -z "$dm_table" ]; then
				append_incomplete mapper_table_unavailable
			elif [ "$observation_expected" -eq 1 ]; then
				append_failure mapper_table_invalid
			fi
		fi
		if [ "$observation_expected" -eq 1 ]; then
			if [ -z "$dm_uuid" ]; then
				append_incomplete mapper_uuid_unavailable
			else
				printf '%s\n' "$dm_uuid" | grep -Eq '^SWAPZ-PRIMARY-[0-9a-f]{32}$' ||
					append_failure mapper_uuid_invalid
				[ "$expected_dm_uuid" != unavailable ] &&
					[ "$dm_uuid" = "$expected_dm_uuid" ] ||
					append_failure mapper_uuid_not_bound_to_active_run
			fi
			printf '%s\n' "$mapper_major_minor" | grep -Eq '^[0-9]+:[0-9]+$' ||
				append_failure mapper_device_unavailable
		fi
		if [ "$dm_status" != unavailable ] && [ -n "$dm_status" ]; then
			set -f
			old_ifs=$IFS
			IFS=' '
			# shellcheck disable=SC2086 # DM status prefix is intentionally tokenized.
			set -- $dm_status
			IFS=$old_ifs
			# Without a complete single-target grammar no status token is trusted.
			case "$dm_status" in
			*'
'*) append_incomplete mapper_status_not_single_target; dm_status=unavailable ;;
			esac
			if [ "$dm_status" != unavailable ]; then
				if [ "$#" -lt 4 ] || [ "$1" != 0 ] || [ "$3" != swapz ] ||
				   ! printf '%s\n' "$2" | grep -Eq '^[1-9][0-9]{0,17}$'; then
					append_incomplete mapper_status_invalid
					dm_status=unavailable
				elif [ "$observation_expected" -eq 1 ] &&
				     [ "$2" != "$expected_dm_logical_sectors" ]; then
					append_failure mapper_status_geometry_invalid
				fi
			fi
			if [ "$dm_status" != unavailable ]; then
			temporary=$(mktemp "$report_base/.dm-status.XXXXXX") || fail "cannot create DM status report"
			printf '%s\n' "$dm_status" > "$temporary"
			commit_file "$temporary" "$dm_status_file"
			for token in failed error flush_err segment_discards_failed upper_write_completed_err endio_write_seen_err endio_write_forced_err gc_victims gc_pages gc_no_headroom_skips gc_reserve_segments_initial gc_reserve_segments_current gc_destination_advances window_gc_pressure; do
				value=$(status_token "$token" "$dm_status")
				[ -n "$value" ] || value=unavailable
				case "$token" in
				failed) swapz_failed=$value ;;
				error) swapz_error=$value ;;
				flush_err) swapz_flush_err=$value ;;
				segment_discards_failed) swapz_segment_discards_failed=$value ;;
				upper_write_completed_err) swapz_upper_write_completed_err=$value ;;
				endio_write_seen_err) swapz_endio_write_seen_err=$value ;;
				endio_write_forced_err) swapz_endio_write_forced_err=$value ;;
				gc_victims) gc_victims=$value ;;
				gc_pages) gc_pages=$value ;;
				gc_no_headroom_skips) gc_no_headroom_skips=$value ;;
				gc_reserve_segments_initial) gc_reserve_segments_initial=$value ;;
				gc_reserve_segments_current) gc_reserve_segments_current=$value ;;
				gc_destination_advances) gc_destination_advances=$value ;;
				window_gc_pressure) window_gc_pressure=$value ;;
				esac
			done
			if [ "$observation_expected" -eq 1 ]; then
				case "$swapz_failed" in 0) ;; 1) append_failure swapz_target_failed ;; *) append_incomplete dm_status_counter_unavailable_or_invalid ;; esac
				if canonical_status_error "$swapz_error"; then
					[ "$swapz_error" = 0 ] || append_failure swapz_target_error
				else
					append_incomplete dm_status_counter_unavailable_or_invalid
				fi
				if printf '%s\n' "$swapz_flush_err" | grep -Eq '^(0|[1-9][0-9]{0,17})$'; then
					[ "$swapz_flush_err" = 0 ] || append_failure swapz_flush_errors
				else
					append_incomplete dm_status_counter_unavailable_or_invalid
				fi
				if printf '%s\n' "$swapz_segment_discards_failed" | grep -Eq '^(0|[1-9][0-9]{0,17})$'; then
					[ "$swapz_segment_discards_failed" = 0 ] || append_failure swapz_segment_discard_failures
				else
					append_incomplete dm_status_counter_unavailable_or_invalid
				fi
				if printf '%s\n' "$swapz_upper_write_completed_err" | grep -Eq '^(0|[1-9][0-9]{0,17})$'; then
					[ "$swapz_upper_write_completed_err" = 0 ] || append_failure swapz_upper_write_errors
				else
					append_incomplete dm_status_counter_unavailable_or_invalid
				fi
				if printf '%s\n' "$swapz_endio_write_seen_err" | grep -Eq '^(0|[1-9][0-9]{0,17})$'; then
					[ "$swapz_endio_write_seen_err" = 0 ] || append_failure swapz_endio_seen_errors
				else
					append_incomplete dm_status_counter_unavailable_or_invalid
				fi
				if printf '%s\n' "$swapz_endio_write_forced_err" | grep -Eq '^(0|[1-9][0-9]{0,17})$'; then
					[ "$swapz_endio_write_forced_err" = 0 ] || append_failure swapz_endio_forced_errors
				else
					append_incomplete dm_status_counter_unavailable_or_invalid
				fi
				for gc_counter in "$gc_victims" "$gc_pages" "$gc_no_headroom_skips" \
					"$gc_reserve_segments_initial" "$gc_reserve_segments_current" \
					"$gc_destination_advances" "$window_gc_pressure"; do
					if ! printf '%s\n' "$gc_counter" | grep -Eq '^(0|[1-9][0-9]{0,17})$'; then
						append_incomplete gc_progress_telemetry_unavailable
						break
					fi
				done
				if printf '%s\n' "$gc_reserve_segments_initial" | grep -Eq '^(0|[1-9][0-9]{0,17})$' &&
				   printf '%s\n' "$gc_reserve_segments_current" | grep -Eq '^(0|[1-9][0-9]{0,17})$'; then
					if [ "$gc_reserve_segments_initial" = 0 ] ||
					   [ "$gc_reserve_segments_current" = 0 ]; then
						append_failure gc_reserve_exhausted
					elif [ "$gc_reserve_segments_current" -gt "$gc_reserve_segments_initial" ]; then
						append_failure gc_reserve_role_count_invalid
					fi
				fi
			fi
			fi
		else
			append_incomplete mapper_status_unavailable
		fi
	else
		append_incomplete dmsetup_unavailable
	fi

	swap_total_entries=0
	swap_mapper_entries=0
	swap_path=unavailable
	swap_type=unavailable
	swap_size_kib=0
	swap_used_kib=0
	swap_priority=unavailable
	if [ -r "$proc_root/swaps" ]; then
		while IFS=' ' read -r path type size used priority _rest; do
			[ -n "$path" ] || continue
			swap_total_entries=$((swap_total_entries + 1))
			path_identity=$(path_major_minor "$path" 2>/dev/null || true)
			if [ "$path_identity" = "$mapper_major_minor" ] && [ "$mapper_major_minor" != unavailable ]; then
				swap_mapper_entries=$((swap_mapper_entries + 1))
				swap_path=$path
				swap_type=$type
				swap_size_kib=$size
				swap_used_kib=$used
				swap_priority=$priority
			fi
		done <<SWAPS
$(awk 'NR > 1 { print $1, $2, $3, $4, $5 }' "$proc_root/swaps")
SWAPS
		if [ "$observation_expected" -eq 1 ]; then
			# Other unrelated swap areas (e.g. an owner's /swapfile) are
			# allowed. Only the selected mapper must appear exactly once.
			[ "$swap_mapper_entries" -eq 1 ] || append_failure primary_mapper_not_active_as_swap
			[ "$swap_type" = partition ] || append_failure primary_swap_type_invalid
			[ "$swap_priority" = -1 ] || append_failure primary_swap_priority_invalid
			if printf '%s\n' "$swap_size_kib" | grep -Eq '^[1-9][0-9]*$' && [ "$dm_logical_bytes" -gt 0 ]; then
				expected_swap_size_kib=$((dm_logical_bytes / 1024 - 4))
				[ "$swap_size_kib" -eq "$expected_swap_size_kib" ] || append_failure primary_swap_capacity_invalid
			else
				append_failure primary_swap_capacity_unavailable
			fi
		fi
	else
		append_incomplete proc_swaps_unavailable
	fi

	mapper_active_state=unavailable
	mapper_sub_state=unavailable
	mapper_result=unavailable
	swap_active_state=unavailable
	swap_sub_state=unavailable
	swap_result=unavailable
	if command -v systemctl >/dev/null 2>&1; then
		mapper_active_state=$(systemctl show --property=ActiveState --value "$mapper_service" 2>/dev/null || printf 'unavailable')
		mapper_sub_state=$(systemctl show --property=SubState --value "$mapper_service" 2>/dev/null || printf 'unavailable')
		mapper_result=$(systemctl show --property=Result --value "$mapper_service" 2>/dev/null || printf 'unavailable')
		swap_active_state=$(systemctl show --property=ActiveState --value "$mapper_swap_unit" 2>/dev/null || printf 'unavailable')
		swap_sub_state=$(systemctl show --property=SubState --value "$mapper_swap_unit" 2>/dev/null || printf 'unavailable')
		swap_result=$(systemctl show --property=Result --value "$mapper_swap_unit" 2>/dev/null || printf 'unavailable')
		if [ "$observation_expected" -eq 1 ]; then
			case "$mapper_active_state" in
			active) ;;
			unavailable) append_incomplete mapper_service_state_unavailable ;;
			*) append_failure mapper_service_not_active ;;
			esac
			case "$mapper_result" in
			success) ;;
			unavailable) append_incomplete mapper_service_result_unavailable ;;
			*) append_failure mapper_service_result_failed ;;
			esac
			case "$swap_active_state" in
			active) ;;
			unavailable) append_incomplete primary_swap_unit_state_unavailable ;;
			*) append_failure primary_swap_unit_not_active ;;
			esac
			case "$swap_result" in
			success) ;;
			unavailable) append_incomplete primary_swap_unit_result_unavailable ;;
			*) append_failure primary_swap_unit_result_failed ;;
			esac
		fi
	else
		append_incomplete systemctl_unavailable
	fi

	kernel_error_count=unavailable
	kernel_error_log=$report_base/report-$boot_id.kernel-errors.log
	journal_raw=$(mktemp "$report_base/.kernel-journal.XXXXXX") || fail "cannot create kernel-journal temporary"
	journal_filtered=$(mktemp "$report_base/.kernel-errors.XXXXXX") || {
		rm -f -- "$journal_raw"
		fail "cannot create kernel-error temporary"
	}
	if valid_boot_id "$boot_id" 2>/dev/null && command -v journalctl >/dev/null 2>&1 && \
	   journalctl --boot "$boot_id" --kernel --priority=err..alert --no-pager --output=short-monotonic \
		>"$journal_raw" 2>/dev/null; then
		grep -Ei 'swapz|device-mapper|dm-[0-9]+|I/O error|blk_update_request|Buffer I/O' \
			"$journal_raw" > "$journal_filtered" || :
		kernel_error_count=$(wc -l < "$journal_filtered" | tr -d ' ')
		commit_file "$journal_filtered" "$kernel_error_log"
		if [ "$observation_expected" -eq 1 ] && [ "$kernel_error_count" -gt 0 ]; then
			append_failure relevant_kernel_errors
		fi
	else
		rm -f -- "$journal_filtered"
		append_incomplete kernel_log_unavailable
	fi
	rm -f -- "$journal_raw"

	if [ -n "$failure_reasons" ]; then
		status=FAIL
	elif [ -n "$incomplete_reasons" ]; then
		status=INCOMPLETE
	else
		status=PASS
	fi

	# The raw table is retained only as printable single-line evidence. Keep
	# shell/kernel-sourced data from injecting extra keys into this env report.
	dm_table=$(printf '%s' "$dm_table" | LC_ALL=C tr '\r\n=' '   ' | LC_ALL=C tr -cd '[:print:]')
	report=$report_base/report-$boot_id.env
	temporary=$(mktemp "$report_base/.boot-report.XXXXXX") || fail "cannot create boot report"
	cat > "$temporary" <<REPORT
schema=swapz-primary-cold-boot-v1
status=$status
cold_boot_observed=$cold_boot_observed
boot_id=$boot_id
armed_boot_id=$armed_boot_id
kernel_release=$kernel_release
selected_partuuid=$selected_partuuid
selected_target_major_minor=$target_major_minor
selected_target_size_bytes=$target_size_bytes
selected_target_parent=$target_parent
selected_target_model=$target_model
selected_target_serial=$target_serial
selected_target_wwn=$target_wwn
selected_target_transport=$target_transport
selected_target_removable=$target_removable
module_artifact=$module_artifact
module_artifact_sha256=$module_sha256
module_build_source_sha=$module_source_sha
module_build_source_clean=$module_source_clean
loaded_module_build_source_sha=$loaded_module_source_sha
loaded_module_build_source_clean=$loaded_module_source_clean
active_transaction_run_id=$active_run_id
expected_dm_uuid=$expected_dm_uuid
dm_uuid=$dm_uuid
mapper_sysfs_dm_name=$mapper_sysfs_dm_name
dm_table=$dm_table
dm_logical_sectors=$dm_logical_sectors
expected_dm_logical_sectors=$expected_dm_logical_sectors
dm_logical_bytes=$dm_logical_bytes
dm_status_file=$dm_status_file
swap_total_entries=$swap_total_entries
swap_mapper_entries=$swap_mapper_entries
swap_path=$swap_path
swap_type=$swap_type
swap_size_kib=$swap_size_kib
swap_used_kib=$swap_used_kib
swap_priority=$swap_priority
mapper_service_active_state=$mapper_active_state
mapper_service_sub_state=$mapper_sub_state
mapper_service_result=$mapper_result
swap_unit_active_state=$swap_active_state
swap_unit_sub_state=$swap_sub_state
swap_unit_result=$swap_result
swapz_failed=$swapz_failed
swapz_error=$swapz_error
swapz_flush_err=$swapz_flush_err
swapz_segment_discards_failed=$swapz_segment_discards_failed
swapz_upper_write_completed_err=$swapz_upper_write_completed_err
swapz_endio_write_seen_err=$swapz_endio_write_seen_err
swapz_endio_write_forced_err=$swapz_endio_write_forced_err
gc_victims=$gc_victims
gc_pages=$gc_pages
gc_no_headroom_skips=$gc_no_headroom_skips
gc_reserve_segments_initial=$gc_reserve_segments_initial
gc_reserve_segments_current=$gc_reserve_segments_current
gc_destination_advances=$gc_destination_advances
window_gc_pressure=$window_gc_pressure
kernel_error_count=$kernel_error_count
kernel_error_log=$kernel_error_log
failure_reasons=$failure_reasons
incomplete_reasons=$incomplete_reasons
REPORT
	commit_file "$temporary" "$report"
	latest_temporary=$(mktemp "$report_base/.latest.XXXXXX") || fail "cannot create latest report"
	cat -- "$report" > "$latest_temporary"
	commit_file "$latest_temporary" "$report_base/latest.env"
	if [ "$status" != PASS ]; then
		clear_runtime_authorization
	fi
	printf 'COLD_BOOT_OBSERVATION=%s boot_id=%s armed_boot_id=%s report=%s\n' \
		"$status" "$boot_id" "$armed_boot_id" "$report"
	# systemd must not report this observer as successful when the acceptance
	# verdict is FAIL or INCOMPLETE. Evidence is already durably committed.
	case "$status" in
	PASS) return 0 ;;
	FAIL) return 1 ;;
	INCOMPLETE) return 2 ;;
	esac
}

case "$mode" in
arm) arm_harness ;;
preflight) preflight_boot ;;
observe)
	# Even an unexpected persistence abort cannot leave a reusable enable token.
	# This observer never deactivates swap or removes an active mapper.
	trap 'clear_runtime_authorization' EXIT
	observe_boot
	trap - EXIT
	;;
esac
